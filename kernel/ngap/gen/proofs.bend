def TAI.sx_pLMNIdentity.go(+p_iE_Extensions: Bool, +rem: Nat, +bits: Ap.Bits(), +ri: Nat, +bi: Ap.Bits(), +pLMNIdentity: G.PLMNIdentity(), +r3: Nat, +b3: Ap.Bits(), +v: G.TAI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.TAI.r_tAC(p_iE_Extensions, pLMNIdentity, G.TAC.read(Ap.Cur{r3, b3})) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.TAI)}, pre: {bits == Ap.Bit.write(False{}, rem, Ap.Bits.write([p_iE_Extensions], Ap.Bit.after(rem), bi)) : Ap.Bits()}, +pr: {ri == Ap.Bits.after(1n, Ap.Bit.after(rem)) : Nat}, s: {bi == G.PLMNIdentity.write(pLMNIdentity, ri, b3) : Ap.Bits()} & {r3 == G.PLMNIdentity.after(pLMNIdentity, ri) : Nat}) -> TAI.Sx(bits, v, rem, rem2, bits2):
  (s1, s2) = s
