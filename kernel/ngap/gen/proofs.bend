    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.Cause), G.Cause, y => PA.Rd.value(G.Cause, y, v), Done{(G.Cause_choice_Extensions{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.Cause.valid(_) == True{} : Bool}
      L.ngap.ie.decode_valid(c, x, c3, er)

def Cause.dv_alt(i: Nat, +c: Ap.Cur, +v: G.Cause, +c2: Ap.Cur, +e: {G.Cause.alt(i, c) == Done{(v, c2)} : Ap.Rd(G.Cause)}) -> {G.Cause.valid(v) == True{} : Bool}:
  match i:
    case 0n:
      Cause.dv_radioNetwork(c, G.CauseRadioNetwork.read(c), {==}, v, c2, e)
    case 1n:
      Cause.dv_transport(c, G.CauseTransport.read(c), {==}, v, c2, e)
    case 2n:
      Cause.dv_nas(c, G.CauseNas.read(c), {==}, v, c2, e)
    case 3n:
      Cause.dv_protocol(c, G.CauseProtocol.read(c), {==}, v, c2, e)
    case 4n:
      Cause.dv_misc(c, G.CauseMisc.read(c), {==}, v, c2, e)
    case 5n:
      Cause.dv_choice_Extensions(c, Fr.Ie.read(c), {==}, v, c2, e)
    case 6n+p:
      PA.Rd.absurd(G.Cause, {G.Cause.valid(v) == True{} : Bool}, B.Invalid{0}, v, c2, e)

def Cause.dv_idx(r: Ap.Rd(Nat), +v: G.Cause, +c2: Ap.Cur, +e: {G.Cause.r_idx(r) == Done{(v, c2)} : Ap.Rd(G.Cause)}) -> {G.Cause.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.Cause, {G.Cause.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(i, c)}:
      Cause.dv_alt(i, c, v, c2, e)

def GL.ngap.Cause.decode_valid(c, v, c2, e):
  Cause.dv_idx(Ap.Size.read(False{}, 3n, 0n, 5n, c), v, c2, e)

