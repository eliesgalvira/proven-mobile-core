def AllocationAndRetentionPriority.o_dv_iE_Extensions(p: Bool, +c: Ap.Cur, +m: Maybe<&2, List<&2, Fr.Ie>>, +c2: Ap.Cur, +e: {G.AllocationAndRetentionPriority.o_iE_Extensions(p, c) == Done{(m, c2)} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}) -> {G.AllocationAndRetentionPriority.v_iE_Extensions(m) == True{} : Bool}:
