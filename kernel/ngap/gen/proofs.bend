def NR_CGI.o_sx_iE_Extensions.go(+r: Nat, +b: Ap.Bits(), +x: List<&2, Fr.Ie>, +r4: Nat, +b4: Ap.Bits(), +m: Maybe<&2, List<&2, Fr.Ie>>, +r3: Nat, +b3: Ap.Bits(), +e: {Done{(Some{x}, Ap.Cur{r4, b4})} == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}, s: {b == Fr.Exts.write(x, r, b4) : Ap.Bits()} & {r4 == Fr.Exts.after(r) : Nat}) -> ({b == G.NR_CGI.w_iE_Extensions(m, r, b3) : Ap.Bits()} & {r3 == G.NR_CGI.a_iE_Extensions(m, r) : Nat}) & {True{} == Fr.Present(List<&2, Fr.Ie>, m) : Bool}:
