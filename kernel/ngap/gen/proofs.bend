def GL.ngap.Cause.roundtrip(v, rem, rest, ok):
  match v:
    case G.Cause_radioNetwork{x}:
      Cause.rt_radioNetwork(x, rem, rest, ok)
    case G.Cause_transport{x}:
      Cause.rt_transport(x, rem, rest, ok)
    case G.Cause_nas{x}:
      Cause.rt_nas(x, rem, rest, ok)
    case G.Cause_protocol{x}:
      Cause.rt_protocol(x, rem, rest, ok)
    case G.Cause_misc{x}:
      Cause.rt_misc(x, rem, rest, ok)
    case G.Cause_choice_Extensions{x}:
      Cause.rt_choice_Extensions(x, rem, rest, ok)

def Cause.dv_radioNetwork(+c: Ap.Cur, r: Ap.Rd(G.CauseRadioNetwork()), +er: {G.CauseRadioNetwork.read(c) == r : Ap.Rd(G.CauseRadioNetwork())}, +v: G.Cause, +c2: Ap.Cur, +e: {G.Cause.c_radioNetwork(r) == Done{(v, c2)} : Ap.Rd(G.Cause)}) -> {G.Cause.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.Cause, {G.Cause.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.Cause), G.Cause, y => PA.Rd.value(G.Cause, y, v), Done{(G.Cause_radioNetwork{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.Cause.valid(_) == True{} : Bool}
      GL.ngap.CauseRadioNetwork.decode_valid(c, x, c3, er)

