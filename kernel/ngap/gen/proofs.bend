def NR_CGI.dv_ext(rb: Ap.Rd(Bool), +v: G.NR_CGI, +c2: Ap.Cur, +e: {G.NR_CGI.r_ext(rb) == Done{(v, c2)} : Ap.Rd(G.NR_CGI)}) -> {G.NR_CGI.valid(v) == True{} : Bool}:
