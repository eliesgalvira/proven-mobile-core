def GUAMI.o_rt_iE_Extensions(m: Maybe<&2, List<&2, Fr.Ie>>, +r: Nat, +inner: Ap.Bits(), ok: {G.GUAMI.v_iE_Extensions(m) == True{} : Bool}) -> {G.GUAMI.o_iE_Extensions(Fr.Present(List<&2, Fr.Ie>, m), Ap.Cur{r, G.GUAMI.w_iE_Extensions(m, r, inner)}) == Done{(m, Ap.Cur{G.GUAMI.a_iE_Extensions(m, r), inner})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}:
