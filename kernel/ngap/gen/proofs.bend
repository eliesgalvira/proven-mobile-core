def TAI.dv_bm(r: Ap.Rd(Ap.Bits()), +v: G.TAI, +c2: Ap.Cur, +e: {G.TAI.r_bm(r) == Done{(v, c2)} : Ap.Rd(G.TAI)}) -> {G.TAI.valid(v) == True{} : Bool}:
