def GNB_ID.sx_idx(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Nat), +er: {Ap.Size.read(False{}, 1n, 0n, 1n, Ap.Cur{r0, b0}) == r : Ap.Rd(Nat)}, +v: G.GNB_ID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GNB_ID.r_idx(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GNB_ID)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}) -> GNB_ID.Sx(bits, v, rem, rem2, bits2):
