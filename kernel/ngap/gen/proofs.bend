def SecurityResult.dv_bm(r: Ap.Rd(Ap.Bits()), +v: G.SecurityResult, +c2: Ap.Cur, +e: {G.SecurityResult.r_bm(r) == Done{(v, c2)} : Ap.Rd(G.SecurityResult)}) -> {G.SecurityResult.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.SecurityResult, {G.SecurityResult.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(bm, +c3)}:
      match bm:
        case p_iE_Extensions <> Nil{}:
          SecurityResult.dv_integrityProtectionResult(p_iE_Extensions, c3, G.IntegrityProtectionResult.read(c3), {==}, v, c2, e)
        case Nil{}:
          PA.Rd.absurd(G.SecurityResult, {G.SecurityResult.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)
        case q0 <> q1 <> more:
          PA.Rd.absurd(G.SecurityResult, {G.SecurityResult.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)

def SecurityResult.dv_ext(rb: Ap.Rd(Bool), +v: G.SecurityResult, +c2: Ap.Cur, +e: {G.SecurityResult.r_ext(rb) == Done{(v, c2)} : Ap.Rd(G.SecurityResult)}) -> {G.SecurityResult.valid(v) == True{} : Bool}:
