      PA.Rd.absurd(G.GTPTunnel, {G.GTPTunnel.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, +c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.GTPTunnel, {G.GTPTunnel.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
          GTPTunnel.dv_bm(Ap.Bits.read(1n, c), v, c2, e)

def GL.ngap.GTPTunnel.decode_valid(c, v, c2, e):
  GTPTunnel.dv_ext(Ap.Bit.read(c), v, c2, e)

