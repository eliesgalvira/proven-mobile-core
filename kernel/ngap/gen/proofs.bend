      %ir : {Done{(x <> more, Ap.Cur{G.CellCAGList.items_after(x <> more, rem), rest})} == G.CellCAGList.next(_, c2 => G.CellCAGList.items(List.length(&2, G.CAG_ID(), more), c2)) : Ap.Rd(List<&2, G.CAG_ID()>)}
      ih = CellCAGList.items_rt(more, G.CAG_ID.after(x, rem), rest, P.Bool.and_true_r(G.CAG_ID.valid(x), G.CellCAGList.all_valid(more), av))
      %ih : {Done{(x <> more, Ap.Cur{G.CellCAGList.items_after(x <> more, rem), rest})} == G.CellCAGList.cons(x, _) : Ap.Rd(List<&2, G.CAG_ID()>)}
