    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.Cause), G.Cause, y => PA.Rd.value(G.Cause, y, v), Done{(G.Cause_choice_Extensions{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.Cause.valid(_) == True{} : Bool}
