def ServedGUAMIItem.rt(+gUAMI: G.GUAMI, +backupAMFName: Maybe<&2, G.AMFName()>, +iE_Extensions: Maybe<&2, List<&2, Fr.Ie>>, +rem: Nat, +rest: Ap.Bits(), +ok: {G.ServedGUAMIItem.valid(G.ServedGUAMIItem{gUAMI, backupAMFName, iE_Extensions}) == True{} : Bool}) -> {G.ServedGUAMIItem.read(Ap.Cur{rem, G.ServedGUAMIItem.write(G.ServedGUAMIItem{gUAMI, backupAMFName, iE_Extensions}, rem, rest)}) == Done{(G.ServedGUAMIItem{gUAMI, backupAMFName, iE_Extensions}, Ap.Cur{G.ServedGUAMIItem.after(G.ServedGUAMIItem{gUAMI, backupAMFName, iE_Extensions}, rem), rest})} : Ap.Rd(G.ServedGUAMIItem)}:
  ok0 = P.Bool.and_true_l(G.GUAMI.valid(gUAMI), Bool.and(G.ServedGUAMIItem.v_backupAMFName(backupAMFName), G.ServedGUAMIItem.v_iE_Extensions(iE_Extensions)), ok)
  +okr0 = P.Bool.and_true_r(G.GUAMI.valid(gUAMI), Bool.and(G.ServedGUAMIItem.v_backupAMFName(backupAMFName), G.ServedGUAMIItem.v_iE_Extensions(iE_Extensions)), ok)
