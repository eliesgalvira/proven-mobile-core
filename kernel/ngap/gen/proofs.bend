def GlobalNgENB_ID.sx_bm(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Ap.Bits()), +er: {Ap.Bits.read(1n, Ap.Cur{r0, b0}) == r : Ap.Rd(Ap.Bits())}, +v: G.GlobalNgENB_ID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GlobalNgENB_ID.r_bm(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalNgENB_ID)}, pre: {bits == Ap.Bit.write(False{}, rem, b0) : Ap.Bits()}, pr: {r0 == Ap.Bit.after(rem) : Nat}) -> GlobalNgENB_ID.Sx(bits, v, rem, rem2, bits2):
