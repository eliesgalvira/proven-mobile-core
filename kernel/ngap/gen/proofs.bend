def NGSetupResponse.sx.go(+rem: Nat, +rest: Ap.Bits(), +v: G.NGSetupResponse(), +rem2: Nat, +bits2: Ap.Bits(), s: PC.Canon(rest, Fr.Ies.write(v, Ap.Bit.after(rem), bits2), rem2, 0n)) -> NGSetupResponse.Sx(False{} <> rest, v, rem, rem2, bits2):
  (s1, s2) = s
  (Equal.cong(Ap.Bits(), Ap.Bits(), l => False{} <> l, rest, Fr.Ies.write(v, Ap.Bit.after(rem), bits2), s1), s2)

def NGSetupResponse.sx(+rem: Nat, bits: Ap.Bits(), +v: G.NGSetupResponse(), +rem2: Nat, +bits2: Ap.Bits(), +e: {G.NGSetupResponse.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.NGSetupResponse())}) -> NGSetupResponse.Sx(bits, v, rem, rem2, bits2):
  match bits:
    case Nil{}:
      PA.Rd.absurd(G.NGSetupResponse(), NGSetupResponse.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.NGSetupResponse(), NGSetupResponse.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          NGSetupResponse.sx.go(rem, rest, v, rem2, bits2, PF.Ies.sx(Ap.Bit.after(rem), rest, v, rem2, bits2, e))

def GL.ngap.NGSetupResponse.suffix(rem, bits, v, rem2, bits2, e):
  NGSetupResponse.sx(rem, bits, v, rem2, bits2, e)

