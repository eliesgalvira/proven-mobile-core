def GlobalGNB_ID.sx_bm(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Ap.Bits()), +er: {Ap.Bits.read(1n, Ap.Cur{r0, b0}) == r : Ap.Rd(Ap.Bits())}, +v: G.GlobalGNB_ID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GlobalGNB_ID.r_bm(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalGNB_ID)}, pre: {bits == Ap.Bit.write(False{}, rem, b0) : Ap.Bits()}, pr: {r0 == Ap.Bit.after(rem) : Nat}) -> GlobalGNB_ID.Sx(bits, v, rem, rem2, bits2):
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.GlobalGNB_ID, GlobalGNB_ID.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(bm, c1)}:
      match bm:
        case +p_iE_Extensions <> Nil{}:
          match c1:
            case Ap.Cur{+r1, +b1}:
              GlobalGNB_ID.sx_bm.go(rem, bits, r0, b0, p_iE_Extensions, r1, b1, v, rem2, bits2, e, pre, pr, PC.Bits.sx(1n, r0, b0, [p_iE_Extensions], r1, b1, er))
        case Nil{}:
          PA.Rd.absurd(G.GlobalGNB_ID, GlobalGNB_ID.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
        case q0 <> q1 <> more:
          PA.Rd.absurd(G.GlobalGNB_ID, GlobalGNB_ID.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)

def GlobalGNB_ID.sx(+rem: Nat, bits: Ap.Bits(), +v: G.GlobalGNB_ID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GlobalGNB_ID.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalGNB_ID)}) -> GlobalGNB_ID.Sx(bits, v, rem, rem2, bits2):
  match bits:
    case Nil{}:
      PA.Rd.absurd(G.GlobalGNB_ID, GlobalGNB_ID.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.GlobalGNB_ID, GlobalGNB_ID.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          GlobalGNB_ID.sx_bm(rem, False{} <> rest, Ap.Bit.after(rem), rest, Ap.Bits.read(1n, Ap.Cur{Ap.Bit.after(rem), rest}), {==}, v, rem2, bits2, e, {==}, {==})

def GL.ngap.GlobalGNB_ID.suffix(rem, bits, v, rem2, bits2, e):
  GlobalGNB_ID.sx(rem, bits, v, rem2, bits2, e)

