    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Maybe<&2, List<&2, Fr.Ie>>, y => PA.Rd.value(Maybe<&2, List<&2, Fr.Ie>>, y, m), Done{(Some{x}, c3)}, Done{(m, c2)}, e)
      %ev : {G.SliceSupportItem.v_iE_Extensions(_) == True{} : Bool}
      L.ngap.exts.decode_valid(c, x, c3, er)

def SliceSupportItem.o_dv_iE_Extensions(p: Bool, +c: Ap.Cur, +m: Maybe<&2, List<&2, Fr.Ie>>, +c2: Ap.Cur, +e: {G.SliceSupportItem.o_iE_Extensions(p, c) == Done{(m, c2)} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}) -> {G.SliceSupportItem.v_iE_Extensions(m) == True{} : Bool}:
  match p:
    case False{}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Maybe<&2, List<&2, Fr.Ie>>, y => PA.Rd.value(Maybe<&2, List<&2, Fr.Ie>>, y, m), Done{(None{}, c)}, Done{(m, c2)}, e)
      %ev : {G.SliceSupportItem.v_iE_Extensions(_) == True{} : Bool}
