  match rb:
    case Fail{err}:
      PA.Rd.absurd(G.NGSetupFailure(), {G.NGSetupFailure.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.NGSetupFailure(), {G.NGSetupFailure.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
          L.ngap.ies.decode_valid(c, v, c2, e)

