def GUAMI.dv_ext(rb: Ap.Rd(Bool), +v: G.GUAMI, +c2: Ap.Cur, +e: {G.GUAMI.r_ext(rb) == Done{(v, c2)} : Ap.Rd(G.GUAMI)}) -> {G.GUAMI.valid(v) == True{} : Bool}:
