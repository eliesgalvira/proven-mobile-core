          match c1:
            case Ap.Cur{+r1, +b1}:
              GlobalNgENB_ID.sx_bm.go(rem, bits, r0, b0, p_iE_Extensions, r1, b1, v, rem2, bits2, e, pre, pr, PC.Bits.sx(1n, r0, b0, [p_iE_Extensions], r1, b1, er))
