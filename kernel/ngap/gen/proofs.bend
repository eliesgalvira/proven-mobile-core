def NPN_AccessInformation.sx_idx(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Nat), +er: {Ap.Size.read(False{}, 1n, 0n, 1n, Ap.Cur{r0, b0}) == r : Ap.Rd(Nat)}, +v: G.NPN_AccessInformation, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.NPN_AccessInformation.r_idx(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.NPN_AccessInformation)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}) -> NPN_AccessInformation.Sx(bits, v, rem, rem2, bits2):
