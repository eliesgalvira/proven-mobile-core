def GlobalNgENB_ID.sx(+rem: Nat, bits: Ap.Bits(), +v: G.GlobalNgENB_ID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GlobalNgENB_ID.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalNgENB_ID)}) -> GlobalNgENB_ID.Sx(bits, v, rem, rem2, bits2):
  match bits:
    case Nil{}:
      PA.Rd.absurd(G.GlobalNgENB_ID, GlobalNgENB_ID.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.GlobalNgENB_ID, GlobalNgENB_ID.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          GlobalNgENB_ID.sx_bm(rem, False{} <> rest, Ap.Bit.after(rem), rest, Ap.Bits.read(1n, Ap.Cur{Ap.Bit.after(rem), rest}), {==}, v, rem2, bits2, e, {==}, {==})

def GL.ngap.GlobalNgENB_ID.suffix(rem, bits, v, rem2, bits2, e):
  GlobalNgENB_ID.sx(rem, bits, v, rem2, bits2, e)

def GL.ngap.N3IWF_ID_n3IWF_ID.roundtrip(v, rem, rest, ok):
