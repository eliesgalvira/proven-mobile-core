def CellCAGList.items_rt(xs: List<&2, G.CAG_ID()>, +rem: Nat, +rest: Ap.Bits(), +av: {G.CellCAGList.all_valid(xs) == True{} : Bool}) -> {Done{(xs, Ap.Cur{G.CellCAGList.items_after(xs, rem), rest})} == G.CellCAGList.items(List.length(&2, G.CAG_ID(), xs), Ap.Cur{rem, G.CellCAGList.items_write(xs, rem, rest)}) : Ap.Rd(List<&2, G.CAG_ID()>)}:
