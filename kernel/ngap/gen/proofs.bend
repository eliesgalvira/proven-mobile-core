def Dynamic5QIDescriptor.sx_priorityLevelQos(+p_fiveQI: Bool, +p_delayCritical: Bool, +p_averagingWindow: Bool, +p_maximumDataBurstVolume: Bool, +p_iE_Extensions: Bool, +rem: Nat, +bits: Ap.Bits(), +ri: Nat, +bi: Ap.Bits(), r: Ap.Rd(G.PriorityLevelQos()), +er: {G.PriorityLevelQos.read(Ap.Cur{ri, bi}) == r : Ap.Rd(G.PriorityLevelQos())}, +v: G.Dynamic5QIDescriptor, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.Dynamic5QIDescriptor.r_priorityLevelQos(p_fiveQI, p_delayCritical, p_averagingWindow, p_maximumDataBurstVolume, p_iE_Extensions, r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.Dynamic5QIDescriptor)}, pre: {bits == Ap.Bit.write(False{}, rem, Ap.Bits.write([p_fiveQI, p_delayCritical, p_averagingWindow, p_maximumDataBurstVolume, p_iE_Extensions], Ap.Bit.after(rem), bi)) : Ap.Bits()}, pr: {ri == Ap.Bits.after(5n, Ap.Bit.after(rem)) : Nat}) -> Dynamic5QIDescriptor.Sx(bits, v, rem, rem2, bits2):
  match r:
