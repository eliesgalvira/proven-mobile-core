def GL.ngap.QosCharacteristics.suffix(rem, bits, v, rem2, bits2, e):
  QosCharacteristics.sx_idx(rem, bits, rem, bits, Ap.Size.read(False{}, 2n, 0n, 2n, Ap.Cur{rem, bits}), {==}, v, rem2, bits2, e, {==}, {==})

