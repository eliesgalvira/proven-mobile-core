def AllocationAndRetentionPriority.o_sx_iE_Extensions(p: Bool, +r: Nat, +b: Ap.Bits(), +m: Maybe<&2, List<&2, Fr.Ie>>, +r3: Nat, +b3: Ap.Bits(), +e: {G.AllocationAndRetentionPriority.o_iE_Extensions(p, Ap.Cur{r, b}) == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}) -> ({b == G.AllocationAndRetentionPriority.w_iE_Extensions(m, r, b3) : Ap.Bits()} & {r3 == G.AllocationAndRetentionPriority.a_iE_Extensions(m, r) : Nat}) & {p == Fr.Present(List<&2, Fr.Ie>, m) : Bool}:
  match p:
    case False{}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Maybe<&2, List<&2, Fr.Ie>>, y => PA.Rd.value(Maybe<&2, List<&2, Fr.Ie>>, y, m), Done{(None{}, Ap.Cur{r, b})}, Done{(m, Ap.Cur{r3, b3})}, e)
      +ec = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Ap.Cur, y => PA.Rd.cur(Maybe<&2, List<&2, Fr.Ie>>, y, Ap.Cur{r3, b3}), Done{(None{}, Ap.Cur{r, b})}, Done{(m, Ap.Cur{r3, b3})}, e)
      %ev : ({b == G.AllocationAndRetentionPriority.w_iE_Extensions(_, r, b3) : Ap.Bits()} & {r3 == G.AllocationAndRetentionPriority.a_iE_Extensions(_, r) : Nat}) & {False{} == Fr.Present(List<&2, Fr.Ie>, _) : Bool}
