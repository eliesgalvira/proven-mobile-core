def GlobalRANNodeID.dv_globalN3IWF_ID(+c: Ap.Cur, r: Ap.Rd(G.GlobalN3IWF_ID), +er: {G.GlobalN3IWF_ID.read(c) == r : Ap.Rd(G.GlobalN3IWF_ID)}, +v: G.GlobalRANNodeID, +c2: Ap.Cur, +e: {G.GlobalRANNodeID.c_globalN3IWF_ID(r) == Done{(v, c2)} : Ap.Rd(G.GlobalRANNodeID)}) -> {G.GlobalRANNodeID.valid(v) == True{} : Bool}:
