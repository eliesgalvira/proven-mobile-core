def GlobalRANNodeID.dv_alt(i: Nat, +c: Ap.Cur, +v: G.GlobalRANNodeID, +c2: Ap.Cur, +e: {G.GlobalRANNodeID.alt(i, c) == Done{(v, c2)} : Ap.Rd(G.GlobalRANNodeID)}) -> {G.GlobalRANNodeID.valid(v) == True{} : Bool}:
  match i:
    case 0n:
      GlobalRANNodeID.dv_globalGNB_ID(c, G.GlobalGNB_ID.read(c), {==}, v, c2, e)
    case 1n:
      GlobalRANNodeID.dv_globalNgENB_ID(c, G.GlobalNgENB_ID.read(c), {==}, v, c2, e)
    case 2n:
      GlobalRANNodeID.dv_globalN3IWF_ID(c, G.GlobalN3IWF_ID.read(c), {==}, v, c2, e)
    case 3n:
      GlobalRANNodeID.dv_choice_Extensions(c, Fr.Ie.read(c), {==}, v, c2, e)
    case 4n+p:
      PA.Rd.absurd(G.GlobalRANNodeID, {G.GlobalRANNodeID.valid(v) == True{} : Bool}, B.Invalid{0}, v, c2, e)

def GlobalRANNodeID.dv_idx(r: Ap.Rd(Nat), +v: G.GlobalRANNodeID, +c2: Ap.Cur, +e: {G.GlobalRANNodeID.r_idx(r) == Done{(v, c2)} : Ap.Rd(G.GlobalRANNodeID)}) -> {G.GlobalRANNodeID.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.GlobalRANNodeID, {G.GlobalRANNodeID.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(i, c)}:
      GlobalRANNodeID.dv_alt(i, c, v, c2, e)

def GL.ngap.GlobalRANNodeID.decode_valid(c, v, c2, e):
  GlobalRANNodeID.dv_idx(Ap.Size.read(False{}, 2n, 0n, 3n, c), v, c2, e)

