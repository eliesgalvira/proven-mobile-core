      PA.Rd.absurd(G.TargeteNB_ID, TargeteNB_ID.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.TargeteNB_ID, TargeteNB_ID.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          TargeteNB_ID.sx_bm(rem, False{} <> rest, Ap.Bit.after(rem), rest, Ap.Bits.read(1n, Ap.Cur{Ap.Bit.after(rem), rest}), {==}, v, rem2, bits2, e, {==}, {==})

def GL.ngap.TargeteNB_ID.suffix(rem, bits, v, rem2, bits2, e):
  TargeteNB_ID.sx(rem, bits, v, rem2, bits2, e)

def TargetID.Sx(+bits: Ap.Bits(), +v: G.TargetID, +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
  {bits == G.TargetID.write(v, rem, bits2) : Ap.Bits()} & {rem2 == G.TargetID.after(v, rem) : Nat}

