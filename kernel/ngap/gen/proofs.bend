def N3IWF_ID.dv_alt(i: Nat, +c: Ap.Cur, +v: G.N3IWF_ID, +c2: Ap.Cur, +e: {G.N3IWF_ID.alt(i, c) == Done{(v, c2)} : Ap.Rd(G.N3IWF_ID)}) -> {G.N3IWF_ID.valid(v) == True{} : Bool}:
  match i:
    case 0n:
      N3IWF_ID.dv_n3IWF_ID(c, G.N3IWF_ID_n3IWF_ID.read(c), {==}, v, c2, e)
    case 1n:
      N3IWF_ID.dv_choice_Extensions(c, Fr.Ie.read(c), {==}, v, c2, e)
    case 2n+p:
      PA.Rd.absurd(G.N3IWF_ID, {G.N3IWF_ID.valid(v) == True{} : Bool}, B.Invalid{0}, v, c2, e)

def N3IWF_ID.dv_idx(r: Ap.Rd(Nat), +v: G.N3IWF_ID, +c2: Ap.Cur, +e: {G.N3IWF_ID.r_idx(r) == Done{(v, c2)} : Ap.Rd(G.N3IWF_ID)}) -> {G.N3IWF_ID.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.N3IWF_ID, {G.N3IWF_ID.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(i, c)}:
      N3IWF_ID.dv_alt(i, c, v, c2, e)

def GL.ngap.N3IWF_ID.decode_valid(c, v, c2, e):
  N3IWF_ID.dv_idx(Ap.Size.read(False{}, 1n, 0n, 1n, c), v, c2, e)

