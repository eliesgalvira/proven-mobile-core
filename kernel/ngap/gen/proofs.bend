def Dynamic5QIDescriptor.sx_bm.go(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +p_fiveQI: Bool, +p_delayCritical: Bool, +p_averagingWindow: Bool, +p_maximumDataBurstVolume: Bool, +p_iE_Extensions: Bool, +r1: Nat, +b1: Ap.Bits(), +v: G.Dynamic5QIDescriptor, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.Dynamic5QIDescriptor.r_priorityLevelQos(p_fiveQI, p_delayCritical, p_averagingWindow, p_maximumDataBurstVolume, p_iE_Extensions, G.PriorityLevelQos.read(Ap.Cur{r1, b1})) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.Dynamic5QIDescriptor)}, pre: {bits == Ap.Bit.write(False{}, rem, b0) : Ap.Bits()}, +pr: {r0 == Ap.Bit.after(rem) : Nat}, s: PC.Canon(b0, Ap.Bits.write([p_fiveQI, p_delayCritical, p_averagingWindow, p_maximumDataBurstVolume, p_iE_Extensions], r0, b1), r1, Ap.Bits.after(5n, r0)) & {List.length(&2, Bool, [p_fiveQI, p_delayCritical, p_averagingWindow, p_maximumDataBurstVolume, p_iE_Extensions]) == 5n : Nat}) -> Dynamic5QIDescriptor.Sx(bits, v, rem, rem2, bits2):
  (cn, len) = s
  (s1, s2) = cn
  Dynamic5QIDescriptor.sx_priorityLevelQos(p_fiveQI, p_delayCritical, p_averagingWindow, p_maximumDataBurstVolume, p_iE_Extensions, rem, bits, r1, b1, G.PriorityLevelQos.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, (%pr : {bits == Ap.Bit.write(False{}, rem, Ap.Bits.write([p_fiveQI, p_delayCritical, p_averagingWindow, p_maximumDataBurstVolume, p_iE_Extensions], _, b1)) : Ap.Bits()}; (%s1 : {bits == Ap.Bit.write(False{}, rem, _) : Ap.Bits()}; pre)), (%pr : {r1 == Ap.Bits.after(5n, _) : Nat}; s2))

def Dynamic5QIDescriptor.sx_bm(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Ap.Bits()), +er: {Ap.Bits.read(5n, Ap.Cur{r0, b0}) == r : Ap.Rd(Ap.Bits())}, +v: G.Dynamic5QIDescriptor, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.Dynamic5QIDescriptor.r_bm(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.Dynamic5QIDescriptor)}, pre: {bits == Ap.Bit.write(False{}, rem, b0) : Ap.Bits()}, pr: {r0 == Ap.Bit.after(rem) : Nat}) -> Dynamic5QIDescriptor.Sx(bits, v, rem, rem2, bits2):
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.Dynamic5QIDescriptor, Dynamic5QIDescriptor.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(bm, c1)}:
      match bm:
        case +p_fiveQI <> +p_delayCritical <> +p_averagingWindow <> +p_maximumDataBurstVolume <> +p_iE_Extensions <> Nil{}:
          match c1:
            case Ap.Cur{+r1, +b1}:
              Dynamic5QIDescriptor.sx_bm.go(rem, bits, r0, b0, p_fiveQI, p_delayCritical, p_averagingWindow, p_maximumDataBurstVolume, p_iE_Extensions, r1, b1, v, rem2, bits2, e, pre, pr, PC.Bits.sx(5n, r0, b0, [p_fiveQI, p_delayCritical, p_averagingWindow, p_maximumDataBurstVolume, p_iE_Extensions], r1, b1, er))
        case Nil{}:
          PA.Rd.absurd(G.Dynamic5QIDescriptor, Dynamic5QIDescriptor.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
        case q0 <> Nil{}:
          PA.Rd.absurd(G.Dynamic5QIDescriptor, Dynamic5QIDescriptor.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
        case q0 <> q1 <> Nil{}:
          PA.Rd.absurd(G.Dynamic5QIDescriptor, Dynamic5QIDescriptor.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
        case q0 <> q1 <> q2 <> Nil{}:
          PA.Rd.absurd(G.Dynamic5QIDescriptor, Dynamic5QIDescriptor.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
        case q0 <> q1 <> q2 <> q3 <> Nil{}:
          PA.Rd.absurd(G.Dynamic5QIDescriptor, Dynamic5QIDescriptor.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
        case q0 <> q1 <> q2 <> q3 <> q4 <> q5 <> more:
          PA.Rd.absurd(G.Dynamic5QIDescriptor, Dynamic5QIDescriptor.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)

def Dynamic5QIDescriptor.sx(+rem: Nat, bits: Ap.Bits(), +v: G.Dynamic5QIDescriptor, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.Dynamic5QIDescriptor.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.Dynamic5QIDescriptor)}) -> Dynamic5QIDescriptor.Sx(bits, v, rem, rem2, bits2):
  match bits:
    case Nil{}:
      PA.Rd.absurd(G.Dynamic5QIDescriptor, Dynamic5QIDescriptor.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.Dynamic5QIDescriptor, Dynamic5QIDescriptor.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          Dynamic5QIDescriptor.sx_bm(rem, False{} <> rest, Ap.Bit.after(rem), rest, Ap.Bits.read(5n, Ap.Cur{Ap.Bit.after(rem), rest}), {==}, v, rem2, bits2, e, {==}, {==})

def GL.ngap.Dynamic5QIDescriptor.suffix(rem, bits, v, rem2, bits2, e):
  Dynamic5QIDescriptor.sx(rem, bits, v, rem2, bits2, e)

def QosCharacteristics.Sx(+bits: Ap.Bits(), +v: G.QosCharacteristics, +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
  {bits == G.QosCharacteristics.write(v, rem, bits2) : Ap.Bits()} & {rem2 == G.QosCharacteristics.after(v, rem) : Nat}

def QosCharacteristics.rt_nonDynamic5QI(+x: G.NonDynamic5QIDescriptor, +rem: Nat, +rest: Ap.Bits(), +ok: {G.NonDynamic5QIDescriptor.valid(x) == True{} : Bool}) -> {G.QosCharacteristics.read(Ap.Cur{rem, G.QosCharacteristics.write(G.QosCharacteristics_nonDynamic5QI{x}, rem, rest)}) == Done{(G.QosCharacteristics_nonDynamic5QI{x}, Ap.Cur{G.QosCharacteristics.after(G.QosCharacteristics_nonDynamic5QI{x}, rem), rest})} : Ap.Rd(G.QosCharacteristics)}:
  e1 = Equal.sym(Ap.Rd(Nat), Ap.Size.read(False{}, 2n, 0n, 2n, Ap.Cur{rem, Ap.Size.write(False{}, 2n, 0n, 0n, rem, G.NonDynamic5QIDescriptor.write(x, Ap.Size.after(False{}, 2n, rem), rest))}), Done{(0n, Ap.Cur{Ap.Size.after(False{}, 2n, rem), G.NonDynamic5QIDescriptor.write(x, Ap.Size.after(False{}, 2n, rem), rest)})}, L.aper.size.roundtrip(False{}, 2n, 0n, 2n, 0n, rem, G.NonDynamic5QIDescriptor.write(x, Ap.Size.after(False{}, 2n, rem), rest), {==}, {==}))
  %e1 : {G.QosCharacteristics.r_idx(_) == Done{(G.QosCharacteristics_nonDynamic5QI{x}, Ap.Cur{G.QosCharacteristics.after(G.QosCharacteristics_nonDynamic5QI{x}, rem), rest})} : Ap.Rd(G.QosCharacteristics)}
  e2 = Equal.sym(Ap.Rd(G.NonDynamic5QIDescriptor), G.NonDynamic5QIDescriptor.read(Ap.Cur{Ap.Size.after(False{}, 2n, rem), G.NonDynamic5QIDescriptor.write(x, Ap.Size.after(False{}, 2n, rem), rest)}), Done{(x, Ap.Cur{G.NonDynamic5QIDescriptor.after(x, Ap.Size.after(False{}, 2n, rem)), rest})}, GL.ngap.NonDynamic5QIDescriptor.roundtrip(x, Ap.Size.after(False{}, 2n, rem), rest, ok))
  %e2 : {G.QosCharacteristics.c_nonDynamic5QI(_) == Done{(G.QosCharacteristics_nonDynamic5QI{x}, Ap.Cur{G.QosCharacteristics.after(G.QosCharacteristics_nonDynamic5QI{x}, rem), rest})} : Ap.Rd(G.QosCharacteristics)}
  {==}

def QosCharacteristics.rt_dynamic5QI(+x: G.Dynamic5QIDescriptor, +rem: Nat, +rest: Ap.Bits(), +ok: {G.Dynamic5QIDescriptor.valid(x) == True{} : Bool}) -> {G.QosCharacteristics.read(Ap.Cur{rem, G.QosCharacteristics.write(G.QosCharacteristics_dynamic5QI{x}, rem, rest)}) == Done{(G.QosCharacteristics_dynamic5QI{x}, Ap.Cur{G.QosCharacteristics.after(G.QosCharacteristics_dynamic5QI{x}, rem), rest})} : Ap.Rd(G.QosCharacteristics)}:
  e1 = Equal.sym(Ap.Rd(Nat), Ap.Size.read(False{}, 2n, 0n, 2n, Ap.Cur{rem, Ap.Size.write(False{}, 2n, 0n, 1n, rem, G.Dynamic5QIDescriptor.write(x, Ap.Size.after(False{}, 2n, rem), rest))}), Done{(1n, Ap.Cur{Ap.Size.after(False{}, 2n, rem), G.Dynamic5QIDescriptor.write(x, Ap.Size.after(False{}, 2n, rem), rest)})}, L.aper.size.roundtrip(False{}, 2n, 0n, 2n, 1n, rem, G.Dynamic5QIDescriptor.write(x, Ap.Size.after(False{}, 2n, rem), rest), {==}, {==}))
  %e1 : {G.QosCharacteristics.r_idx(_) == Done{(G.QosCharacteristics_dynamic5QI{x}, Ap.Cur{G.QosCharacteristics.after(G.QosCharacteristics_dynamic5QI{x}, rem), rest})} : Ap.Rd(G.QosCharacteristics)}
  e2 = Equal.sym(Ap.Rd(G.Dynamic5QIDescriptor), G.Dynamic5QIDescriptor.read(Ap.Cur{Ap.Size.after(False{}, 2n, rem), G.Dynamic5QIDescriptor.write(x, Ap.Size.after(False{}, 2n, rem), rest)}), Done{(x, Ap.Cur{G.Dynamic5QIDescriptor.after(x, Ap.Size.after(False{}, 2n, rem)), rest})}, GL.ngap.Dynamic5QIDescriptor.roundtrip(x, Ap.Size.after(False{}, 2n, rem), rest, ok))
  %e2 : {G.QosCharacteristics.c_dynamic5QI(_) == Done{(G.QosCharacteristics_dynamic5QI{x}, Ap.Cur{G.QosCharacteristics.after(G.QosCharacteristics_dynamic5QI{x}, rem), rest})} : Ap.Rd(G.QosCharacteristics)}
  {==}

def QosCharacteristics.rt_choice_Extensions(+x: Fr.Ie, +rem: Nat, +rest: Ap.Bits(), +ok: {Fr.Ie.valid(x) == True{} : Bool}) -> {G.QosCharacteristics.read(Ap.Cur{rem, G.QosCharacteristics.write(G.QosCharacteristics_choice_Extensions{x}, rem, rest)}) == Done{(G.QosCharacteristics_choice_Extensions{x}, Ap.Cur{G.QosCharacteristics.after(G.QosCharacteristics_choice_Extensions{x}, rem), rest})} : Ap.Rd(G.QosCharacteristics)}:
  e1 = Equal.sym(Ap.Rd(Nat), Ap.Size.read(False{}, 2n, 0n, 2n, Ap.Cur{rem, Ap.Size.write(False{}, 2n, 0n, 2n, rem, Fr.Ie.write(x, Ap.Size.after(False{}, 2n, rem), rest))}), Done{(2n, Ap.Cur{Ap.Size.after(False{}, 2n, rem), Fr.Ie.write(x, Ap.Size.after(False{}, 2n, rem), rest)})}, L.aper.size.roundtrip(False{}, 2n, 0n, 2n, 2n, rem, Fr.Ie.write(x, Ap.Size.after(False{}, 2n, rem), rest), {==}, {==}))
  %e1 : {G.QosCharacteristics.r_idx(_) == Done{(G.QosCharacteristics_choice_Extensions{x}, Ap.Cur{G.QosCharacteristics.after(G.QosCharacteristics_choice_Extensions{x}, rem), rest})} : Ap.Rd(G.QosCharacteristics)}
  e2 = Equal.sym(Ap.Rd(Fr.Ie), Fr.Ie.read(Ap.Cur{Ap.Size.after(False{}, 2n, rem), Fr.Ie.write(x, Ap.Size.after(False{}, 2n, rem), rest)}), Done{(x, Ap.Cur{Fr.Ie.after(Ap.Size.after(False{}, 2n, rem)), rest})}, L.ngap.ie.roundtrip(x, Ap.Size.after(False{}, 2n, rem), rest, ok))
  %e2 : {G.QosCharacteristics.c_choice_Extensions(_) == Done{(G.QosCharacteristics_choice_Extensions{x}, Ap.Cur{G.QosCharacteristics.after(G.QosCharacteristics_choice_Extensions{x}, rem), rest})} : Ap.Rd(G.QosCharacteristics)}
  {==}

def GL.ngap.QosCharacteristics.roundtrip(v, rem, rest, ok):
  match v:
    case G.QosCharacteristics_nonDynamic5QI{x}:
      QosCharacteristics.rt_nonDynamic5QI(x, rem, rest, ok)
    case G.QosCharacteristics_dynamic5QI{x}:
      QosCharacteristics.rt_dynamic5QI(x, rem, rest, ok)
    case G.QosCharacteristics_choice_Extensions{x}:
      QosCharacteristics.rt_choice_Extensions(x, rem, rest, ok)

def QosCharacteristics.dv_nonDynamic5QI(+c: Ap.Cur, r: Ap.Rd(G.NonDynamic5QIDescriptor), +er: {G.NonDynamic5QIDescriptor.read(c) == r : Ap.Rd(G.NonDynamic5QIDescriptor)}, +v: G.QosCharacteristics, +c2: Ap.Cur, +e: {G.QosCharacteristics.c_nonDynamic5QI(r) == Done{(v, c2)} : Ap.Rd(G.QosCharacteristics)}) -> {G.QosCharacteristics.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.QosCharacteristics, {G.QosCharacteristics.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.QosCharacteristics), G.QosCharacteristics, y => PA.Rd.value(G.QosCharacteristics, y, v), Done{(G.QosCharacteristics_nonDynamic5QI{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.QosCharacteristics.valid(_) == True{} : Bool}
      GL.ngap.NonDynamic5QIDescriptor.decode_valid(c, x, c3, er)

def QosCharacteristics.dv_dynamic5QI(+c: Ap.Cur, r: Ap.Rd(G.Dynamic5QIDescriptor), +er: {G.Dynamic5QIDescriptor.read(c) == r : Ap.Rd(G.Dynamic5QIDescriptor)}, +v: G.QosCharacteristics, +c2: Ap.Cur, +e: {G.QosCharacteristics.c_dynamic5QI(r) == Done{(v, c2)} : Ap.Rd(G.QosCharacteristics)}) -> {G.QosCharacteristics.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.QosCharacteristics, {G.QosCharacteristics.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.QosCharacteristics), G.QosCharacteristics, y => PA.Rd.value(G.QosCharacteristics, y, v), Done{(G.QosCharacteristics_dynamic5QI{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.QosCharacteristics.valid(_) == True{} : Bool}
      GL.ngap.Dynamic5QIDescriptor.decode_valid(c, x, c3, er)

def QosCharacteristics.dv_choice_Extensions(+c: Ap.Cur, r: Ap.Rd(Fr.Ie), +er: {Fr.Ie.read(c) == r : Ap.Rd(Fr.Ie)}, +v: G.QosCharacteristics, +c2: Ap.Cur, +e: {G.QosCharacteristics.c_choice_Extensions(r) == Done{(v, c2)} : Ap.Rd(G.QosCharacteristics)}) -> {G.QosCharacteristics.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.QosCharacteristics, {G.QosCharacteristics.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.QosCharacteristics), G.QosCharacteristics, y => PA.Rd.value(G.QosCharacteristics, y, v), Done{(G.QosCharacteristics_choice_Extensions{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.QosCharacteristics.valid(_) == True{} : Bool}
      L.ngap.ie.decode_valid(c, x, c3, er)

def QosCharacteristics.dv_alt(i: Nat, +c: Ap.Cur, +v: G.QosCharacteristics, +c2: Ap.Cur, +e: {G.QosCharacteristics.alt(i, c) == Done{(v, c2)} : Ap.Rd(G.QosCharacteristics)}) -> {G.QosCharacteristics.valid(v) == True{} : Bool}:
  match i:
    case 0n:
      QosCharacteristics.dv_nonDynamic5QI(c, G.NonDynamic5QIDescriptor.read(c), {==}, v, c2, e)
    case 1n:
      QosCharacteristics.dv_dynamic5QI(c, G.Dynamic5QIDescriptor.read(c), {==}, v, c2, e)
    case 2n:
      QosCharacteristics.dv_choice_Extensions(c, Fr.Ie.read(c), {==}, v, c2, e)
    case 3n+p:
      PA.Rd.absurd(G.QosCharacteristics, {G.QosCharacteristics.valid(v) == True{} : Bool}, B.Invalid{0}, v, c2, e)

def QosCharacteristics.dv_idx(r: Ap.Rd(Nat), +v: G.QosCharacteristics, +c2: Ap.Cur, +e: {G.QosCharacteristics.r_idx(r) == Done{(v, c2)} : Ap.Rd(G.QosCharacteristics)}) -> {G.QosCharacteristics.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.QosCharacteristics, {G.QosCharacteristics.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(i, c)}:
      QosCharacteristics.dv_alt(i, c, v, c2, e)

def GL.ngap.QosCharacteristics.decode_valid(c, v, c2, e):
  QosCharacteristics.dv_idx(Ap.Size.read(False{}, 2n, 0n, 2n, c), v, c2, e)

def QosCharacteristics.sx_nonDynamic5QI.go(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), +x: G.NonDynamic5QIDescriptor, +r3: Nat, +b3: Ap.Bits(), +v: G.QosCharacteristics, +rem2: Nat, +bits2: Ap.Bits(), +e: {Done{(G.QosCharacteristics_nonDynamic5QI{x}, Ap.Cur{r3, b3})} == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.QosCharacteristics)}, pre: {bits == b0 : Ap.Bits()}, +pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 2n, 0n, 0n, r0, b1), r1, Ap.Size.after(False{}, 2n, r0)), s: {b1 == G.NonDynamic5QIDescriptor.write(x, r1, b3) : Ap.Bits()} & {r3 == G.NonDynamic5QIDescriptor.after(x, r1) : Nat}) -> QosCharacteristics.Sx(bits, v, rem, rem2, bits2):
  (ss1, +ss2) = ss
  (s1, s2) = s
  ev = Equal.cong(Ap.Rd(G.QosCharacteristics), G.QosCharacteristics, y => PA.Rd.value(G.QosCharacteristics, y, v), Done{(G.QosCharacteristics_nonDynamic5QI{x}, Ap.Cur{r3, b3})}, Done{(v, Ap.Cur{rem2, bits2})}, e)
  +ec = Equal.cong(Ap.Rd(G.QosCharacteristics), Ap.Cur, y => PA.Rd.cur(G.QosCharacteristics, y, Ap.Cur{rem2, bits2}), Done{(G.QosCharacteristics_nonDynamic5QI{x}, Ap.Cur{r3, b3})}, Done{(v, Ap.Cur{rem2, bits2})}, e)
  eb = Equal.cong(Ap.Cur, Ap.Bits(), x => PA.Cur.bits(x), Ap.Cur{r3, b3}, Ap.Cur{rem2, bits2}, ec)
  er = Equal.cong(Ap.Cur, Nat, x => PA.Cur.rem(x), Ap.Cur{r3, b3}, Ap.Cur{rem2, bits2}, ec)
  %ev : QosCharacteristics.Sx(bits, _, rem, rem2, bits2)
  ((%pr : {bits == Ap.Size.write(False{}, 2n, 0n, 0n, _, G.NonDynamic5QIDescriptor.write(x, Ap.Size.after(False{}, 2n, _), bits2)) : Ap.Bits()}; (%ss2 : {bits == Ap.Size.write(False{}, 2n, 0n, 0n, r0, G.NonDynamic5QIDescriptor.write(x, _, bits2)) : Ap.Bits()}; (%eb : {bits == Ap.Size.write(False{}, 2n, 0n, 0n, r0, G.NonDynamic5QIDescriptor.write(x, r1, _)) : Ap.Bits()}; (%s1 : {bits == Ap.Size.write(False{}, 2n, 0n, 0n, r0, _) : Ap.Bits()}; (%ss1 : {bits == _ : Ap.Bits()}; pre))))), (%er : {_ == G.NonDynamic5QIDescriptor.after(x, Ap.Size.after(False{}, 2n, rem)) : Nat}; (%pr : {r3 == G.NonDynamic5QIDescriptor.after(x, Ap.Size.after(False{}, 2n, _)) : Nat}; (%ss2 : {r3 == G.NonDynamic5QIDescriptor.after(x, _) : Nat}; s2))))

