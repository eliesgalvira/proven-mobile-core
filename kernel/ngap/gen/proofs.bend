  {==}

def GL.ngap.GlobalRANNodeID.roundtrip(v, rem, rest, ok):
  match v:
    case G.GlobalRANNodeID_globalGNB_ID{x}:
      GlobalRANNodeID.rt_globalGNB_ID(x, rem, rest, ok)
    case G.GlobalRANNodeID_globalNgENB_ID{x}:
      GlobalRANNodeID.rt_globalNgENB_ID(x, rem, rest, ok)
    case G.GlobalRANNodeID_globalN3IWF_ID{x}:
      GlobalRANNodeID.rt_globalN3IWF_ID(x, rem, rest, ok)
    case G.GlobalRANNodeID_choice_Extensions{x}:
      GlobalRANNodeID.rt_choice_Extensions(x, rem, rest, ok)

def GlobalRANNodeID.dv_globalGNB_ID(+c: Ap.Cur, r: Ap.Rd(G.GlobalGNB_ID), +er: {G.GlobalGNB_ID.read(c) == r : Ap.Rd(G.GlobalGNB_ID)}, +v: G.GlobalRANNodeID, +c2: Ap.Cur, +e: {G.GlobalRANNodeID.c_globalGNB_ID(r) == Done{(v, c2)} : Ap.Rd(G.GlobalRANNodeID)}) -> {G.GlobalRANNodeID.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.GlobalRANNodeID, {G.GlobalRANNodeID.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.GlobalRANNodeID), G.GlobalRANNodeID, y => PA.Rd.value(G.GlobalRANNodeID, y, v), Done{(G.GlobalRANNodeID_globalGNB_ID{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.GlobalRANNodeID.valid(_) == True{} : Bool}
      GL.ngap.GlobalGNB_ID.decode_valid(c, x, c3, er)

