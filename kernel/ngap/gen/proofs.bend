      PA.Rd.absurd(G.N3IWF_ID, {G.N3IWF_ID.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.N3IWF_ID), G.N3IWF_ID, y => PA.Rd.value(G.N3IWF_ID, y, v), Done{(G.N3IWF_ID_n3IWF_ID{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.N3IWF_ID.valid(_) == True{} : Bool}
      GL.ngap.N3IWF_ID_n3IWF_ID.decode_valid(c, x, c3, er)

def N3IWF_ID.dv_choice_Extensions(+c: Ap.Cur, r: Ap.Rd(Fr.Ie), +er: {Fr.Ie.read(c) == r : Ap.Rd(Fr.Ie)}, +v: G.N3IWF_ID, +c2: Ap.Cur, +e: {G.N3IWF_ID.c_choice_Extensions(r) == Done{(v, c2)} : Ap.Rd(G.N3IWF_ID)}) -> {G.N3IWF_ID.valid(v) == True{} : Bool}:
