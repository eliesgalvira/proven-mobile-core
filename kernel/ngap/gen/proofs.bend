def S_NSSAI.dv_sD(+p_sD: Bool, +p_iE_Extensions: Bool, +sST: G.SST(), +c: Ap.Cur, r: Ap.Rd(Maybe<&2, G.SD()>), +er: {G.S_NSSAI.o_sD(p_sD, c) == r : Ap.Rd(Maybe<&2, G.SD()>)}, +v: G.S_NSSAI, +c2: Ap.Cur, +e: {G.S_NSSAI.r_sD(p_iE_Extensions, sST, r) == Done{(v, c2)} : Ap.Rd(G.S_NSSAI)}, ok0: {G.SST.valid(sST) == True{} : Bool}) -> {G.S_NSSAI.valid(v) == True{} : Bool}:
