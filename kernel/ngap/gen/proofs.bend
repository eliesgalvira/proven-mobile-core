def GL.ngap.N3IWF_ID.roundtrip(v, rem, rest, ok):
  match v:
    case G.N3IWF_ID_n3IWF_ID{x}:
      N3IWF_ID.rt_n3IWF_ID(x, rem, rest, ok)
    case G.N3IWF_ID_choice_Extensions{x}:
      N3IWF_ID.rt_choice_Extensions(x, rem, rest, ok)

def N3IWF_ID.dv_n3IWF_ID(+c: Ap.Cur, r: Ap.Rd(G.N3IWF_ID_n3IWF_ID()), +er: {G.N3IWF_ID_n3IWF_ID.read(c) == r : Ap.Rd(G.N3IWF_ID_n3IWF_ID())}, +v: G.N3IWF_ID, +c2: Ap.Cur, +e: {G.N3IWF_ID.c_n3IWF_ID(r) == Done{(v, c2)} : Ap.Rd(G.N3IWF_ID)}) -> {G.N3IWF_ID.valid(v) == True{} : Bool}:
  match r:
