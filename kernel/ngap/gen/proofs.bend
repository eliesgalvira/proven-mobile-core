      PA.Rd.absurd(G.GUAMI, {G.GUAMI.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, +c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.GUAMI, {G.GUAMI.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
          GUAMI.dv_bm(Ap.Bits.read(1n, c), v, c2, e)

