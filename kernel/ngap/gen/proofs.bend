    case Fail{err}:
      PA.Rd.absurd(G.InitialContextSetupRequest(), {G.InitialContextSetupRequest.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.InitialContextSetupRequest(), {G.InitialContextSetupRequest.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
