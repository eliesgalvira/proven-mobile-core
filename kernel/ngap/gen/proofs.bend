  match bits:
    case Nil{}:
      PA.Rd.absurd(G.NGSetupFailure(), NGSetupFailure.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.NGSetupFailure(), NGSetupFailure.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          NGSetupFailure.sx.go(rem, rest, v, rem2, bits2, PF.Ies.sx(Ap.Bit.after(rem), rest, v, rem2, bits2, e))

