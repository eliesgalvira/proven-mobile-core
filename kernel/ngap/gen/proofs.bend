def GL.ngap.GNB_ID.suffix(rem, bits, v, rem2, bits2, e):
  GNB_ID.sx_idx(rem, bits, rem, bits, Ap.Size.read(False{}, 1n, 0n, 1n, Ap.Cur{rem, bits}), {==}, v, rem2, bits2, e, {==}, {==})

def GlobalGNB_ID.Sx(+bits: Ap.Bits(), +v: G.GlobalGNB_ID, +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
