      %e1 : {G.S_NSSAI.s_iE_Extensions(_) == Done{(Some{x}, Ap.Cur{Fr.Exts.after(r), inner})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}
      {==}

def S_NSSAI.o_dv_iE_Extensions.some(+c: Ap.Cur, r: Ap.Rd(List<&2, Fr.Ie>), +er: {Fr.Exts.read(c) == r : Ap.Rd(List<&2, Fr.Ie>)}, +m: Maybe<&2, List<&2, Fr.Ie>>, +c2: Ap.Cur, +e: {G.S_NSSAI.s_iE_Extensions(r) == Done{(m, c2)} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}) -> {G.S_NSSAI.v_iE_Extensions(m) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(Maybe<&2, List<&2, Fr.Ie>>, {G.S_NSSAI.v_iE_Extensions(m) == True{} : Bool}, err, m, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Maybe<&2, List<&2, Fr.Ie>>, y => PA.Rd.value(Maybe<&2, List<&2, Fr.Ie>>, y, m), Done{(Some{x}, c3)}, Done{(m, c2)}, e)
