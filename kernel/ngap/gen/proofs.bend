    case Fail{err}:
      PA.Rd.absurd(G.UPTransportLayerInformation, {G.UPTransportLayerInformation.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(i, c)}:
      UPTransportLayerInformation.dv_alt(i, c, v, c2, e)

def GL.ngap.UPTransportLayerInformation.decode_valid(c, v, c2, e):
  UPTransportLayerInformation.dv_idx(Ap.Size.read(False{}, 1n, 0n, 1n, c), v, c2, e)

