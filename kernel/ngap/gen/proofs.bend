def GL.ngap.SST.decode_valid(c, v, c2, e):
  PA.Octets.dv_n(1n, c, v, c2, e)

def GL.ngap.SST.suffix(rem, bits, v, rem2, bits2, e):
  PC.Octets.sx_n(1n, rem, bits, v, rem2, bits2, e)

def GL.ngap.SD.roundtrip(v, rem, rest, ok):
  PA.AOctets.rt_n(3n, v, rem, rest, ok)

def GL.ngap.SD.decode_valid(c, v, c2, e):
  PA.AOctets.dv_n(3n, c, v, c2, e)

def GL.ngap.SD.suffix(rem, bits, v, rem2, bits2, e):
  PC.AOctets.sx_n(3n, rem, bits, v, rem2, bits2, e)

def S_NSSAI.Sx(+bits: Ap.Bits(), +v: G.S_NSSAI, +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
  {bits == G.S_NSSAI.write(v, rem, bits2) : Ap.Bits()} & {rem2 == G.S_NSSAI.after(v, rem) : Nat}

def S_NSSAI.o_rt_sD(m: Maybe<&2, G.SD()>, +r: Nat, +inner: Ap.Bits(), ok: {G.S_NSSAI.v_sD(m) == True{} : Bool}) -> {G.S_NSSAI.o_sD(Fr.Present(G.SD(), m), Ap.Cur{r, G.S_NSSAI.w_sD(m, r, inner)}) == Done{(m, Ap.Cur{G.S_NSSAI.a_sD(m, r), inner})} : Ap.Rd(Maybe<&2, G.SD()>)}:
  match m:
    case None{}:
      {==}
    case Some{+x}:
      e1 = Equal.sym(Ap.Rd(G.SD()), G.SD.read(Ap.Cur{r, G.SD.write(x, r, inner)}), Done{(x, Ap.Cur{G.SD.after(x, r), inner})}, GL.ngap.SD.roundtrip(x, r, inner, ok))
      %e1 : {G.S_NSSAI.s_sD(_) == Done{(Some{x}, Ap.Cur{G.SD.after(x, r), inner})} : Ap.Rd(Maybe<&2, G.SD()>)}
      {==}

def S_NSSAI.o_dv_sD.some(+c: Ap.Cur, r: Ap.Rd(G.SD()), +er: {G.SD.read(c) == r : Ap.Rd(G.SD())}, +m: Maybe<&2, G.SD()>, +c2: Ap.Cur, +e: {G.S_NSSAI.s_sD(r) == Done{(m, c2)} : Ap.Rd(Maybe<&2, G.SD()>)}) -> {G.S_NSSAI.v_sD(m) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(Maybe<&2, G.SD()>, {G.S_NSSAI.v_sD(m) == True{} : Bool}, err, m, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, G.SD()>), Maybe<&2, G.SD()>, y => PA.Rd.value(Maybe<&2, G.SD()>, y, m), Done{(Some{x}, c3)}, Done{(m, c2)}, e)
      %ev : {G.S_NSSAI.v_sD(_) == True{} : Bool}
      GL.ngap.SD.decode_valid(c, x, c3, er)

def S_NSSAI.o_dv_sD(p: Bool, +c: Ap.Cur, +m: Maybe<&2, G.SD()>, +c2: Ap.Cur, +e: {G.S_NSSAI.o_sD(p, c) == Done{(m, c2)} : Ap.Rd(Maybe<&2, G.SD()>)}) -> {G.S_NSSAI.v_sD(m) == True{} : Bool}:
  match p:
    case False{}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, G.SD()>), Maybe<&2, G.SD()>, y => PA.Rd.value(Maybe<&2, G.SD()>, y, m), Done{(None{}, c)}, Done{(m, c2)}, e)
      %ev : {G.S_NSSAI.v_sD(_) == True{} : Bool}
      {==}
    case True{}:
      S_NSSAI.o_dv_sD.some(c, G.SD.read(c), {==}, m, c2, e)

def S_NSSAI.o_sx_sD.go(+r: Nat, +b: Ap.Bits(), +x: G.SD(), +r4: Nat, +b4: Ap.Bits(), +m: Maybe<&2, G.SD()>, +r3: Nat, +b3: Ap.Bits(), +e: {Done{(Some{x}, Ap.Cur{r4, b4})} == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, G.SD()>)}, s: {b == G.SD.write(x, r, b4) : Ap.Bits()} & {r4 == G.SD.after(x, r) : Nat}) -> ({b == G.S_NSSAI.w_sD(m, r, b3) : Ap.Bits()} & {r3 == G.S_NSSAI.a_sD(m, r) : Nat}) & {True{} == Fr.Present(G.SD(), m) : Bool}:
  (s1, s2) = s
  ev = Equal.cong(Ap.Rd(Maybe<&2, G.SD()>), Maybe<&2, G.SD()>, y => PA.Rd.value(Maybe<&2, G.SD()>, y, m), Done{(Some{x}, Ap.Cur{r4, b4})}, Done{(m, Ap.Cur{r3, b3})}, e)
  +ec = Equal.cong(Ap.Rd(Maybe<&2, G.SD()>), Ap.Cur, y => PA.Rd.cur(Maybe<&2, G.SD()>, y, Ap.Cur{r3, b3}), Done{(Some{x}, Ap.Cur{r4, b4})}, Done{(m, Ap.Cur{r3, b3})}, e)
  eb = Equal.cong(Ap.Cur, Ap.Bits(), y => PA.Cur.bits(y), Ap.Cur{r4, b4}, Ap.Cur{r3, b3}, ec)
  er = Equal.cong(Ap.Cur, Nat, y => PA.Cur.rem(y), Ap.Cur{r4, b4}, Ap.Cur{r3, b3}, ec)
  %ev : ({b == G.S_NSSAI.w_sD(_, r, b3) : Ap.Bits()} & {r3 == G.S_NSSAI.a_sD(_, r) : Nat}) & {True{} == Fr.Present(G.SD(), _) : Bool}
  (((%eb : {b == G.SD.write(x, r, _) : Ap.Bits()}; s1), (%er : {_ == G.SD.after(x, r) : Nat}; s2)), {==})

def S_NSSAI.o_sx_sD.some(+r: Nat, +b: Ap.Bits(), rd: Ap.Rd(G.SD()), +erd: {G.SD.read(Ap.Cur{r, b}) == rd : Ap.Rd(G.SD())}, +m: Maybe<&2, G.SD()>, +r3: Nat, +b3: Ap.Bits(), +e: {G.S_NSSAI.s_sD(rd) == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, G.SD()>)}) -> ({b == G.S_NSSAI.w_sD(m, r, b3) : Ap.Bits()} & {r3 == G.S_NSSAI.a_sD(m, r) : Nat}) & {True{} == Fr.Present(G.SD(), m) : Bool}:
  match rd:
    case Fail{err}:
      PA.Rd.absurd(Maybe<&2, G.SD()>, ({b == G.S_NSSAI.w_sD(m, r, b3) : Ap.Bits()} & {r3 == G.S_NSSAI.a_sD(m, r) : Nat}) & {True{} == Fr.Present(G.SD(), m) : Bool}, err, m, Ap.Cur{r3, b3}, e)
    case Done{(+x, c4)}:
      match c4:
        case Ap.Cur{+r4, +b4}:
          S_NSSAI.o_sx_sD.go(r, b, x, r4, b4, m, r3, b3, e, GL.ngap.SD.suffix(r, b, x, r4, b4, erd))

def S_NSSAI.o_sx_sD(p: Bool, +r: Nat, +b: Ap.Bits(), +m: Maybe<&2, G.SD()>, +r3: Nat, +b3: Ap.Bits(), +e: {G.S_NSSAI.o_sD(p, Ap.Cur{r, b}) == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, G.SD()>)}) -> ({b == G.S_NSSAI.w_sD(m, r, b3) : Ap.Bits()} & {r3 == G.S_NSSAI.a_sD(m, r) : Nat}) & {p == Fr.Present(G.SD(), m) : Bool}:
  match p:
    case False{}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, G.SD()>), Maybe<&2, G.SD()>, y => PA.Rd.value(Maybe<&2, G.SD()>, y, m), Done{(None{}, Ap.Cur{r, b})}, Done{(m, Ap.Cur{r3, b3})}, e)
      +ec = Equal.cong(Ap.Rd(Maybe<&2, G.SD()>), Ap.Cur, y => PA.Rd.cur(Maybe<&2, G.SD()>, y, Ap.Cur{r3, b3}), Done{(None{}, Ap.Cur{r, b})}, Done{(m, Ap.Cur{r3, b3})}, e)
      %ev : ({b == G.S_NSSAI.w_sD(_, r, b3) : Ap.Bits()} & {r3 == G.S_NSSAI.a_sD(_, r) : Nat}) & {False{} == Fr.Present(G.SD(), _) : Bool}
      ((Equal.cong(Ap.Cur, Ap.Bits(), y => PA.Cur.bits(y), Ap.Cur{r, b}, Ap.Cur{r3, b3}, ec), Equal.sym(Nat, r, r3, Equal.cong(Ap.Cur, Nat, y => PA.Cur.rem(y), Ap.Cur{r, b}, Ap.Cur{r3, b3}, ec))), {==})
    case True{}:
      S_NSSAI.o_sx_sD.some(r, b, G.SD.read(Ap.Cur{r, b}), {==}, m, r3, b3, e)

def S_NSSAI.o_rt_iE_Extensions(m: Maybe<&2, List<&2, Fr.Ie>>, +r: Nat, +inner: Ap.Bits(), ok: {G.S_NSSAI.v_iE_Extensions(m) == True{} : Bool}) -> {G.S_NSSAI.o_iE_Extensions(Fr.Present(List<&2, Fr.Ie>, m), Ap.Cur{r, G.S_NSSAI.w_iE_Extensions(m, r, inner)}) == Done{(m, Ap.Cur{G.S_NSSAI.a_iE_Extensions(m, r), inner})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}:
