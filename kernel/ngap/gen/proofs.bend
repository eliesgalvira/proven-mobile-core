  (s1, s2) = cn
  GlobalN3IWF_ID.sx_pLMNIdentity(p_iE_Extensions, rem, bits, r1, b1, G.PLMNIdentity.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, (%pr : {bits == Ap.Bit.write(False{}, rem, Ap.Bits.write([p_iE_Extensions], _, b1)) : Ap.Bits()}; (%s1 : {bits == Ap.Bit.write(False{}, rem, _) : Ap.Bits()}; pre)), (%pr : {r1 == Ap.Bits.after(1n, _) : Nat}; s2))

def GlobalN3IWF_ID.sx_bm(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Ap.Bits()), +er: {Ap.Bits.read(1n, Ap.Cur{r0, b0}) == r : Ap.Rd(Ap.Bits())}, +v: G.GlobalN3IWF_ID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GlobalN3IWF_ID.r_bm(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalN3IWF_ID)}, pre: {bits == Ap.Bit.write(False{}, rem, b0) : Ap.Bits()}, pr: {r0 == Ap.Bit.after(rem) : Nat}) -> GlobalN3IWF_ID.Sx(bits, v, rem, rem2, bits2):
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.GlobalN3IWF_ID, GlobalN3IWF_ID.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(bm, c1)}:
      match bm:
        case +p_iE_Extensions <> Nil{}:
          match c1:
            case Ap.Cur{+r1, +b1}:
              GlobalN3IWF_ID.sx_bm.go(rem, bits, r0, b0, p_iE_Extensions, r1, b1, v, rem2, bits2, e, pre, pr, PC.Bits.sx(1n, r0, b0, [p_iE_Extensions], r1, b1, er))
        case Nil{}:
          PA.Rd.absurd(G.GlobalN3IWF_ID, GlobalN3IWF_ID.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
        case q0 <> q1 <> more:
          PA.Rd.absurd(G.GlobalN3IWF_ID, GlobalN3IWF_ID.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)

def GlobalN3IWF_ID.sx(+rem: Nat, bits: Ap.Bits(), +v: G.GlobalN3IWF_ID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GlobalN3IWF_ID.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalN3IWF_ID)}) -> GlobalN3IWF_ID.Sx(bits, v, rem, rem2, bits2):
  match bits:
    case Nil{}:
      PA.Rd.absurd(G.GlobalN3IWF_ID, GlobalN3IWF_ID.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.GlobalN3IWF_ID, GlobalN3IWF_ID.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          GlobalN3IWF_ID.sx_bm(rem, False{} <> rest, Ap.Bit.after(rem), rest, Ap.Bits.read(1n, Ap.Cur{Ap.Bit.after(rem), rest}), {==}, v, rem2, bits2, e, {==}, {==})

def GL.ngap.GlobalN3IWF_ID.suffix(rem, bits, v, rem2, bits2, e):
  GlobalN3IWF_ID.sx(rem, bits, v, rem2, bits2, e)

def GlobalRANNodeID.Sx(+bits: Ap.Bits(), +v: G.GlobalRANNodeID, +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
  {bits == G.GlobalRANNodeID.write(v, rem, bits2) : Ap.Bits()} & {rem2 == G.GlobalRANNodeID.after(v, rem) : Nat}

