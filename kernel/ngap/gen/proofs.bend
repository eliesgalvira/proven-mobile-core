    case Fail{err}:
      PA.Rd.absurd(G.NR_CGI, {G.NR_CGI.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, +c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.NR_CGI, {G.NR_CGI.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
          NR_CGI.dv_bm(Ap.Bits.read(1n, c), v, c2, e)

def GL.ngap.NR_CGI.decode_valid(c, v, c2, e):
  NR_CGI.dv_ext(Ap.Bit.read(c), v, c2, e)

