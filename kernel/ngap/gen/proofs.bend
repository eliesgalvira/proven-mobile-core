  %e2 : {G.TargetID.c_targetRANNodeID(_) == Done{(G.TargetID_targetRANNodeID{x}, Ap.Cur{G.TargetID.after(G.TargetID_targetRANNodeID{x}, rem), rest})} : Ap.Rd(G.TargetID)}
  {==}

def TargetID.rt_targeteNB_ID(+x: G.TargeteNB_ID, +rem: Nat, +rest: Ap.Bits(), +ok: {G.TargeteNB_ID.valid(x) == True{} : Bool}) -> {G.TargetID.read(Ap.Cur{rem, G.TargetID.write(G.TargetID_targeteNB_ID{x}, rem, rest)}) == Done{(G.TargetID_targeteNB_ID{x}, Ap.Cur{G.TargetID.after(G.TargetID_targeteNB_ID{x}, rem), rest})} : Ap.Rd(G.TargetID)}:
