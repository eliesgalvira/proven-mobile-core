def EUTRA_CGI.sx_bm(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Ap.Bits()), +er: {Ap.Bits.read(1n, Ap.Cur{r0, b0}) == r : Ap.Rd(Ap.Bits())}, +v: G.EUTRA_CGI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.EUTRA_CGI.r_bm(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.EUTRA_CGI)}, pre: {bits == Ap.Bit.write(False{}, rem, b0) : Ap.Bits()}, pr: {r0 == Ap.Bit.after(rem) : Nat}) -> EUTRA_CGI.Sx(bits, v, rem, rem2, bits2):
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.EUTRA_CGI, EUTRA_CGI.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(bm, c1)}:
      match bm:
        case +p_iE_Extensions <> Nil{}:
          match c1:
            case Ap.Cur{+r1, +b1}:
              EUTRA_CGI.sx_bm.go(rem, bits, r0, b0, p_iE_Extensions, r1, b1, v, rem2, bits2, e, pre, pr, PC.Bits.sx(1n, r0, b0, [p_iE_Extensions], r1, b1, er))
        case Nil{}:
          PA.Rd.absurd(G.EUTRA_CGI, EUTRA_CGI.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
        case q0 <> q1 <> more:
          PA.Rd.absurd(G.EUTRA_CGI, EUTRA_CGI.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)

def EUTRA_CGI.sx(+rem: Nat, bits: Ap.Bits(), +v: G.EUTRA_CGI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.EUTRA_CGI.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.EUTRA_CGI)}) -> EUTRA_CGI.Sx(bits, v, rem, rem2, bits2):
  match bits:
    case Nil{}:
      PA.Rd.absurd(G.EUTRA_CGI, EUTRA_CGI.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.EUTRA_CGI, EUTRA_CGI.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          EUTRA_CGI.sx_bm(rem, False{} <> rest, Ap.Bit.after(rem), rest, Ap.Bits.read(1n, Ap.Cur{Ap.Bit.after(rem), rest}), {==}, v, rem2, bits2, e, {==}, {==})

def GL.ngap.EUTRA_CGI.suffix(rem, bits, v, rem2, bits2, e):
  EUTRA_CGI.sx(rem, bits, v, rem2, bits2, e)

def TAI.Sx(+bits: Ap.Bits(), +v: G.TAI, +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
  {bits == G.TAI.write(v, rem, bits2) : Ap.Bits()} & {rem2 == G.TAI.after(v, rem) : Nat}

def TAI.o_rt_iE_Extensions(m: Maybe<&2, List<&2, Fr.Ie>>, +r: Nat, +inner: Ap.Bits(), ok: {G.TAI.v_iE_Extensions(m) == True{} : Bool}) -> {G.TAI.o_iE_Extensions(Fr.Present(List<&2, Fr.Ie>, m), Ap.Cur{r, G.TAI.w_iE_Extensions(m, r, inner)}) == Done{(m, Ap.Cur{G.TAI.a_iE_Extensions(m, r), inner})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}:
  match m:
    case None{}:
      {==}
    case Some{+x}:
      e1 = Equal.sym(Ap.Rd(List<&2, Fr.Ie>), Fr.Exts.read(Ap.Cur{r, Fr.Exts.write(x, r, inner)}), Done{(x, Ap.Cur{Fr.Exts.after(r), inner})}, L.ngap.exts.roundtrip(x, r, inner, ok))
      %e1 : {G.TAI.s_iE_Extensions(_) == Done{(Some{x}, Ap.Cur{Fr.Exts.after(r), inner})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}
      {==}

def TAI.o_dv_iE_Extensions.some(+c: Ap.Cur, r: Ap.Rd(List<&2, Fr.Ie>), +er: {Fr.Exts.read(c) == r : Ap.Rd(List<&2, Fr.Ie>)}, +m: Maybe<&2, List<&2, Fr.Ie>>, +c2: Ap.Cur, +e: {G.TAI.s_iE_Extensions(r) == Done{(m, c2)} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}) -> {G.TAI.v_iE_Extensions(m) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(Maybe<&2, List<&2, Fr.Ie>>, {G.TAI.v_iE_Extensions(m) == True{} : Bool}, err, m, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Maybe<&2, List<&2, Fr.Ie>>, y => PA.Rd.value(Maybe<&2, List<&2, Fr.Ie>>, y, m), Done{(Some{x}, c3)}, Done{(m, c2)}, e)
      %ev : {G.TAI.v_iE_Extensions(_) == True{} : Bool}
      L.ngap.exts.decode_valid(c, x, c3, er)

def TAI.o_dv_iE_Extensions(p: Bool, +c: Ap.Cur, +m: Maybe<&2, List<&2, Fr.Ie>>, +c2: Ap.Cur, +e: {G.TAI.o_iE_Extensions(p, c) == Done{(m, c2)} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}) -> {G.TAI.v_iE_Extensions(m) == True{} : Bool}:
  match p:
    case False{}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Maybe<&2, List<&2, Fr.Ie>>, y => PA.Rd.value(Maybe<&2, List<&2, Fr.Ie>>, y, m), Done{(None{}, c)}, Done{(m, c2)}, e)
      %ev : {G.TAI.v_iE_Extensions(_) == True{} : Bool}
      {==}
    case True{}:
      TAI.o_dv_iE_Extensions.some(c, Fr.Exts.read(c), {==}, m, c2, e)

def TAI.o_sx_iE_Extensions.go(+r: Nat, +b: Ap.Bits(), +x: List<&2, Fr.Ie>, +r4: Nat, +b4: Ap.Bits(), +m: Maybe<&2, List<&2, Fr.Ie>>, +r3: Nat, +b3: Ap.Bits(), +e: {Done{(Some{x}, Ap.Cur{r4, b4})} == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}, s: {b == Fr.Exts.write(x, r, b4) : Ap.Bits()} & {r4 == Fr.Exts.after(r) : Nat}) -> ({b == G.TAI.w_iE_Extensions(m, r, b3) : Ap.Bits()} & {r3 == G.TAI.a_iE_Extensions(m, r) : Nat}) & {True{} == Fr.Present(List<&2, Fr.Ie>, m) : Bool}:
  (s1, s2) = s
  ev = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Maybe<&2, List<&2, Fr.Ie>>, y => PA.Rd.value(Maybe<&2, List<&2, Fr.Ie>>, y, m), Done{(Some{x}, Ap.Cur{r4, b4})}, Done{(m, Ap.Cur{r3, b3})}, e)
  +ec = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Ap.Cur, y => PA.Rd.cur(Maybe<&2, List<&2, Fr.Ie>>, y, Ap.Cur{r3, b3}), Done{(Some{x}, Ap.Cur{r4, b4})}, Done{(m, Ap.Cur{r3, b3})}, e)
  eb = Equal.cong(Ap.Cur, Ap.Bits(), y => PA.Cur.bits(y), Ap.Cur{r4, b4}, Ap.Cur{r3, b3}, ec)
  er = Equal.cong(Ap.Cur, Nat, y => PA.Cur.rem(y), Ap.Cur{r4, b4}, Ap.Cur{r3, b3}, ec)
  %ev : ({b == G.TAI.w_iE_Extensions(_, r, b3) : Ap.Bits()} & {r3 == G.TAI.a_iE_Extensions(_, r) : Nat}) & {True{} == Fr.Present(List<&2, Fr.Ie>, _) : Bool}
  (((%eb : {b == Fr.Exts.write(x, r, _) : Ap.Bits()}; s1), (%er : {_ == Fr.Exts.after(r) : Nat}; s2)), {==})

def TAI.o_sx_iE_Extensions.some(+r: Nat, +b: Ap.Bits(), rd: Ap.Rd(List<&2, Fr.Ie>), +erd: {Fr.Exts.read(Ap.Cur{r, b}) == rd : Ap.Rd(List<&2, Fr.Ie>)}, +m: Maybe<&2, List<&2, Fr.Ie>>, +r3: Nat, +b3: Ap.Bits(), +e: {G.TAI.s_iE_Extensions(rd) == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}) -> ({b == G.TAI.w_iE_Extensions(m, r, b3) : Ap.Bits()} & {r3 == G.TAI.a_iE_Extensions(m, r) : Nat}) & {True{} == Fr.Present(List<&2, Fr.Ie>, m) : Bool}:
  match rd:
    case Fail{err}:
      PA.Rd.absurd(Maybe<&2, List<&2, Fr.Ie>>, ({b == G.TAI.w_iE_Extensions(m, r, b3) : Ap.Bits()} & {r3 == G.TAI.a_iE_Extensions(m, r) : Nat}) & {True{} == Fr.Present(List<&2, Fr.Ie>, m) : Bool}, err, m, Ap.Cur{r3, b3}, e)
    case Done{(+x, c4)}:
      match c4:
        case Ap.Cur{+r4, +b4}:
          TAI.o_sx_iE_Extensions.go(r, b, x, r4, b4, m, r3, b3, e, PF.Exts.sx(r, b, x, r4, b4, erd))

def TAI.o_sx_iE_Extensions(p: Bool, +r: Nat, +b: Ap.Bits(), +m: Maybe<&2, List<&2, Fr.Ie>>, +r3: Nat, +b3: Ap.Bits(), +e: {G.TAI.o_iE_Extensions(p, Ap.Cur{r, b}) == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}) -> ({b == G.TAI.w_iE_Extensions(m, r, b3) : Ap.Bits()} & {r3 == G.TAI.a_iE_Extensions(m, r) : Nat}) & {p == Fr.Present(List<&2, Fr.Ie>, m) : Bool}:
  match p:
    case False{}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Maybe<&2, List<&2, Fr.Ie>>, y => PA.Rd.value(Maybe<&2, List<&2, Fr.Ie>>, y, m), Done{(None{}, Ap.Cur{r, b})}, Done{(m, Ap.Cur{r3, b3})}, e)
      +ec = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Ap.Cur, y => PA.Rd.cur(Maybe<&2, List<&2, Fr.Ie>>, y, Ap.Cur{r3, b3}), Done{(None{}, Ap.Cur{r, b})}, Done{(m, Ap.Cur{r3, b3})}, e)
      %ev : ({b == G.TAI.w_iE_Extensions(_, r, b3) : Ap.Bits()} & {r3 == G.TAI.a_iE_Extensions(_, r) : Nat}) & {False{} == Fr.Present(List<&2, Fr.Ie>, _) : Bool}
      ((Equal.cong(Ap.Cur, Ap.Bits(), y => PA.Cur.bits(y), Ap.Cur{r, b}, Ap.Cur{r3, b3}, ec), Equal.sym(Nat, r, r3, Equal.cong(Ap.Cur, Nat, y => PA.Cur.rem(y), Ap.Cur{r, b}, Ap.Cur{r3, b3}, ec))), {==})
    case True{}:
      TAI.o_sx_iE_Extensions.some(r, b, Fr.Exts.read(Ap.Cur{r, b}), {==}, m, r3, b3, e)

def TAI.rt(+pLMNIdentity: G.PLMNIdentity(), +tAC: G.TAC(), +iE_Extensions: Maybe<&2, List<&2, Fr.Ie>>, +rem: Nat, +rest: Ap.Bits(), +ok: {G.TAI.valid(G.TAI{pLMNIdentity, tAC, iE_Extensions}) == True{} : Bool}) -> {G.TAI.read(Ap.Cur{rem, G.TAI.write(G.TAI{pLMNIdentity, tAC, iE_Extensions}, rem, rest)}) == Done{(G.TAI{pLMNIdentity, tAC, iE_Extensions}, Ap.Cur{G.TAI.after(G.TAI{pLMNIdentity, tAC, iE_Extensions}, rem), rest})} : Ap.Rd(G.TAI)}:
  ok0 = P.Bool.and_true_l(G.PLMNIdentity.valid(pLMNIdentity), Bool.and(G.TAC.valid(tAC), G.TAI.v_iE_Extensions(iE_Extensions)), ok)
  +okr0 = P.Bool.and_true_r(G.PLMNIdentity.valid(pLMNIdentity), Bool.and(G.TAC.valid(tAC), G.TAI.v_iE_Extensions(iE_Extensions)), ok)
  ok1 = P.Bool.and_true_l(G.TAC.valid(tAC), G.TAI.v_iE_Extensions(iE_Extensions), okr0)
  +okr1 = P.Bool.and_true_r(G.TAC.valid(tAC), G.TAI.v_iE_Extensions(iE_Extensions), okr0)
  e0 = Equal.sym(Ap.Rd(G.PLMNIdentity()), G.PLMNIdentity.read(Ap.Cur{Ap.Bits.after(1n, Ap.Bit.after(rem)), G.PLMNIdentity.write(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)), G.TAC.write(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem))), G.TAI.w_iE_Extensions(iE_Extensions, G.TAC.after(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)))), rest)))}), Done{(pLMNIdentity, Ap.Cur{G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem))), G.TAC.write(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem))), G.TAI.w_iE_Extensions(iE_Extensions, G.TAC.after(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)))), rest))})}, GL.ngap.PLMNIdentity.roundtrip(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)), G.TAC.write(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem))), G.TAI.w_iE_Extensions(iE_Extensions, G.TAC.after(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)))), rest)), ok0))
  %e0 : {G.TAI.r_pLMNIdentity(Fr.Present(List<&2, Fr.Ie>, iE_Extensions), _) == Done{(G.TAI{pLMNIdentity, tAC, iE_Extensions}, Ap.Cur{G.TAI.after(G.TAI{pLMNIdentity, tAC, iE_Extensions}, rem), rest})} : Ap.Rd(G.TAI)}
  e1 = Equal.sym(Ap.Rd(G.TAC()), G.TAC.read(Ap.Cur{G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem))), G.TAC.write(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem))), G.TAI.w_iE_Extensions(iE_Extensions, G.TAC.after(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)))), rest))}), Done{(tAC, Ap.Cur{G.TAC.after(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)))), G.TAI.w_iE_Extensions(iE_Extensions, G.TAC.after(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)))), rest)})}, GL.ngap.TAC.roundtrip(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem))), G.TAI.w_iE_Extensions(iE_Extensions, G.TAC.after(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)))), rest), ok1))
  %e1 : {G.TAI.r_tAC(Fr.Present(List<&2, Fr.Ie>, iE_Extensions), pLMNIdentity, _) == Done{(G.TAI{pLMNIdentity, tAC, iE_Extensions}, Ap.Cur{G.TAI.after(G.TAI{pLMNIdentity, tAC, iE_Extensions}, rem), rest})} : Ap.Rd(G.TAI)}
  e2 = Equal.sym(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), G.TAI.o_iE_Extensions(Fr.Present(List<&2, Fr.Ie>, iE_Extensions), Ap.Cur{G.TAC.after(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)))), G.TAI.w_iE_Extensions(iE_Extensions, G.TAC.after(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)))), rest)}), Done{(iE_Extensions, Ap.Cur{G.TAI.a_iE_Extensions(iE_Extensions, G.TAC.after(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem))))), rest})}, TAI.o_rt_iE_Extensions(iE_Extensions, G.TAC.after(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)))), rest, okr1))
  %e2 : {G.TAI.r_iE_Extensions(pLMNIdentity, tAC, _) == Done{(G.TAI{pLMNIdentity, tAC, iE_Extensions}, Ap.Cur{G.TAI.after(G.TAI{pLMNIdentity, tAC, iE_Extensions}, rem), rest})} : Ap.Rd(G.TAI)}
  {==}

def GL.ngap.TAI.roundtrip(v, rem, rest, ok):
  match v:
    case G.TAI{pLMNIdentity, tAC, iE_Extensions}:
      TAI.rt(pLMNIdentity, tAC, iE_Extensions, rem, rest, ok)

def TAI.dv_iE_Extensions(+p_iE_Extensions: Bool, +pLMNIdentity: G.PLMNIdentity(), +tAC: G.TAC(), +c: Ap.Cur, r: Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), +er: {G.TAI.o_iE_Extensions(p_iE_Extensions, c) == r : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}, +v: G.TAI, +c2: Ap.Cur, +e: {G.TAI.r_iE_Extensions(pLMNIdentity, tAC, r) == Done{(v, c2)} : Ap.Rd(G.TAI)}, ok0: {G.PLMNIdentity.valid(pLMNIdentity) == True{} : Bool}, ok1: {G.TAC.valid(tAC) == True{} : Bool}) -> {G.TAI.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.TAI, {G.TAI.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+iE_Extensions, +c3)}:
      ev = Equal.cong(Ap.Rd(G.TAI), G.TAI, y => PA.Rd.value(G.TAI, y, v), Done{(G.TAI{pLMNIdentity, tAC, iE_Extensions}, c3)}, Done{(v, c2)}, e)
      %ev : {G.TAI.valid(_) == True{} : Bool}
      P.Bool.and_intro(G.PLMNIdentity.valid(pLMNIdentity), Bool.and(G.TAC.valid(tAC), G.TAI.v_iE_Extensions(iE_Extensions)), ok0, P.Bool.and_intro(G.TAC.valid(tAC), G.TAI.v_iE_Extensions(iE_Extensions), ok1, TAI.o_dv_iE_Extensions(p_iE_Extensions, c, iE_Extensions, c3, er)))

def TAI.dv_tAC(+p_iE_Extensions: Bool, +pLMNIdentity: G.PLMNIdentity(), +c: Ap.Cur, r: Ap.Rd(G.TAC()), +er: {G.TAC.read(c) == r : Ap.Rd(G.TAC())}, +v: G.TAI, +c2: Ap.Cur, +e: {G.TAI.r_tAC(p_iE_Extensions, pLMNIdentity, r) == Done{(v, c2)} : Ap.Rd(G.TAI)}, ok0: {G.PLMNIdentity.valid(pLMNIdentity) == True{} : Bool}) -> {G.TAI.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.TAI, {G.TAI.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+tAC, +c3)}:
      TAI.dv_iE_Extensions(p_iE_Extensions, pLMNIdentity, tAC, c3, G.TAI.o_iE_Extensions(p_iE_Extensions, c3), {==}, v, c2, e, ok0, GL.ngap.TAC.decode_valid(c, tAC, c3, er))

def TAI.dv_pLMNIdentity(+p_iE_Extensions: Bool, +c: Ap.Cur, r: Ap.Rd(G.PLMNIdentity()), +er: {G.PLMNIdentity.read(c) == r : Ap.Rd(G.PLMNIdentity())}, +v: G.TAI, +c2: Ap.Cur, +e: {G.TAI.r_pLMNIdentity(p_iE_Extensions, r) == Done{(v, c2)} : Ap.Rd(G.TAI)}) -> {G.TAI.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.TAI, {G.TAI.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+pLMNIdentity, +c3)}:
      TAI.dv_tAC(p_iE_Extensions, pLMNIdentity, c3, G.TAC.read(c3), {==}, v, c2, e, GL.ngap.PLMNIdentity.decode_valid(c, pLMNIdentity, c3, er))

def TAI.dv_bm(r: Ap.Rd(Ap.Bits()), +v: G.TAI, +c2: Ap.Cur, +e: {G.TAI.r_bm(r) == Done{(v, c2)} : Ap.Rd(G.TAI)}) -> {G.TAI.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.TAI, {G.TAI.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(bm, +c3)}:
      match bm:
        case p_iE_Extensions <> Nil{}:
          TAI.dv_pLMNIdentity(p_iE_Extensions, c3, G.PLMNIdentity.read(c3), {==}, v, c2, e)
        case Nil{}:
          PA.Rd.absurd(G.TAI, {G.TAI.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)
        case q0 <> q1 <> more:
          PA.Rd.absurd(G.TAI, {G.TAI.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)

def TAI.dv_ext(rb: Ap.Rd(Bool), +v: G.TAI, +c2: Ap.Cur, +e: {G.TAI.r_ext(rb) == Done{(v, c2)} : Ap.Rd(G.TAI)}) -> {G.TAI.valid(v) == True{} : Bool}:
  match rb:
    case Fail{err}:
      PA.Rd.absurd(G.TAI, {G.TAI.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, +c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.TAI, {G.TAI.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
          TAI.dv_bm(Ap.Bits.read(1n, c), v, c2, e)

def GL.ngap.TAI.decode_valid(c, v, c2, e):
  TAI.dv_ext(Ap.Bit.read(c), v, c2, e)

