def AllocationAndRetentionPriority.o_dv_iE_Extensions.some(+c: Ap.Cur, r: Ap.Rd(List<&2, Fr.Ie>), +er: {Fr.Exts.read(c) == r : Ap.Rd(List<&2, Fr.Ie>)}, +m: Maybe<&2, List<&2, Fr.Ie>>, +c2: Ap.Cur, +e: {G.AllocationAndRetentionPriority.s_iE_Extensions(r) == Done{(m, c2)} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}) -> {G.AllocationAndRetentionPriority.v_iE_Extensions(m) == True{} : Bool}:
