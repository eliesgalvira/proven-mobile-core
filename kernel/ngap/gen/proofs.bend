def N3IWF_ID.rt_choice_Extensions(+x: Fr.Ie, +rem: Nat, +rest: Ap.Bits(), +ok: {Fr.Ie.valid(x) == True{} : Bool}) -> {G.N3IWF_ID.read(Ap.Cur{rem, G.N3IWF_ID.write(G.N3IWF_ID_choice_Extensions{x}, rem, rest)}) == Done{(G.N3IWF_ID_choice_Extensions{x}, Ap.Cur{G.N3IWF_ID.after(G.N3IWF_ID_choice_Extensions{x}, rem), rest})} : Ap.Rd(G.N3IWF_ID)}:
