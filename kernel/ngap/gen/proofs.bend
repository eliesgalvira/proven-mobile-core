      GL.ngap.GlobalN3IWF_ID.decode_valid(c, x, c3, er)

def GlobalRANNodeID.dv_choice_Extensions(+c: Ap.Cur, r: Ap.Rd(Fr.Ie), +er: {Fr.Ie.read(c) == r : Ap.Rd(Fr.Ie)}, +v: G.GlobalRANNodeID, +c2: Ap.Cur, +e: {G.GlobalRANNodeID.c_choice_Extensions(r) == Done{(v, c2)} : Ap.Rd(G.GlobalRANNodeID)}) -> {G.GlobalRANNodeID.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.GlobalRANNodeID, {G.GlobalRANNodeID.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.GlobalRANNodeID), G.GlobalRANNodeID, y => PA.Rd.value(G.GlobalRANNodeID, y, v), Done{(G.GlobalRANNodeID_choice_Extensions{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.GlobalRANNodeID.valid(_) == True{} : Bool}
      L.ngap.ie.decode_valid(c, x, c3, er)

def GlobalRANNodeID.dv_alt(i: Nat, +c: Ap.Cur, +v: G.GlobalRANNodeID, +c2: Ap.Cur, +e: {G.GlobalRANNodeID.alt(i, c) == Done{(v, c2)} : Ap.Rd(G.GlobalRANNodeID)}) -> {G.GlobalRANNodeID.valid(v) == True{} : Bool}:
  match i:
    case 0n:
      GlobalRANNodeID.dv_globalGNB_ID(c, G.GlobalGNB_ID.read(c), {==}, v, c2, e)
    case 1n:
      GlobalRANNodeID.dv_globalNgENB_ID(c, G.GlobalNgENB_ID.read(c), {==}, v, c2, e)
    case 2n:
      GlobalRANNodeID.dv_globalN3IWF_ID(c, G.GlobalN3IWF_ID.read(c), {==}, v, c2, e)
    case 3n:
      GlobalRANNodeID.dv_choice_Extensions(c, Fr.Ie.read(c), {==}, v, c2, e)
    case 4n+p:
      PA.Rd.absurd(G.GlobalRANNodeID, {G.GlobalRANNodeID.valid(v) == True{} : Bool}, B.Invalid{0}, v, c2, e)

def GlobalRANNodeID.dv_idx(r: Ap.Rd(Nat), +v: G.GlobalRANNodeID, +c2: Ap.Cur, +e: {G.GlobalRANNodeID.r_idx(r) == Done{(v, c2)} : Ap.Rd(G.GlobalRANNodeID)}) -> {G.GlobalRANNodeID.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.GlobalRANNodeID, {G.GlobalRANNodeID.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(i, c)}:
      GlobalRANNodeID.dv_alt(i, c, v, c2, e)

def GL.ngap.GlobalRANNodeID.decode_valid(c, v, c2, e):
  GlobalRANNodeID.dv_idx(Ap.Size.read(False{}, 2n, 0n, 3n, c), v, c2, e)

def GlobalRANNodeID.sx_globalGNB_ID.go(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), +x: G.GlobalGNB_ID, +r3: Nat, +b3: Ap.Bits(), +v: G.GlobalRANNodeID, +rem2: Nat, +bits2: Ap.Bits(), +e: {Done{(G.GlobalRANNodeID_globalGNB_ID{x}, Ap.Cur{r3, b3})} == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalRANNodeID)}, pre: {bits == b0 : Ap.Bits()}, +pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 2n, 0n, 0n, r0, b1), r1, Ap.Size.after(False{}, 2n, r0)), s: {b1 == G.GlobalGNB_ID.write(x, r1, b3) : Ap.Bits()} & {r3 == G.GlobalGNB_ID.after(x, r1) : Nat}) -> GlobalRANNodeID.Sx(bits, v, rem, rem2, bits2):
  (ss1, +ss2) = ss
  (s1, s2) = s
  ev = Equal.cong(Ap.Rd(G.GlobalRANNodeID), G.GlobalRANNodeID, y => PA.Rd.value(G.GlobalRANNodeID, y, v), Done{(G.GlobalRANNodeID_globalGNB_ID{x}, Ap.Cur{r3, b3})}, Done{(v, Ap.Cur{rem2, bits2})}, e)
  +ec = Equal.cong(Ap.Rd(G.GlobalRANNodeID), Ap.Cur, y => PA.Rd.cur(G.GlobalRANNodeID, y, Ap.Cur{rem2, bits2}), Done{(G.GlobalRANNodeID_globalGNB_ID{x}, Ap.Cur{r3, b3})}, Done{(v, Ap.Cur{rem2, bits2})}, e)
  eb = Equal.cong(Ap.Cur, Ap.Bits(), x => PA.Cur.bits(x), Ap.Cur{r3, b3}, Ap.Cur{rem2, bits2}, ec)
  er = Equal.cong(Ap.Cur, Nat, x => PA.Cur.rem(x), Ap.Cur{r3, b3}, Ap.Cur{rem2, bits2}, ec)
  %ev : GlobalRANNodeID.Sx(bits, _, rem, rem2, bits2)
  ((%pr : {bits == Ap.Size.write(False{}, 2n, 0n, 0n, _, G.GlobalGNB_ID.write(x, Ap.Size.after(False{}, 2n, _), bits2)) : Ap.Bits()}; (%ss2 : {bits == Ap.Size.write(False{}, 2n, 0n, 0n, r0, G.GlobalGNB_ID.write(x, _, bits2)) : Ap.Bits()}; (%eb : {bits == Ap.Size.write(False{}, 2n, 0n, 0n, r0, G.GlobalGNB_ID.write(x, r1, _)) : Ap.Bits()}; (%s1 : {bits == Ap.Size.write(False{}, 2n, 0n, 0n, r0, _) : Ap.Bits()}; (%ss1 : {bits == _ : Ap.Bits()}; pre))))), (%er : {_ == G.GlobalGNB_ID.after(x, Ap.Size.after(False{}, 2n, rem)) : Nat}; (%pr : {r3 == G.GlobalGNB_ID.after(x, Ap.Size.after(False{}, 2n, _)) : Nat}; (%ss2 : {r3 == G.GlobalGNB_ID.after(x, _) : Nat}; s2))))

def GlobalRANNodeID.sx_globalGNB_ID(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), rd: Ap.Rd(G.GlobalGNB_ID), +erd: {G.GlobalGNB_ID.read(Ap.Cur{r1, b1}) == rd : Ap.Rd(G.GlobalGNB_ID)}, +v: G.GlobalRANNodeID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GlobalRANNodeID.c_globalGNB_ID(rd) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalRANNodeID)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 2n, 0n, 0n, r0, b1), r1, Ap.Size.after(False{}, 2n, r0))) -> GlobalRANNodeID.Sx(bits, v, rem, rem2, bits2):
