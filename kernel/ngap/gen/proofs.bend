def GL.ngap.UPTransportLayerInformation.roundtrip(v, rem, rest, ok):
  match v:
    case G.UPTransportLayerInformation_gTPTunnel{x}:
      UPTransportLayerInformation.rt_gTPTunnel(x, rem, rest, ok)
    case G.UPTransportLayerInformation_choice_Extensions{x}:
      UPTransportLayerInformation.rt_choice_Extensions(x, rem, rest, ok)

def UPTransportLayerInformation.dv_gTPTunnel(+c: Ap.Cur, r: Ap.Rd(G.GTPTunnel), +er: {G.GTPTunnel.read(c) == r : Ap.Rd(G.GTPTunnel)}, +v: G.UPTransportLayerInformation, +c2: Ap.Cur, +e: {G.UPTransportLayerInformation.c_gTPTunnel(r) == Done{(v, c2)} : Ap.Rd(G.UPTransportLayerInformation)}) -> {G.UPTransportLayerInformation.valid(v) == True{} : Bool}:
