def TargetID.rt_choice_Extensions(+x: Fr.Ie, +rem: Nat, +rest: Ap.Bits(), +ok: {Fr.Ie.valid(x) == True{} : Bool}) -> {G.TargetID.read(Ap.Cur{rem, G.TargetID.write(G.TargetID_choice_Extensions{x}, rem, rest)}) == Done{(G.TargetID_choice_Extensions{x}, Ap.Cur{G.TargetID.after(G.TargetID_choice_Extensions{x}, rem), rest})} : Ap.Rd(G.TargetID)}:
