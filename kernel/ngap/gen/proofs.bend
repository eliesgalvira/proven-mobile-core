  e1 = Equal.sym(Ap.Rd(Nat), Ap.Size.read(False{}, 3n, 0n, 5n, Ap.Cur{rem, Ap.Size.write(False{}, 3n, 0n, 5n, rem, Fr.Ie.write(x, Ap.Size.after(False{}, 3n, rem), rest))}), Done{(5n, Ap.Cur{Ap.Size.after(False{}, 3n, rem), Fr.Ie.write(x, Ap.Size.after(False{}, 3n, rem), rest)})}, L.aper.size.roundtrip(False{}, 3n, 0n, 5n, 5n, rem, Fr.Ie.write(x, Ap.Size.after(False{}, 3n, rem), rest), {==}, {==}))
  %e1 : {G.Cause.r_idx(_) == Done{(G.Cause_choice_Extensions{x}, Ap.Cur{G.Cause.after(G.Cause_choice_Extensions{x}, rem), rest})} : Ap.Rd(G.Cause)}
  e2 = Equal.sym(Ap.Rd(Fr.Ie), Fr.Ie.read(Ap.Cur{Ap.Size.after(False{}, 3n, rem), Fr.Ie.write(x, Ap.Size.after(False{}, 3n, rem), rest)}), Done{(x, Ap.Cur{Fr.Ie.after(Ap.Size.after(False{}, 3n, rem)), rest})}, L.ngap.ie.roundtrip(x, Ap.Size.after(False{}, 3n, rem), rest, ok))
