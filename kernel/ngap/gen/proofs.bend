def PacketErrorRate.sx(+rem: Nat, bits: Ap.Bits(), +v: G.PacketErrorRate, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.PacketErrorRate.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.PacketErrorRate)}) -> PacketErrorRate.Sx(bits, v, rem, rem2, bits2):
