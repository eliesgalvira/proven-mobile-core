def GL.ngap.DRBStatusUL.roundtrip(v, rem, rest, ok):
  match v:
    case G.DRBStatusUL_dRBStatusUL12{x}:
      DRBStatusUL.rt_dRBStatusUL12(x, rem, rest, ok)
    case G.DRBStatusUL_dRBStatusUL18{x}:
      DRBStatusUL.rt_dRBStatusUL18(x, rem, rest, ok)
    case G.DRBStatusUL_choice_Extensions{x}:
      DRBStatusUL.rt_choice_Extensions(x, rem, rest, ok)

def DRBStatusUL.dv_dRBStatusUL12(+c: Ap.Cur, r: Ap.Rd(G.DRBStatusUL12), +er: {G.DRBStatusUL12.read(c) == r : Ap.Rd(G.DRBStatusUL12)}, +v: G.DRBStatusUL, +c2: Ap.Cur, +e: {G.DRBStatusUL.c_dRBStatusUL12(r) == Done{(v, c2)} : Ap.Rd(G.DRBStatusUL)}) -> {G.DRBStatusUL.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.DRBStatusUL, {G.DRBStatusUL.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.DRBStatusUL), G.DRBStatusUL, y => PA.Rd.value(G.DRBStatusUL, y, v), Done{(G.DRBStatusUL_dRBStatusUL12{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.DRBStatusUL.valid(_) == True{} : Bool}
      GL.ngap.DRBStatusUL12.decode_valid(c, x, c3, er)

