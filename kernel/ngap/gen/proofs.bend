def DRBStatusUL18.sx(+rem: Nat, bits: Ap.Bits(), +v: G.DRBStatusUL18, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.DRBStatusUL18.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.DRBStatusUL18)}) -> DRBStatusUL18.Sx(bits, v, rem, rem2, bits2):
