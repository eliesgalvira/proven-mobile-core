def QosCharacteristics.sx_alt(i: Nat, +rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), +v: G.QosCharacteristics, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.QosCharacteristics.alt(i, Ap.Cur{r1, b1}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.QosCharacteristics)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 2n, 0n, i, r0, b1), r1, Ap.Size.after(False{}, 2n, r0))) -> QosCharacteristics.Sx(bits, v, rem, rem2, bits2):
  match i:
    case 0n:
      QosCharacteristics.sx_nonDynamic5QI(rem, bits, r0, b0, r1, b1, G.NonDynamic5QIDescriptor.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 1n:
      QosCharacteristics.sx_dynamic5QI(rem, bits, r0, b0, r1, b1, G.Dynamic5QIDescriptor.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 2n:
      QosCharacteristics.sx_choice_Extensions(rem, bits, r0, b0, r1, b1, Fr.Ie.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 3n+p:
      PA.Rd.absurd(G.QosCharacteristics, QosCharacteristics.Sx(bits, v, rem, rem2, bits2), B.Invalid{0}, v, Ap.Cur{rem2, bits2}, e)

def QosCharacteristics.sx_idx(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Nat), +er: {Ap.Size.read(False{}, 2n, 0n, 2n, Ap.Cur{r0, b0}) == r : Ap.Rd(Nat)}, +v: G.QosCharacteristics, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.QosCharacteristics.r_idx(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.QosCharacteristics)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}) -> QosCharacteristics.Sx(bits, v, rem, rem2, bits2):
