def S_NSSAI.sx_sST.go(+p_sD: Bool, +p_iE_Extensions: Bool, +rem: Nat, +bits: Ap.Bits(), +ri: Nat, +bi: Ap.Bits(), +sST: G.SST(), +r3: Nat, +b3: Ap.Bits(), +v: G.S_NSSAI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.S_NSSAI.r_sD(p_iE_Extensions, sST, G.S_NSSAI.o_sD(p_sD, Ap.Cur{r3, b3})) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.S_NSSAI)}, pre: {bits == Ap.Bit.write(False{}, rem, Ap.Bits.write([p_sD, p_iE_Extensions], Ap.Bit.after(rem), bi)) : Ap.Bits()}, +pr: {ri == Ap.Bits.after(2n, Ap.Bit.after(rem)) : Nat}, s: {bi == G.SST.write(sST, ri, b3) : Ap.Bits()} & {r3 == G.SST.after(sST, ri) : Nat}) -> S_NSSAI.Sx(bits, v, rem, rem2, bits2):
  (s1, s2) = s
  S_NSSAI.sx_sD(p_sD, p_iE_Extensions, sST, rem, bits, r3, b3, G.S_NSSAI.o_sD(p_sD, Ap.Cur{r3, b3}), {==}, v, rem2, bits2, e, (%pr : {bits == Ap.Bit.write(False{}, rem, Ap.Bits.write([p_sD, p_iE_Extensions], Ap.Bit.after(rem), G.SST.write(sST, _, b3))) : Ap.Bits()}; (%s1 : {bits == Ap.Bit.write(False{}, rem, Ap.Bits.write([p_sD, p_iE_Extensions], Ap.Bit.after(rem), _)) : Ap.Bits()}; pre)), (%pr : {r3 == G.SST.after(sST, _) : Nat}; s2))

def S_NSSAI.sx_sST(+p_sD: Bool, +p_iE_Extensions: Bool, +rem: Nat, +bits: Ap.Bits(), +ri: Nat, +bi: Ap.Bits(), r: Ap.Rd(G.SST()), +er: {G.SST.read(Ap.Cur{ri, bi}) == r : Ap.Rd(G.SST())}, +v: G.S_NSSAI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.S_NSSAI.r_sST(p_sD, p_iE_Extensions, r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.S_NSSAI)}, pre: {bits == Ap.Bit.write(False{}, rem, Ap.Bits.write([p_sD, p_iE_Extensions], Ap.Bit.after(rem), bi)) : Ap.Bits()}, pr: {ri == Ap.Bits.after(2n, Ap.Bit.after(rem)) : Nat}) -> S_NSSAI.Sx(bits, v, rem, rem2, bits2):
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.S_NSSAI, S_NSSAI.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(+sST, c3)}:
      match c3:
        case Ap.Cur{+r3, +b3}:
          S_NSSAI.sx_sST.go(p_sD, p_iE_Extensions, rem, bits, ri, bi, sST, r3, b3, v, rem2, bits2, e, pre, pr, GL.ngap.SST.suffix(ri, bi, sST, r3, b3, er))

def S_NSSAI.sx_bm.go(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +p_sD: Bool, +p_iE_Extensions: Bool, +r1: Nat, +b1: Ap.Bits(), +v: G.S_NSSAI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.S_NSSAI.r_sST(p_sD, p_iE_Extensions, G.SST.read(Ap.Cur{r1, b1})) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.S_NSSAI)}, pre: {bits == Ap.Bit.write(False{}, rem, b0) : Ap.Bits()}, +pr: {r0 == Ap.Bit.after(rem) : Nat}, s: PC.Canon(b0, Ap.Bits.write([p_sD, p_iE_Extensions], r0, b1), r1, Ap.Bits.after(2n, r0)) & {List.length(&2, Bool, [p_sD, p_iE_Extensions]) == 2n : Nat}) -> S_NSSAI.Sx(bits, v, rem, rem2, bits2):
  (cn, len) = s
  (s1, s2) = cn
  S_NSSAI.sx_sST(p_sD, p_iE_Extensions, rem, bits, r1, b1, G.SST.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, (%pr : {bits == Ap.Bit.write(False{}, rem, Ap.Bits.write([p_sD, p_iE_Extensions], _, b1)) : Ap.Bits()}; (%s1 : {bits == Ap.Bit.write(False{}, rem, _) : Ap.Bits()}; pre)), (%pr : {r1 == Ap.Bits.after(2n, _) : Nat}; s2))

def S_NSSAI.sx_bm(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Ap.Bits()), +er: {Ap.Bits.read(2n, Ap.Cur{r0, b0}) == r : Ap.Rd(Ap.Bits())}, +v: G.S_NSSAI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.S_NSSAI.r_bm(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.S_NSSAI)}, pre: {bits == Ap.Bit.write(False{}, rem, b0) : Ap.Bits()}, pr: {r0 == Ap.Bit.after(rem) : Nat}) -> S_NSSAI.Sx(bits, v, rem, rem2, bits2):
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.S_NSSAI, S_NSSAI.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(bm, c1)}:
      match bm:
        case +p_sD <> +p_iE_Extensions <> Nil{}:
          match c1:
            case Ap.Cur{+r1, +b1}:
              S_NSSAI.sx_bm.go(rem, bits, r0, b0, p_sD, p_iE_Extensions, r1, b1, v, rem2, bits2, e, pre, pr, PC.Bits.sx(2n, r0, b0, [p_sD, p_iE_Extensions], r1, b1, er))
        case Nil{}:
          PA.Rd.absurd(G.S_NSSAI, S_NSSAI.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
        case q0 <> Nil{}:
          PA.Rd.absurd(G.S_NSSAI, S_NSSAI.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
        case q0 <> q1 <> q2 <> more:
          PA.Rd.absurd(G.S_NSSAI, S_NSSAI.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)

def S_NSSAI.sx(+rem: Nat, bits: Ap.Bits(), +v: G.S_NSSAI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.S_NSSAI.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.S_NSSAI)}) -> S_NSSAI.Sx(bits, v, rem, rem2, bits2):
  match bits:
    case Nil{}:
      PA.Rd.absurd(G.S_NSSAI, S_NSSAI.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.S_NSSAI, S_NSSAI.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          S_NSSAI.sx_bm(rem, False{} <> rest, Ap.Bit.after(rem), rest, Ap.Bits.read(2n, Ap.Cur{Ap.Bit.after(rem), rest}), {==}, v, rem2, bits2, e, {==}, {==})

def GL.ngap.S_NSSAI.suffix(rem, bits, v, rem2, bits2, e):
  S_NSSAI.sx(rem, bits, v, rem2, bits2, e)

def SliceSupportItem.Sx(+bits: Ap.Bits(), +v: G.SliceSupportItem, +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
  {bits == G.SliceSupportItem.write(v, rem, bits2) : Ap.Bits()} & {rem2 == G.SliceSupportItem.after(v, rem) : Nat}

def SliceSupportItem.o_rt_iE_Extensions(m: Maybe<&2, List<&2, Fr.Ie>>, +r: Nat, +inner: Ap.Bits(), ok: {G.SliceSupportItem.v_iE_Extensions(m) == True{} : Bool}) -> {G.SliceSupportItem.o_iE_Extensions(Fr.Present(List<&2, Fr.Ie>, m), Ap.Cur{r, G.SliceSupportItem.w_iE_Extensions(m, r, inner)}) == Done{(m, Ap.Cur{G.SliceSupportItem.a_iE_Extensions(m, r), inner})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}:
  match m:
    case None{}:
      {==}
    case Some{+x}:
      e1 = Equal.sym(Ap.Rd(List<&2, Fr.Ie>), Fr.Exts.read(Ap.Cur{r, Fr.Exts.write(x, r, inner)}), Done{(x, Ap.Cur{Fr.Exts.after(r), inner})}, L.ngap.exts.roundtrip(x, r, inner, ok))
      %e1 : {G.SliceSupportItem.s_iE_Extensions(_) == Done{(Some{x}, Ap.Cur{Fr.Exts.after(r), inner})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}
      {==}

def SliceSupportItem.o_dv_iE_Extensions.some(+c: Ap.Cur, r: Ap.Rd(List<&2, Fr.Ie>), +er: {Fr.Exts.read(c) == r : Ap.Rd(List<&2, Fr.Ie>)}, +m: Maybe<&2, List<&2, Fr.Ie>>, +c2: Ap.Cur, +e: {G.SliceSupportItem.s_iE_Extensions(r) == Done{(m, c2)} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}) -> {G.SliceSupportItem.v_iE_Extensions(m) == True{} : Bool}:
