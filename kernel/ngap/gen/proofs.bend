    case True{}:
      SliceSupportItem.o_dv_iE_Extensions.some(c, Fr.Exts.read(c), {==}, m, c2, e)

def SliceSupportItem.o_sx_iE_Extensions.go(+r: Nat, +b: Ap.Bits(), +x: List<&2, Fr.Ie>, +r4: Nat, +b4: Ap.Bits(), +m: Maybe<&2, List<&2, Fr.Ie>>, +r3: Nat, +b3: Ap.Bits(), +e: {Done{(Some{x}, Ap.Cur{r4, b4})} == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}, s: {b == Fr.Exts.write(x, r, b4) : Ap.Bits()} & {r4 == Fr.Exts.after(r) : Nat}) -> ({b == G.SliceSupportItem.w_iE_Extensions(m, r, b3) : Ap.Bits()} & {r3 == G.SliceSupportItem.a_iE_Extensions(m, r) : Nat}) & {True{} == Fr.Present(List<&2, Fr.Ie>, m) : Bool}:
  (s1, s2) = s
  ev = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Maybe<&2, List<&2, Fr.Ie>>, y => PA.Rd.value(Maybe<&2, List<&2, Fr.Ie>>, y, m), Done{(Some{x}, Ap.Cur{r4, b4})}, Done{(m, Ap.Cur{r3, b3})}, e)
