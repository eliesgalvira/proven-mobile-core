  (s1, s2) = s
  (Equal.cong(Ap.Bits(), Ap.Bits(), l => False{} <> l, rest, Fr.Ies.write(v, Ap.Bit.after(rem), bits2), s1), s2)

def InitialContextSetupRequest.sx(+rem: Nat, bits: Ap.Bits(), +v: G.InitialContextSetupRequest(), +rem2: Nat, +bits2: Ap.Bits(), +e: {G.InitialContextSetupRequest.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.InitialContextSetupRequest())}) -> InitialContextSetupRequest.Sx(bits, v, rem, rem2, bits2):
  match bits:
    case Nil{}:
      PA.Rd.absurd(G.InitialContextSetupRequest(), InitialContextSetupRequest.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.InitialContextSetupRequest(), InitialContextSetupRequest.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          InitialContextSetupRequest.sx.go(rem, rest, v, rem2, bits2, PF.Ies.sx(Ap.Bit.after(rem), rest, v, rem2, bits2, e))

