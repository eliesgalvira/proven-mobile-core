def AllocationAndRetentionPriority.o_rt_iE_Extensions(m: Maybe<&2, List<&2, Fr.Ie>>, +r: Nat, +inner: Ap.Bits(), ok: {G.AllocationAndRetentionPriority.v_iE_Extensions(m) == True{} : Bool}) -> {G.AllocationAndRetentionPriority.o_iE_Extensions(Fr.Present(List<&2, Fr.Ie>, m), Ap.Cur{r, G.AllocationAndRetentionPriority.w_iE_Extensions(m, r, inner)}) == Done{(m, Ap.Cur{G.AllocationAndRetentionPriority.a_iE_Extensions(m, r), inner})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}:
