def GlobalRANNodeID.sx_choice_Extensions.go(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), +x: Fr.Ie, +r3: Nat, +b3: Ap.Bits(), +v: G.GlobalRANNodeID, +rem2: Nat, +bits2: Ap.Bits(), +e: {Done{(G.GlobalRANNodeID_choice_Extensions{x}, Ap.Cur{r3, b3})} == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalRANNodeID)}, pre: {bits == b0 : Ap.Bits()}, +pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 2n, 0n, 3n, r0, b1), r1, Ap.Size.after(False{}, 2n, r0)), s: {b1 == Fr.Ie.write(x, r1, b3) : Ap.Bits()} & {r3 == Fr.Ie.after(r1) : Nat}) -> GlobalRANNodeID.Sx(bits, v, rem, rem2, bits2):
  (ss1, +ss2) = ss
  (s1, s2) = s
  ev = Equal.cong(Ap.Rd(G.GlobalRANNodeID), G.GlobalRANNodeID, y => PA.Rd.value(G.GlobalRANNodeID, y, v), Done{(G.GlobalRANNodeID_choice_Extensions{x}, Ap.Cur{r3, b3})}, Done{(v, Ap.Cur{rem2, bits2})}, e)
  +ec = Equal.cong(Ap.Rd(G.GlobalRANNodeID), Ap.Cur, y => PA.Rd.cur(G.GlobalRANNodeID, y, Ap.Cur{rem2, bits2}), Done{(G.GlobalRANNodeID_choice_Extensions{x}, Ap.Cur{r3, b3})}, Done{(v, Ap.Cur{rem2, bits2})}, e)
  eb = Equal.cong(Ap.Cur, Ap.Bits(), x => PA.Cur.bits(x), Ap.Cur{r3, b3}, Ap.Cur{rem2, bits2}, ec)
  er = Equal.cong(Ap.Cur, Nat, x => PA.Cur.rem(x), Ap.Cur{r3, b3}, Ap.Cur{rem2, bits2}, ec)
  %ev : GlobalRANNodeID.Sx(bits, _, rem, rem2, bits2)
  ((%pr : {bits == Ap.Size.write(False{}, 2n, 0n, 3n, _, Fr.Ie.write(x, Ap.Size.after(False{}, 2n, _), bits2)) : Ap.Bits()}; (%ss2 : {bits == Ap.Size.write(False{}, 2n, 0n, 3n, r0, Fr.Ie.write(x, _, bits2)) : Ap.Bits()}; (%eb : {bits == Ap.Size.write(False{}, 2n, 0n, 3n, r0, Fr.Ie.write(x, r1, _)) : Ap.Bits()}; (%s1 : {bits == Ap.Size.write(False{}, 2n, 0n, 3n, r0, _) : Ap.Bits()}; (%ss1 : {bits == _ : Ap.Bits()}; pre))))), (%er : {_ == Fr.Ie.after(Ap.Size.after(False{}, 2n, rem)) : Nat}; (%pr : {r3 == Fr.Ie.after(Ap.Size.after(False{}, 2n, _)) : Nat}; (%ss2 : {r3 == Fr.Ie.after(_) : Nat}; s2))))

def GlobalRANNodeID.sx_choice_Extensions(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), rd: Ap.Rd(Fr.Ie), +erd: {Fr.Ie.read(Ap.Cur{r1, b1}) == rd : Ap.Rd(Fr.Ie)}, +v: G.GlobalRANNodeID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GlobalRANNodeID.c_choice_Extensions(rd) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalRANNodeID)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 2n, 0n, 3n, r0, b1), r1, Ap.Size.after(False{}, 2n, r0))) -> GlobalRANNodeID.Sx(bits, v, rem, rem2, bits2):
  match rd:
    case Fail{err}:
      PA.Rd.absurd(G.GlobalRANNodeID, GlobalRANNodeID.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(+x, c3)}:
      match c3:
        case Ap.Cur{+r3, +b3}:
          GlobalRANNodeID.sx_choice_Extensions.go(rem, bits, r0, b0, r1, b1, x, r3, b3, v, rem2, bits2, e, pre, pr, ss, PF.Ie.sx(r1, b1, x, r3, b3, erd))

def GlobalRANNodeID.sx_alt(i: Nat, +rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), +v: G.GlobalRANNodeID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GlobalRANNodeID.alt(i, Ap.Cur{r1, b1}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalRANNodeID)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 2n, 0n, i, r0, b1), r1, Ap.Size.after(False{}, 2n, r0))) -> GlobalRANNodeID.Sx(bits, v, rem, rem2, bits2):
  match i:
    case 0n:
      GlobalRANNodeID.sx_globalGNB_ID(rem, bits, r0, b0, r1, b1, G.GlobalGNB_ID.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 1n:
      GlobalRANNodeID.sx_globalNgENB_ID(rem, bits, r0, b0, r1, b1, G.GlobalNgENB_ID.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 2n:
      GlobalRANNodeID.sx_globalN3IWF_ID(rem, bits, r0, b0, r1, b1, G.GlobalN3IWF_ID.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 3n:
      GlobalRANNodeID.sx_choice_Extensions(rem, bits, r0, b0, r1, b1, Fr.Ie.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 4n+p:
      PA.Rd.absurd(G.GlobalRANNodeID, GlobalRANNodeID.Sx(bits, v, rem, rem2, bits2), B.Invalid{0}, v, Ap.Cur{rem2, bits2}, e)

def GlobalRANNodeID.sx_idx(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Nat), +er: {Ap.Size.read(False{}, 2n, 0n, 3n, Ap.Cur{r0, b0}) == r : Ap.Rd(Nat)}, +v: G.GlobalRANNodeID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GlobalRANNodeID.r_idx(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalRANNodeID)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}) -> GlobalRANNodeID.Sx(bits, v, rem, rem2, bits2):
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.GlobalRANNodeID, GlobalRANNodeID.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(+i, c1)}:
      match c1:
        case Ap.Cur{+r1, +b1}:
          GlobalRANNodeID.sx_alt(i, rem, bits, r0, b0, r1, b1, v, rem2, bits2, e, pre, pr, PC.Size.sx(False{}, 2n, 0n, 3n, r0, b0, i, r1, b1, er))

def GL.ngap.GlobalRANNodeID.suffix(rem, bits, v, rem2, bits2, e):
  GlobalRANNodeID.sx_idx(rem, bits, rem, bits, Ap.Size.read(False{}, 2n, 0n, 3n, Ap.Cur{rem, bits}), {==}, v, rem2, bits2, e, {==}, {==})

def GL.ngap.TAC.roundtrip(v, rem, rest, ok):
  PA.AOctets.rt_n(3n, v, rem, rest, ok)

def GL.ngap.TAC.decode_valid(c, v, c2, e):
  PA.AOctets.dv_n(3n, c, v, c2, e)

def GL.ngap.TAC.suffix(rem, bits, v, rem2, bits2, e):
  PC.AOctets.sx_n(3n, rem, bits, v, rem2, bits2, e)

def GL.ngap.SST.roundtrip(v, rem, rest, ok):
