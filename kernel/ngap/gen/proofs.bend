def TAI.sx_bm.go(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +p_iE_Extensions: Bool, +r1: Nat, +b1: Ap.Bits(), +v: G.TAI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.TAI.r_pLMNIdentity(p_iE_Extensions, G.PLMNIdentity.read(Ap.Cur{r1, b1})) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.TAI)}, pre: {bits == Ap.Bit.write(False{}, rem, b0) : Ap.Bits()}, +pr: {r0 == Ap.Bit.after(rem) : Nat}, s: PC.Canon(b0, Ap.Bits.write([p_iE_Extensions], r0, b1), r1, Ap.Bits.after(1n, r0)) & {List.length(&2, Bool, [p_iE_Extensions]) == 1n : Nat}) -> TAI.Sx(bits, v, rem, rem2, bits2):
  (cn, len) = s
  (s1, s2) = cn
  TAI.sx_pLMNIdentity(p_iE_Extensions, rem, bits, r1, b1, G.PLMNIdentity.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, (%pr : {bits == Ap.Bit.write(False{}, rem, Ap.Bits.write([p_iE_Extensions], _, b1)) : Ap.Bits()}; (%s1 : {bits == Ap.Bit.write(False{}, rem, _) : Ap.Bits()}; pre)), (%pr : {r1 == Ap.Bits.after(1n, _) : Nat}; s2))

def TAI.sx_bm(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Ap.Bits()), +er: {Ap.Bits.read(1n, Ap.Cur{r0, b0}) == r : Ap.Rd(Ap.Bits())}, +v: G.TAI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.TAI.r_bm(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.TAI)}, pre: {bits == Ap.Bit.write(False{}, rem, b0) : Ap.Bits()}, pr: {r0 == Ap.Bit.after(rem) : Nat}) -> TAI.Sx(bits, v, rem, rem2, bits2):
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.TAI, TAI.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(bm, c1)}:
      match bm:
        case +p_iE_Extensions <> Nil{}:
          match c1:
            case Ap.Cur{+r1, +b1}:
              TAI.sx_bm.go(rem, bits, r0, b0, p_iE_Extensions, r1, b1, v, rem2, bits2, e, pre, pr, PC.Bits.sx(1n, r0, b0, [p_iE_Extensions], r1, b1, er))
        case Nil{}:
          PA.Rd.absurd(G.TAI, TAI.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
        case q0 <> q1 <> more:
          PA.Rd.absurd(G.TAI, TAI.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)

def TAI.sx(+rem: Nat, bits: Ap.Bits(), +v: G.TAI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.TAI.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.TAI)}) -> TAI.Sx(bits, v, rem, rem2, bits2):
  match bits:
    case Nil{}:
      PA.Rd.absurd(G.TAI, TAI.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.TAI, TAI.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          TAI.sx_bm(rem, False{} <> rest, Ap.Bit.after(rem), rest, Ap.Bits.read(1n, Ap.Cur{Ap.Bit.after(rem), rest}), {==}, v, rem2, bits2, e, {==}, {==})

def GL.ngap.TAI.suffix(rem, bits, v, rem2, bits2, e):
  TAI.sx(rem, bits, v, rem2, bits2, e)

def GL.ngap.TimeStamp.roundtrip(v, rem, rest, ok):
  PA.AOctets.rt_n(4n, v, rem, rest, ok)

def GL.ngap.TimeStamp.decode_valid(c, v, c2, e):
  PA.AOctets.dv_n(4n, c, v, c2, e)

def GL.ngap.TimeStamp.suffix(rem, bits, v, rem2, bits2, e):
  PC.AOctets.sx_n(4n, rem, bits, v, rem2, bits2, e)

def UserLocationInformationEUTRA.Sx(+bits: Ap.Bits(), +v: G.UserLocationInformationEUTRA, +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
  {bits == G.UserLocationInformationEUTRA.write(v, rem, bits2) : Ap.Bits()} & {rem2 == G.UserLocationInformationEUTRA.after(v, rem) : Nat}

def UserLocationInformationEUTRA.o_rt_timeStamp(m: Maybe<&2, G.TimeStamp()>, +r: Nat, +inner: Ap.Bits(), ok: {G.UserLocationInformationEUTRA.v_timeStamp(m) == True{} : Bool}) -> {G.UserLocationInformationEUTRA.o_timeStamp(Fr.Present(G.TimeStamp(), m), Ap.Cur{r, G.UserLocationInformationEUTRA.w_timeStamp(m, r, inner)}) == Done{(m, Ap.Cur{G.UserLocationInformationEUTRA.a_timeStamp(m, r), inner})} : Ap.Rd(Maybe<&2, G.TimeStamp()>)}:
  match m:
    case None{}:
      {==}
    case Some{+x}:
      e1 = Equal.sym(Ap.Rd(G.TimeStamp()), G.TimeStamp.read(Ap.Cur{r, G.TimeStamp.write(x, r, inner)}), Done{(x, Ap.Cur{G.TimeStamp.after(x, r), inner})}, GL.ngap.TimeStamp.roundtrip(x, r, inner, ok))
      %e1 : {G.UserLocationInformationEUTRA.s_timeStamp(_) == Done{(Some{x}, Ap.Cur{G.TimeStamp.after(x, r), inner})} : Ap.Rd(Maybe<&2, G.TimeStamp()>)}
      {==}

def UserLocationInformationEUTRA.o_dv_timeStamp.some(+c: Ap.Cur, r: Ap.Rd(G.TimeStamp()), +er: {G.TimeStamp.read(c) == r : Ap.Rd(G.TimeStamp())}, +m: Maybe<&2, G.TimeStamp()>, +c2: Ap.Cur, +e: {G.UserLocationInformationEUTRA.s_timeStamp(r) == Done{(m, c2)} : Ap.Rd(Maybe<&2, G.TimeStamp()>)}) -> {G.UserLocationInformationEUTRA.v_timeStamp(m) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(Maybe<&2, G.TimeStamp()>, {G.UserLocationInformationEUTRA.v_timeStamp(m) == True{} : Bool}, err, m, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, G.TimeStamp()>), Maybe<&2, G.TimeStamp()>, y => PA.Rd.value(Maybe<&2, G.TimeStamp()>, y, m), Done{(Some{x}, c3)}, Done{(m, c2)}, e)
      %ev : {G.UserLocationInformationEUTRA.v_timeStamp(_) == True{} : Bool}
      GL.ngap.TimeStamp.decode_valid(c, x, c3, er)

def UserLocationInformationEUTRA.o_dv_timeStamp(p: Bool, +c: Ap.Cur, +m: Maybe<&2, G.TimeStamp()>, +c2: Ap.Cur, +e: {G.UserLocationInformationEUTRA.o_timeStamp(p, c) == Done{(m, c2)} : Ap.Rd(Maybe<&2, G.TimeStamp()>)}) -> {G.UserLocationInformationEUTRA.v_timeStamp(m) == True{} : Bool}:
  match p:
    case False{}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, G.TimeStamp()>), Maybe<&2, G.TimeStamp()>, y => PA.Rd.value(Maybe<&2, G.TimeStamp()>, y, m), Done{(None{}, c)}, Done{(m, c2)}, e)
      %ev : {G.UserLocationInformationEUTRA.v_timeStamp(_) == True{} : Bool}
      {==}
    case True{}:
      UserLocationInformationEUTRA.o_dv_timeStamp.some(c, G.TimeStamp.read(c), {==}, m, c2, e)

def UserLocationInformationEUTRA.o_sx_timeStamp.go(+r: Nat, +b: Ap.Bits(), +x: G.TimeStamp(), +r4: Nat, +b4: Ap.Bits(), +m: Maybe<&2, G.TimeStamp()>, +r3: Nat, +b3: Ap.Bits(), +e: {Done{(Some{x}, Ap.Cur{r4, b4})} == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, G.TimeStamp()>)}, s: {b == G.TimeStamp.write(x, r, b4) : Ap.Bits()} & {r4 == G.TimeStamp.after(x, r) : Nat}) -> ({b == G.UserLocationInformationEUTRA.w_timeStamp(m, r, b3) : Ap.Bits()} & {r3 == G.UserLocationInformationEUTRA.a_timeStamp(m, r) : Nat}) & {True{} == Fr.Present(G.TimeStamp(), m) : Bool}:
  (s1, s2) = s
  ev = Equal.cong(Ap.Rd(Maybe<&2, G.TimeStamp()>), Maybe<&2, G.TimeStamp()>, y => PA.Rd.value(Maybe<&2, G.TimeStamp()>, y, m), Done{(Some{x}, Ap.Cur{r4, b4})}, Done{(m, Ap.Cur{r3, b3})}, e)
  +ec = Equal.cong(Ap.Rd(Maybe<&2, G.TimeStamp()>), Ap.Cur, y => PA.Rd.cur(Maybe<&2, G.TimeStamp()>, y, Ap.Cur{r3, b3}), Done{(Some{x}, Ap.Cur{r4, b4})}, Done{(m, Ap.Cur{r3, b3})}, e)
  eb = Equal.cong(Ap.Cur, Ap.Bits(), y => PA.Cur.bits(y), Ap.Cur{r4, b4}, Ap.Cur{r3, b3}, ec)
  er = Equal.cong(Ap.Cur, Nat, y => PA.Cur.rem(y), Ap.Cur{r4, b4}, Ap.Cur{r3, b3}, ec)
  %ev : ({b == G.UserLocationInformationEUTRA.w_timeStamp(_, r, b3) : Ap.Bits()} & {r3 == G.UserLocationInformationEUTRA.a_timeStamp(_, r) : Nat}) & {True{} == Fr.Present(G.TimeStamp(), _) : Bool}
  (((%eb : {b == G.TimeStamp.write(x, r, _) : Ap.Bits()}; s1), (%er : {_ == G.TimeStamp.after(x, r) : Nat}; s2)), {==})

def UserLocationInformationEUTRA.o_sx_timeStamp.some(+r: Nat, +b: Ap.Bits(), rd: Ap.Rd(G.TimeStamp()), +erd: {G.TimeStamp.read(Ap.Cur{r, b}) == rd : Ap.Rd(G.TimeStamp())}, +m: Maybe<&2, G.TimeStamp()>, +r3: Nat, +b3: Ap.Bits(), +e: {G.UserLocationInformationEUTRA.s_timeStamp(rd) == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, G.TimeStamp()>)}) -> ({b == G.UserLocationInformationEUTRA.w_timeStamp(m, r, b3) : Ap.Bits()} & {r3 == G.UserLocationInformationEUTRA.a_timeStamp(m, r) : Nat}) & {True{} == Fr.Present(G.TimeStamp(), m) : Bool}:
