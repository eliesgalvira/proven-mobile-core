      S_NSSAI.rt(sST, sD, iE_Extensions, rem, rest, ok)

def S_NSSAI.dv_iE_Extensions(+p_iE_Extensions: Bool, +sST: G.SST(), +sD: Maybe<&2, G.SD()>, +c: Ap.Cur, r: Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), +er: {G.S_NSSAI.o_iE_Extensions(p_iE_Extensions, c) == r : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}, +v: G.S_NSSAI, +c2: Ap.Cur, +e: {G.S_NSSAI.r_iE_Extensions(sST, sD, r) == Done{(v, c2)} : Ap.Rd(G.S_NSSAI)}, ok0: {G.SST.valid(sST) == True{} : Bool}, ok1: {G.S_NSSAI.v_sD(sD) == True{} : Bool}) -> {G.S_NSSAI.valid(v) == True{} : Bool}:
