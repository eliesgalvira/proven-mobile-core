def GlobalRANNodeID.sx_globalN3IWF_ID(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), rd: Ap.Rd(G.GlobalN3IWF_ID), +erd: {G.GlobalN3IWF_ID.read(Ap.Cur{r1, b1}) == rd : Ap.Rd(G.GlobalN3IWF_ID)}, +v: G.GlobalRANNodeID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GlobalRANNodeID.c_globalN3IWF_ID(rd) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GlobalRANNodeID)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 2n, 0n, 2n, r0, b1), r1, Ap.Size.after(False{}, 2n, r0))) -> GlobalRANNodeID.Sx(bits, v, rem, rem2, bits2):
