def SecurityResult.Sx(+bits: Ap.Bits(), +v: G.SecurityResult, +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
  {bits == G.SecurityResult.write(v, rem, bits2) : Ap.Bits()} & {rem2 == G.SecurityResult.after(v, rem) : Nat}

