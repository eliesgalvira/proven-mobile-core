      PA.Rd.absurd(G.TargetID, {G.TargetID.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.TargetID), G.TargetID, y => PA.Rd.value(G.TargetID, y, v), Done{(G.TargetID_choice_Extensions{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.TargetID.valid(_) == True{} : Bool}
      L.ngap.ie.decode_valid(c, x, c3, er)

def TargetID.dv_alt(i: Nat, +c: Ap.Cur, +v: G.TargetID, +c2: Ap.Cur, +e: {G.TargetID.alt(i, c) == Done{(v, c2)} : Ap.Rd(G.TargetID)}) -> {G.TargetID.valid(v) == True{} : Bool}:
  match i:
    case 0n:
      TargetID.dv_targetRANNodeID(c, G.TargetRANNodeID.read(c), {==}, v, c2, e)
    case 1n:
      TargetID.dv_targeteNB_ID(c, G.TargeteNB_ID.read(c), {==}, v, c2, e)
    case 2n:
      TargetID.dv_choice_Extensions(c, Fr.Ie.read(c), {==}, v, c2, e)
    case 3n+p:
      PA.Rd.absurd(G.TargetID, {G.TargetID.valid(v) == True{} : Bool}, B.Invalid{0}, v, c2, e)

def TargetID.dv_idx(r: Ap.Rd(Nat), +v: G.TargetID, +c2: Ap.Cur, +e: {G.TargetID.r_idx(r) == Done{(v, c2)} : Ap.Rd(G.TargetID)}) -> {G.TargetID.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.TargetID, {G.TargetID.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(i, c)}:
      TargetID.dv_alt(i, c, v, c2, e)

def GL.ngap.TargetID.decode_valid(c, v, c2, e):
  TargetID.dv_idx(Ap.Size.read(False{}, 2n, 0n, 2n, c), v, c2, e)

def TargetID.sx_targetRANNodeID.go(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), +x: G.TargetRANNodeID, +r3: Nat, +b3: Ap.Bits(), +v: G.TargetID, +rem2: Nat, +bits2: Ap.Bits(), +e: {Done{(G.TargetID_targetRANNodeID{x}, Ap.Cur{r3, b3})} == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.TargetID)}, pre: {bits == b0 : Ap.Bits()}, +pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 2n, 0n, 0n, r0, b1), r1, Ap.Size.after(False{}, 2n, r0)), s: {b1 == G.TargetRANNodeID.write(x, r1, b3) : Ap.Bits()} & {r3 == G.TargetRANNodeID.after(x, r1) : Nat}) -> TargetID.Sx(bits, v, rem, rem2, bits2):
  (ss1, +ss2) = ss
  (s1, s2) = s
  ev = Equal.cong(Ap.Rd(G.TargetID), G.TargetID, y => PA.Rd.value(G.TargetID, y, v), Done{(G.TargetID_targetRANNodeID{x}, Ap.Cur{r3, b3})}, Done{(v, Ap.Cur{rem2, bits2})}, e)
  +ec = Equal.cong(Ap.Rd(G.TargetID), Ap.Cur, y => PA.Rd.cur(G.TargetID, y, Ap.Cur{rem2, bits2}), Done{(G.TargetID_targetRANNodeID{x}, Ap.Cur{r3, b3})}, Done{(v, Ap.Cur{rem2, bits2})}, e)
  eb = Equal.cong(Ap.Cur, Ap.Bits(), x => PA.Cur.bits(x), Ap.Cur{r3, b3}, Ap.Cur{rem2, bits2}, ec)
  er = Equal.cong(Ap.Cur, Nat, x => PA.Cur.rem(x), Ap.Cur{r3, b3}, Ap.Cur{rem2, bits2}, ec)
