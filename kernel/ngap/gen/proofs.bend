      PA.Rd.absurd(G.Cause, Cause.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(+x, c3)}:
      match c3:
        case Ap.Cur{+r3, +b3}:
          Cause.sx_choice_Extensions.go(rem, bits, r0, b0, r1, b1, x, r3, b3, v, rem2, bits2, e, pre, pr, ss, PF.Ie.sx(r1, b1, x, r3, b3, erd))

def Cause.sx_alt(i: Nat, +rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), +v: G.Cause, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.Cause.alt(i, Ap.Cur{r1, b1}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.Cause)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 3n, 0n, i, r0, b1), r1, Ap.Size.after(False{}, 3n, r0))) -> Cause.Sx(bits, v, rem, rem2, bits2):
  match i:
    case 0n:
      Cause.sx_radioNetwork(rem, bits, r0, b0, r1, b1, G.CauseRadioNetwork.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 1n:
      Cause.sx_transport(rem, bits, r0, b0, r1, b1, G.CauseTransport.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 2n:
      Cause.sx_nas(rem, bits, r0, b0, r1, b1, G.CauseNas.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 3n:
      Cause.sx_protocol(rem, bits, r0, b0, r1, b1, G.CauseProtocol.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 4n:
      Cause.sx_misc(rem, bits, r0, b0, r1, b1, G.CauseMisc.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 5n:
      Cause.sx_choice_Extensions(rem, bits, r0, b0, r1, b1, Fr.Ie.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 6n+p:
      PA.Rd.absurd(G.Cause, Cause.Sx(bits, v, rem, rem2, bits2), B.Invalid{0}, v, Ap.Cur{rem2, bits2}, e)

def Cause.sx_idx(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Nat), +er: {Ap.Size.read(False{}, 3n, 0n, 5n, Ap.Cur{r0, b0}) == r : Ap.Rd(Nat)}, +v: G.Cause, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.Cause.r_idx(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.Cause)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}) -> Cause.Sx(bits, v, rem, rem2, bits2):
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.Cause, Cause.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(+i, c1)}:
      match c1:
        case Ap.Cur{+r1, +b1}:
          Cause.sx_alt(i, rem, bits, r0, b0, r1, b1, v, rem2, bits2, e, pre, pr, PC.Size.sx(False{}, 3n, 0n, 5n, r0, b0, i, r1, b1, er))

def GL.ngap.Cause.suffix(rem, bits, v, rem2, bits2, e):
  Cause.sx_idx(rem, bits, rem, bits, Ap.Size.read(False{}, 3n, 0n, 5n, Ap.Cur{rem, bits}), {==}, v, rem2, bits2, e, {==}, {==})

def InitialUEMessage.Sx(+bits: Ap.Bits(), +v: G.InitialUEMessage(), +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
  {bits == G.InitialUEMessage.write(v, rem, bits2) : Ap.Bits()} & {rem2 == G.InitialUEMessage.after(v, rem) : Nat}

def GL.ngap.InitialUEMessage.roundtrip(v, rem, rest, ok):
  L.ngap.ies.roundtrip(v, Ap.Bit.after(rem), rest, ok)

def InitialUEMessage.dv(rb: Ap.Rd(Bool), +v: G.InitialUEMessage(), +c2: Ap.Cur, +e: {G.InitialUEMessage.r_ext(rb) == Done{(v, c2)} : Ap.Rd(G.InitialUEMessage())}) -> {G.InitialUEMessage.valid(v) == True{} : Bool}:
  match rb:
    case Fail{err}:
      PA.Rd.absurd(G.InitialUEMessage(), {G.InitialUEMessage.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.InitialUEMessage(), {G.InitialUEMessage.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
          L.ngap.ies.decode_valid(c, v, c2, e)

def GL.ngap.InitialUEMessage.decode_valid(c, v, c2, e):
  InitialUEMessage.dv(Ap.Bit.read(c), v, c2, e)

def InitialUEMessage.sx.go(+rem: Nat, +rest: Ap.Bits(), +v: G.InitialUEMessage(), +rem2: Nat, +bits2: Ap.Bits(), s: PC.Canon(rest, Fr.Ies.write(v, Ap.Bit.after(rem), bits2), rem2, 0n)) -> InitialUEMessage.Sx(False{} <> rest, v, rem, rem2, bits2):
  (s1, s2) = s
  (Equal.cong(Ap.Bits(), Ap.Bits(), l => False{} <> l, rest, Fr.Ies.write(v, Ap.Bit.after(rem), bits2), s1), s2)

def InitialUEMessage.sx(+rem: Nat, bits: Ap.Bits(), +v: G.InitialUEMessage(), +rem2: Nat, +bits2: Ap.Bits(), +e: {G.InitialUEMessage.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.InitialUEMessage())}) -> InitialUEMessage.Sx(bits, v, rem, rem2, bits2):
  match bits:
    case Nil{}:
      PA.Rd.absurd(G.InitialUEMessage(), InitialUEMessage.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.InitialUEMessage(), InitialUEMessage.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          InitialUEMessage.sx.go(rem, rest, v, rem2, bits2, PF.Ies.sx(Ap.Bit.after(rem), rest, v, rem2, bits2, e))

def GL.ngap.InitialUEMessage.suffix(rem, bits, v, rem2, bits2, e):
  InitialUEMessage.sx(rem, bits, v, rem2, bits2, e)

