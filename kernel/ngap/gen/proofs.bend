def DRBStatusUL.dv_alt(i: Nat, +c: Ap.Cur, +v: G.DRBStatusUL, +c2: Ap.Cur, +e: {G.DRBStatusUL.alt(i, c) == Done{(v, c2)} : Ap.Rd(G.DRBStatusUL)}) -> {G.DRBStatusUL.valid(v) == True{} : Bool}:
  match i:
    case 0n:
      DRBStatusUL.dv_dRBStatusUL12(c, G.DRBStatusUL12.read(c), {==}, v, c2, e)
    case 1n:
      DRBStatusUL.dv_dRBStatusUL18(c, G.DRBStatusUL18.read(c), {==}, v, c2, e)
    case 2n:
      DRBStatusUL.dv_choice_Extensions(c, Fr.Ie.read(c), {==}, v, c2, e)
    case 3n+p:
      PA.Rd.absurd(G.DRBStatusUL, {G.DRBStatusUL.valid(v) == True{} : Bool}, B.Invalid{0}, v, c2, e)

def DRBStatusUL.dv_idx(r: Ap.Rd(Nat), +v: G.DRBStatusUL, +c2: Ap.Cur, +e: {G.DRBStatusUL.r_idx(r) == Done{(v, c2)} : Ap.Rd(G.DRBStatusUL)}) -> {G.DRBStatusUL.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.DRBStatusUL, {G.DRBStatusUL.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(i, c)}:
      DRBStatusUL.dv_alt(i, c, v, c2, e)

def GL.ngap.DRBStatusUL.decode_valid(c, v, c2, e):
  DRBStatusUL.dv_idx(Ap.Size.read(False{}, 2n, 0n, 2n, c), v, c2, e)

