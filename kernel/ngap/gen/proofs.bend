def GL.ngap.CellCAGList.roundtrip(v, rem, rest, ok):
  CellCAGList.rt(v, rem, rest, ok)

def CellCAGList.Spec(xs: List<&2, G.CAG_ID()>, n: Nat) -> Type:
  {G.CellCAGList.all_valid(xs) == True{} : Bool} & {List.length(&2, G.CAG_ID(), xs) == n : Nat}

def CellCAGList.spec.finish(+p: Nat, +x: G.CAG_ID(), +xs2: List<&2, G.CAG_ID()>, vi: {G.CAG_ID.valid(x) == True{} : Bool}, s: CellCAGList.Spec(xs2, p)) -> CellCAGList.Spec(x <> xs2, 1n+p):
