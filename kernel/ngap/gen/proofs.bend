def N3IWF_ID.Sx(+bits: Ap.Bits(), +v: G.N3IWF_ID, +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
  {bits == G.N3IWF_ID.write(v, rem, bits2) : Ap.Bits()} & {rem2 == G.N3IWF_ID.after(v, rem) : Nat}

