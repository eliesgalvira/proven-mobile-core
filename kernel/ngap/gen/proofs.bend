def SliceSupportItem.o_sx_iE_Extensions(p: Bool, +r: Nat, +b: Ap.Bits(), +m: Maybe<&2, List<&2, Fr.Ie>>, +r3: Nat, +b3: Ap.Bits(), +e: {G.SliceSupportItem.o_iE_Extensions(p, Ap.Cur{r, b}) == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}) -> ({b == G.SliceSupportItem.w_iE_Extensions(m, r, b3) : Ap.Bits()} & {r3 == G.SliceSupportItem.a_iE_Extensions(m, r) : Nat}) & {p == Fr.Present(List<&2, Fr.Ie>, m) : Bool}:
  match p:
    case False{}:
      ev = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Maybe<&2, List<&2, Fr.Ie>>, y => PA.Rd.value(Maybe<&2, List<&2, Fr.Ie>>, y, m), Done{(None{}, Ap.Cur{r, b})}, Done{(m, Ap.Cur{r3, b3})}, e)
      +ec = Equal.cong(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), Ap.Cur, y => PA.Rd.cur(Maybe<&2, List<&2, Fr.Ie>>, y, Ap.Cur{r3, b3}), Done{(None{}, Ap.Cur{r, b})}, Done{(m, Ap.Cur{r3, b3})}, e)
      %ev : ({b == G.SliceSupportItem.w_iE_Extensions(_, r, b3) : Ap.Bits()} & {r3 == G.SliceSupportItem.a_iE_Extensions(_, r) : Nat}) & {False{} == Fr.Present(List<&2, Fr.Ie>, _) : Bool}
      ((Equal.cong(Ap.Cur, Ap.Bits(), y => PA.Cur.bits(y), Ap.Cur{r, b}, Ap.Cur{r3, b3}, ec), Equal.sym(Nat, r, r3, Equal.cong(Ap.Cur, Nat, y => PA.Cur.rem(y), Ap.Cur{r, b}, Ap.Cur{r3, b3}, ec))), {==})
    case True{}:
      SliceSupportItem.o_sx_iE_Extensions.some(r, b, Fr.Exts.read(Ap.Cur{r, b}), {==}, m, r3, b3, e)

def SliceSupportItem.rt(+s_NSSAI: G.S_NSSAI, +iE_Extensions: Maybe<&2, List<&2, Fr.Ie>>, +rem: Nat, +rest: Ap.Bits(), +ok: {G.SliceSupportItem.valid(G.SliceSupportItem{s_NSSAI, iE_Extensions}) == True{} : Bool}) -> {G.SliceSupportItem.read(Ap.Cur{rem, G.SliceSupportItem.write(G.SliceSupportItem{s_NSSAI, iE_Extensions}, rem, rest)}) == Done{(G.SliceSupportItem{s_NSSAI, iE_Extensions}, Ap.Cur{G.SliceSupportItem.after(G.SliceSupportItem{s_NSSAI, iE_Extensions}, rem), rest})} : Ap.Rd(G.SliceSupportItem)}:
  ok0 = P.Bool.and_true_l(G.S_NSSAI.valid(s_NSSAI), G.SliceSupportItem.v_iE_Extensions(iE_Extensions), ok)
  +okr0 = P.Bool.and_true_r(G.S_NSSAI.valid(s_NSSAI), G.SliceSupportItem.v_iE_Extensions(iE_Extensions), ok)
  e0 = Equal.sym(Ap.Rd(G.S_NSSAI), G.S_NSSAI.read(Ap.Cur{Ap.Bits.after(1n, Ap.Bit.after(rem)), G.S_NSSAI.write(s_NSSAI, Ap.Bits.after(1n, Ap.Bit.after(rem)), G.SliceSupportItem.w_iE_Extensions(iE_Extensions, G.S_NSSAI.after(s_NSSAI, Ap.Bits.after(1n, Ap.Bit.after(rem))), rest))}), Done{(s_NSSAI, Ap.Cur{G.S_NSSAI.after(s_NSSAI, Ap.Bits.after(1n, Ap.Bit.after(rem))), G.SliceSupportItem.w_iE_Extensions(iE_Extensions, G.S_NSSAI.after(s_NSSAI, Ap.Bits.after(1n, Ap.Bit.after(rem))), rest)})}, GL.ngap.S_NSSAI.roundtrip(s_NSSAI, Ap.Bits.after(1n, Ap.Bit.after(rem)), G.SliceSupportItem.w_iE_Extensions(iE_Extensions, G.S_NSSAI.after(s_NSSAI, Ap.Bits.after(1n, Ap.Bit.after(rem))), rest), ok0))
  %e0 : {G.SliceSupportItem.r_s_NSSAI(Fr.Present(List<&2, Fr.Ie>, iE_Extensions), _) == Done{(G.SliceSupportItem{s_NSSAI, iE_Extensions}, Ap.Cur{G.SliceSupportItem.after(G.SliceSupportItem{s_NSSAI, iE_Extensions}, rem), rest})} : Ap.Rd(G.SliceSupportItem)}
  e1 = Equal.sym(Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), G.SliceSupportItem.o_iE_Extensions(Fr.Present(List<&2, Fr.Ie>, iE_Extensions), Ap.Cur{G.S_NSSAI.after(s_NSSAI, Ap.Bits.after(1n, Ap.Bit.after(rem))), G.SliceSupportItem.w_iE_Extensions(iE_Extensions, G.S_NSSAI.after(s_NSSAI, Ap.Bits.after(1n, Ap.Bit.after(rem))), rest)}), Done{(iE_Extensions, Ap.Cur{G.SliceSupportItem.a_iE_Extensions(iE_Extensions, G.S_NSSAI.after(s_NSSAI, Ap.Bits.after(1n, Ap.Bit.after(rem)))), rest})}, SliceSupportItem.o_rt_iE_Extensions(iE_Extensions, G.S_NSSAI.after(s_NSSAI, Ap.Bits.after(1n, Ap.Bit.after(rem))), rest, okr0))
  %e1 : {G.SliceSupportItem.r_iE_Extensions(s_NSSAI, _) == Done{(G.SliceSupportItem{s_NSSAI, iE_Extensions}, Ap.Cur{G.SliceSupportItem.after(G.SliceSupportItem{s_NSSAI, iE_Extensions}, rem), rest})} : Ap.Rd(G.SliceSupportItem)}
  {==}

def GL.ngap.SliceSupportItem.roundtrip(v, rem, rest, ok):
  match v:
    case G.SliceSupportItem{s_NSSAI, iE_Extensions}:
      SliceSupportItem.rt(s_NSSAI, iE_Extensions, rem, rest, ok)

def SliceSupportItem.dv_iE_Extensions(+p_iE_Extensions: Bool, +s_NSSAI: G.S_NSSAI, +c: Ap.Cur, r: Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), +er: {G.SliceSupportItem.o_iE_Extensions(p_iE_Extensions, c) == r : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}, +v: G.SliceSupportItem, +c2: Ap.Cur, +e: {G.SliceSupportItem.r_iE_Extensions(s_NSSAI, r) == Done{(v, c2)} : Ap.Rd(G.SliceSupportItem)}, ok0: {G.S_NSSAI.valid(s_NSSAI) == True{} : Bool}) -> {G.SliceSupportItem.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.SliceSupportItem, {G.SliceSupportItem.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+iE_Extensions, +c3)}:
      ev = Equal.cong(Ap.Rd(G.SliceSupportItem), G.SliceSupportItem, y => PA.Rd.value(G.SliceSupportItem, y, v), Done{(G.SliceSupportItem{s_NSSAI, iE_Extensions}, c3)}, Done{(v, c2)}, e)
      %ev : {G.SliceSupportItem.valid(_) == True{} : Bool}
      P.Bool.and_intro(G.S_NSSAI.valid(s_NSSAI), G.SliceSupportItem.v_iE_Extensions(iE_Extensions), ok0, SliceSupportItem.o_dv_iE_Extensions(p_iE_Extensions, c, iE_Extensions, c3, er))

def SliceSupportItem.dv_s_NSSAI(+p_iE_Extensions: Bool, +c: Ap.Cur, r: Ap.Rd(G.S_NSSAI), +er: {G.S_NSSAI.read(c) == r : Ap.Rd(G.S_NSSAI)}, +v: G.SliceSupportItem, +c2: Ap.Cur, +e: {G.SliceSupportItem.r_s_NSSAI(p_iE_Extensions, r) == Done{(v, c2)} : Ap.Rd(G.SliceSupportItem)}) -> {G.SliceSupportItem.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.SliceSupportItem, {G.SliceSupportItem.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+s_NSSAI, +c3)}:
      SliceSupportItem.dv_iE_Extensions(p_iE_Extensions, s_NSSAI, c3, G.SliceSupportItem.o_iE_Extensions(p_iE_Extensions, c3), {==}, v, c2, e, GL.ngap.S_NSSAI.decode_valid(c, s_NSSAI, c3, er))

def SliceSupportItem.dv_bm(r: Ap.Rd(Ap.Bits()), +v: G.SliceSupportItem, +c2: Ap.Cur, +e: {G.SliceSupportItem.r_bm(r) == Done{(v, c2)} : Ap.Rd(G.SliceSupportItem)}) -> {G.SliceSupportItem.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.SliceSupportItem, {G.SliceSupportItem.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(bm, +c3)}:
      match bm:
        case p_iE_Extensions <> Nil{}:
          SliceSupportItem.dv_s_NSSAI(p_iE_Extensions, c3, G.S_NSSAI.read(c3), {==}, v, c2, e)
        case Nil{}:
          PA.Rd.absurd(G.SliceSupportItem, {G.SliceSupportItem.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)
