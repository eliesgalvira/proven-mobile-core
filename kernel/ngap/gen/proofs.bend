    case Done{(bm, c1)}:
      match bm:
        case +p_iE_Extensions <> Nil{}:
          match c1:
            case Ap.Cur{+r1, +b1}:
              GUAMI.sx_bm.go(rem, bits, r0, b0, p_iE_Extensions, r1, b1, v, rem2, bits2, e, pre, pr, PC.Bits.sx(1n, r0, b0, [p_iE_Extensions], r1, b1, er))
        case Nil{}:
          PA.Rd.absurd(G.GUAMI, GUAMI.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
        case q0 <> q1 <> more:
          PA.Rd.absurd(G.GUAMI, GUAMI.Sx(bits, v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)

def GUAMI.sx(+rem: Nat, bits: Ap.Bits(), +v: G.GUAMI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GUAMI.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GUAMI)}) -> GUAMI.Sx(bits, v, rem, rem2, bits2):
  match bits:
    case Nil{}:
