    case Fail{err}:
      PA.Rd.absurd(G.SecurityResult, {G.SecurityResult.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, +c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.SecurityResult, {G.SecurityResult.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
          SecurityResult.dv_bm(Ap.Bits.read(1n, c), v, c2, e)

def GL.ngap.SecurityResult.decode_valid(c, v, c2, e):
  SecurityResult.dv_ext(Ap.Bit.read(c), v, c2, e)

