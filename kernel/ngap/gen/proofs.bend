def TargetID.dv_choice_Extensions(+c: Ap.Cur, r: Ap.Rd(Fr.Ie), +er: {Fr.Ie.read(c) == r : Ap.Rd(Fr.Ie)}, +v: G.TargetID, +c2: Ap.Cur, +e: {G.TargetID.c_choice_Extensions(r) == Done{(v, c2)} : Ap.Rd(G.TargetID)}) -> {G.TargetID.valid(v) == True{} : Bool}:
