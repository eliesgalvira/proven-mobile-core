def Cause.sx_choice_Extensions(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), rd: Ap.Rd(Fr.Ie), +erd: {Fr.Ie.read(Ap.Cur{r1, b1}) == rd : Ap.Rd(Fr.Ie)}, +v: G.Cause, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.Cause.c_choice_Extensions(rd) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.Cause)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 3n, 0n, 5n, r0, b1), r1, Ap.Size.after(False{}, 3n, r0))) -> Cause.Sx(bits, v, rem, rem2, bits2):
