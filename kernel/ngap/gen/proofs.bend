def UESecurityCapabilities.dv_bm(r: Ap.Rd(Ap.Bits()), +v: G.UESecurityCapabilities, +c2: Ap.Cur, +e: {G.UESecurityCapabilities.r_bm(r) == Done{(v, c2)} : Ap.Rd(G.UESecurityCapabilities)}) -> {G.UESecurityCapabilities.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.UESecurityCapabilities, {G.UESecurityCapabilities.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(bm, +c3)}:
      match bm:
        case p_iE_Extensions <> Nil{}:
          UESecurityCapabilities.dv_nRencryptionAlgorithms(p_iE_Extensions, c3, G.NRencryptionAlgorithms.read(c3), {==}, v, c2, e)
        case Nil{}:
          PA.Rd.absurd(G.UESecurityCapabilities, {G.UESecurityCapabilities.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)
        case q0 <> q1 <> more:
          PA.Rd.absurd(G.UESecurityCapabilities, {G.UESecurityCapabilities.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)

def UESecurityCapabilities.dv_ext(rb: Ap.Rd(Bool), +v: G.UESecurityCapabilities, +c2: Ap.Cur, +e: {G.UESecurityCapabilities.r_ext(rb) == Done{(v, c2)} : Ap.Rd(G.UESecurityCapabilities)}) -> {G.UESecurityCapabilities.valid(v) == True{} : Bool}:
  match rb:
    case Fail{err}:
      PA.Rd.absurd(G.UESecurityCapabilities, {G.UESecurityCapabilities.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, +c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.UESecurityCapabilities, {G.UESecurityCapabilities.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
          UESecurityCapabilities.dv_bm(Ap.Bits.read(1n, c), v, c2, e)

def GL.ngap.UESecurityCapabilities.decode_valid(c, v, c2, e):
  UESecurityCapabilities.dv_ext(Ap.Bit.read(c), v, c2, e)

