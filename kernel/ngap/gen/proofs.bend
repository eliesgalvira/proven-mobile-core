def InitialContextSetupRequest.dv(rb: Ap.Rd(Bool), +v: G.InitialContextSetupRequest(), +c2: Ap.Cur, +e: {G.InitialContextSetupRequest.r_ext(rb) == Done{(v, c2)} : Ap.Rd(G.InitialContextSetupRequest())}) -> {G.InitialContextSetupRequest.valid(v) == True{} : Bool}:
