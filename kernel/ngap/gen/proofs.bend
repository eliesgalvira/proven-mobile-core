def TargeteNB_ID.sx(+rem: Nat, bits: Ap.Bits(), +v: G.TargeteNB_ID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.TargeteNB_ID.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.TargeteNB_ID)}) -> TargeteNB_ID.Sx(bits, v, rem, rem2, bits2):
