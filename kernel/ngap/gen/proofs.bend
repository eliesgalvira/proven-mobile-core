def EPS_TAI.dv_bm(r: Ap.Rd(Ap.Bits()), +v: G.EPS_TAI, +c2: Ap.Cur, +e: {G.EPS_TAI.r_bm(r) == Done{(v, c2)} : Ap.Rd(G.EPS_TAI)}) -> {G.EPS_TAI.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.EPS_TAI, {G.EPS_TAI.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(bm, +c3)}:
      match bm:
        case p_iE_Extensions <> Nil{}:
          EPS_TAI.dv_pLMNIdentity(p_iE_Extensions, c3, G.PLMNIdentity.read(c3), {==}, v, c2, e)
        case Nil{}:
          PA.Rd.absurd(G.EPS_TAI, {G.EPS_TAI.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)
        case q0 <> q1 <> more:
          PA.Rd.absurd(G.EPS_TAI, {G.EPS_TAI.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)

def EPS_TAI.dv_ext(rb: Ap.Rd(Bool), +v: G.EPS_TAI, +c2: Ap.Cur, +e: {G.EPS_TAI.r_ext(rb) == Done{(v, c2)} : Ap.Rd(G.EPS_TAI)}) -> {G.EPS_TAI.valid(v) == True{} : Bool}:
  match rb:
    case Fail{err}:
      PA.Rd.absurd(G.EPS_TAI, {G.EPS_TAI.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, +c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.EPS_TAI, {G.EPS_TAI.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
          EPS_TAI.dv_bm(Ap.Bits.read(1n, c), v, c2, e)

def GL.ngap.EPS_TAI.decode_valid(c, v, c2, e):
  EPS_TAI.dv_ext(Ap.Bit.read(c), v, c2, e)

