def NgENB_ID.dv_alt(i: Nat, +c: Ap.Cur, +v: G.NgENB_ID, +c2: Ap.Cur, +e: {G.NgENB_ID.alt(i, c) == Done{(v, c2)} : Ap.Rd(G.NgENB_ID)}) -> {G.NgENB_ID.valid(v) == True{} : Bool}:
  match i:
    case 0n:
      NgENB_ID.dv_macroNgENB_ID(c, G.NgENB_ID_macroNgENB_ID.read(c), {==}, v, c2, e)
    case 1n:
      NgENB_ID.dv_shortMacroNgENB_ID(c, G.NgENB_ID_shortMacroNgENB_ID.read(c), {==}, v, c2, e)
    case 2n:
      NgENB_ID.dv_longMacroNgENB_ID(c, G.NgENB_ID_longMacroNgENB_ID.read(c), {==}, v, c2, e)
    case 3n:
      NgENB_ID.dv_choice_Extensions(c, Fr.Ie.read(c), {==}, v, c2, e)
    case 4n+p:
      PA.Rd.absurd(G.NgENB_ID, {G.NgENB_ID.valid(v) == True{} : Bool}, B.Invalid{0}, v, c2, e)

