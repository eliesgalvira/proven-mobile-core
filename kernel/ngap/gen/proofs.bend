def GL.ngap.TargetID.roundtrip(v, rem, rest, ok):
  match v:
    case G.TargetID_targetRANNodeID{x}:
      TargetID.rt_targetRANNodeID(x, rem, rest, ok)
    case G.TargetID_targeteNB_ID{x}:
      TargetID.rt_targeteNB_ID(x, rem, rest, ok)
    case G.TargetID_choice_Extensions{x}:
      TargetID.rt_choice_Extensions(x, rem, rest, ok)

def TargetID.dv_targetRANNodeID(+c: Ap.Cur, r: Ap.Rd(G.TargetRANNodeID), +er: {G.TargetRANNodeID.read(c) == r : Ap.Rd(G.TargetRANNodeID)}, +v: G.TargetID, +c2: Ap.Cur, +e: {G.TargetID.c_targetRANNodeID(r) == Done{(v, c2)} : Ap.Rd(G.TargetID)}) -> {G.TargetID.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.TargetID, {G.TargetID.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.TargetID), G.TargetID, y => PA.Rd.value(G.TargetID, y, v), Done{(G.TargetID_targetRANNodeID{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.TargetID.valid(_) == True{} : Bool}
      GL.ngap.TargetRANNodeID.decode_valid(c, x, c3, er)

def TargetID.dv_targeteNB_ID(+c: Ap.Cur, r: Ap.Rd(G.TargeteNB_ID), +er: {G.TargeteNB_ID.read(c) == r : Ap.Rd(G.TargeteNB_ID)}, +v: G.TargetID, +c2: Ap.Cur, +e: {G.TargetID.c_targeteNB_ID(r) == Done{(v, c2)} : Ap.Rd(G.TargetID)}) -> {G.TargetID.valid(v) == True{} : Bool}:
