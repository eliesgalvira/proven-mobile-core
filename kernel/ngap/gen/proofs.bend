def S_NSSAI.dv_bm(r: Ap.Rd(Ap.Bits()), +v: G.S_NSSAI, +c2: Ap.Cur, +e: {G.S_NSSAI.r_bm(r) == Done{(v, c2)} : Ap.Rd(G.S_NSSAI)}) -> {G.S_NSSAI.valid(v) == True{} : Bool}:
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.S_NSSAI, {G.S_NSSAI.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(bm, +c3)}:
      match bm:
        case p_sD <> p_iE_Extensions <> Nil{}:
          S_NSSAI.dv_sST(p_sD, p_iE_Extensions, c3, G.SST.read(c3), {==}, v, c2, e)
        case Nil{}:
          PA.Rd.absurd(G.S_NSSAI, {G.S_NSSAI.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)
        case q0 <> Nil{}:
          PA.Rd.absurd(G.S_NSSAI, {G.S_NSSAI.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)
        case q0 <> q1 <> q2 <> more:
          PA.Rd.absurd(G.S_NSSAI, {G.S_NSSAI.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)

def S_NSSAI.dv_ext(rb: Ap.Rd(Bool), +v: G.S_NSSAI, +c2: Ap.Cur, +e: {G.S_NSSAI.r_ext(rb) == Done{(v, c2)} : Ap.Rd(G.S_NSSAI)}) -> {G.S_NSSAI.valid(v) == True{} : Bool}:
  match rb:
    case Fail{err}:
      PA.Rd.absurd(G.S_NSSAI, {G.S_NSSAI.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, +c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.S_NSSAI, {G.S_NSSAI.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
          S_NSSAI.dv_bm(Ap.Bits.read(2n, c), v, c2, e)

def GL.ngap.S_NSSAI.decode_valid(c, v, c2, e):
  S_NSSAI.dv_ext(Ap.Bit.read(c), v, c2, e)

