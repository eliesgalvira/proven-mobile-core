def GlobalRANNodeID.rt_choice_Extensions(+x: Fr.Ie, +rem: Nat, +rest: Ap.Bits(), +ok: {Fr.Ie.valid(x) == True{} : Bool}) -> {G.GlobalRANNodeID.read(Ap.Cur{rem, G.GlobalRANNodeID.write(G.GlobalRANNodeID_choice_Extensions{x}, rem, rest)}) == Done{(G.GlobalRANNodeID_choice_Extensions{x}, Ap.Cur{G.GlobalRANNodeID.after(G.GlobalRANNodeID_choice_Extensions{x}, rem), rest})} : Ap.Rd(G.GlobalRANNodeID)}:
  e1 = Equal.sym(Ap.Rd(Nat), Ap.Size.read(False{}, 2n, 0n, 3n, Ap.Cur{rem, Ap.Size.write(False{}, 2n, 0n, 3n, rem, Fr.Ie.write(x, Ap.Size.after(False{}, 2n, rem), rest))}), Done{(3n, Ap.Cur{Ap.Size.after(False{}, 2n, rem), Fr.Ie.write(x, Ap.Size.after(False{}, 2n, rem), rest)})}, L.aper.size.roundtrip(False{}, 2n, 0n, 3n, 3n, rem, Fr.Ie.write(x, Ap.Size.after(False{}, 2n, rem), rest), {==}, {==}))
  %e1 : {G.GlobalRANNodeID.r_idx(_) == Done{(G.GlobalRANNodeID_choice_Extensions{x}, Ap.Cur{G.GlobalRANNodeID.after(G.GlobalRANNodeID_choice_Extensions{x}, rem), rest})} : Ap.Rd(G.GlobalRANNodeID)}
  e2 = Equal.sym(Ap.Rd(Fr.Ie), Fr.Ie.read(Ap.Cur{Ap.Size.after(False{}, 2n, rem), Fr.Ie.write(x, Ap.Size.after(False{}, 2n, rem), rest)}), Done{(x, Ap.Cur{Fr.Ie.after(Ap.Size.after(False{}, 2n, rem)), rest})}, L.ngap.ie.roundtrip(x, Ap.Size.after(False{}, 2n, rem), rest, ok))
