def GNB_ID.sx_choice_Extensions(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), rd: Ap.Rd(Fr.Ie), +erd: {Fr.Ie.read(Ap.Cur{r1, b1}) == rd : Ap.Rd(Fr.Ie)}, +v: G.GNB_ID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.GNB_ID.c_choice_Extensions(rd) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.GNB_ID)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 1n, 0n, 1n, r0, b1), r1, Ap.Size.after(False{}, 1n, r0))) -> GNB_ID.Sx(bits, v, rem, rem2, bits2):
