def UPTransportLayerInformation.dv_choice_Extensions(+c: Ap.Cur, r: Ap.Rd(Fr.Ie), +er: {Fr.Ie.read(c) == r : Ap.Rd(Fr.Ie)}, +v: G.UPTransportLayerInformation, +c2: Ap.Cur, +e: {G.UPTransportLayerInformation.c_choice_Extensions(r) == Done{(v, c2)} : Ap.Rd(G.UPTransportLayerInformation)}) -> {G.UPTransportLayerInformation.valid(v) == True{} : Bool}:
