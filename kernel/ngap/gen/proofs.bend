def DRBStatusDL.dv_alt(i: Nat, +c: Ap.Cur, +v: G.DRBStatusDL, +c2: Ap.Cur, +e: {G.DRBStatusDL.alt(i, c) == Done{(v, c2)} : Ap.Rd(G.DRBStatusDL)}) -> {G.DRBStatusDL.valid(v) == True{} : Bool}:
  match i:
    case 0n:
      DRBStatusDL.dv_dRBStatusDL12(c, G.DRBStatusDL12.read(c), {==}, v, c2, e)
    case 1n:
      DRBStatusDL.dv_dRBStatusDL18(c, G.DRBStatusDL18.read(c), {==}, v, c2, e)
    case 2n:
      DRBStatusDL.dv_choice_Extensions(c, Fr.Ie.read(c), {==}, v, c2, e)
    case 3n+p:
      PA.Rd.absurd(G.DRBStatusDL, {G.DRBStatusDL.valid(v) == True{} : Bool}, B.Invalid{0}, v, c2, e)

