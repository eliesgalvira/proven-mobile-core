def TAI.sx_pLMNIdentity(+p_iE_Extensions: Bool, +rem: Nat, +bits: Ap.Bits(), +ri: Nat, +bi: Ap.Bits(), r: Ap.Rd(G.PLMNIdentity()), +er: {G.PLMNIdentity.read(Ap.Cur{ri, bi}) == r : Ap.Rd(G.PLMNIdentity())}, +v: G.TAI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.TAI.r_pLMNIdentity(p_iE_Extensions, r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.TAI)}, pre: {bits == Ap.Bit.write(False{}, rem, Ap.Bits.write([p_iE_Extensions], Ap.Bit.after(rem), bi)) : Ap.Bits()}, pr: {ri == Ap.Bits.after(1n, Ap.Bit.after(rem)) : Nat}) -> TAI.Sx(bits, v, rem, rem2, bits2):
