def TAI.sx_iE_Extensions(+p_iE_Extensions: Bool, +pLMNIdentity: G.PLMNIdentity(), +tAC: G.TAC(), +rem: Nat, +bits: Ap.Bits(), +ri: Nat, +bi: Ap.Bits(), r: Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>), +er: {G.TAI.o_iE_Extensions(p_iE_Extensions, Ap.Cur{ri, bi}) == r : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}, +v: G.TAI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.TAI.r_iE_Extensions(pLMNIdentity, tAC, r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.TAI)}, pre: {bits == Ap.Bit.write(False{}, rem, Ap.Bits.write([p_iE_Extensions], Ap.Bit.after(rem), G.PLMNIdentity.write(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)), G.TAC.write(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem))), bi)))) : Ap.Bits()}, pr: {ri == G.TAC.after(tAC, G.PLMNIdentity.after(pLMNIdentity, Ap.Bits.after(1n, Ap.Bit.after(rem)))) : Nat}) -> TAI.Sx(bits, v, rem, rem2, bits2):
