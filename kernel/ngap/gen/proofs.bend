def GL.ngap.SecurityResult.roundtrip(v, rem, rest, ok):
  match v:
    case G.SecurityResult{integrityProtectionResult, confidentialityProtectionResult, iE_Extensions}:
      SecurityResult.rt(integrityProtectionResult, confidentialityProtectionResult, iE_Extensions, rem, rest, ok)

