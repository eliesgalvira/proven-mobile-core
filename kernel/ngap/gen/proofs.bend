def NonDynamic5QIDescriptor.sx_bm(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Ap.Bits()), +er: {Ap.Bits.read(4n, Ap.Cur{r0, b0}) == r : Ap.Rd(Ap.Bits())}, +v: G.NonDynamic5QIDescriptor, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.NonDynamic5QIDescriptor.r_bm(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.NonDynamic5QIDescriptor)}, pre: {bits == Ap.Bit.write(False{}, rem, b0) : Ap.Bits()}, pr: {r0 == Ap.Bit.after(rem) : Nat}) -> NonDynamic5QIDescriptor.Sx(bits, v, rem, rem2, bits2):
