    case Fail{err}:
      PA.Rd.absurd(G.Cause, {G.Cause.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(+x, +c3)}:
      ev = Equal.cong(Ap.Rd(G.Cause), G.Cause, y => PA.Rd.value(G.Cause, y, v), Done{(G.Cause_radioNetwork{x}, c3)}, Done{(v, c2)}, e)
      %ev : {G.Cause.valid(_) == True{} : Bool}
      GL.ngap.CauseRadioNetwork.decode_valid(c, x, c3, er)

