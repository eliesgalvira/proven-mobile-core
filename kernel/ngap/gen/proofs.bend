    case Fail{err}:
      PA.Rd.absurd(G.DRBStatusDL, {G.DRBStatusDL.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(i, c)}:
      DRBStatusDL.dv_alt(i, c, v, c2, e)

