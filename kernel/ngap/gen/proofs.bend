def NR_CGI.o_rt_iE_Extensions(m: Maybe<&2, List<&2, Fr.Ie>>, +r: Nat, +inner: Ap.Bits(), ok: {G.NR_CGI.v_iE_Extensions(m) == True{} : Bool}) -> {G.NR_CGI.o_iE_Extensions(Fr.Present(List<&2, Fr.Ie>, m), Ap.Cur{r, G.NR_CGI.w_iE_Extensions(m, r, inner)}) == Done{(m, Ap.Cur{G.NR_CGI.a_iE_Extensions(m, r), inner})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}:
