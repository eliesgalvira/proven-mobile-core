  match bits:
    case Nil{}:
      PA.Rd.absurd(G.GTPTunnel, GTPTunnel.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.GTPTunnel, GTPTunnel.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
