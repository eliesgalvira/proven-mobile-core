  eb = Equal.cong(Ap.Cur, Ap.Bits(), y => PA.Cur.bits(y), Ap.Cur{r4, b4}, Ap.Cur{r3, b3}, ec)
  er = Equal.cong(Ap.Cur, Nat, y => PA.Cur.rem(y), Ap.Cur{r4, b4}, Ap.Cur{r3, b3}, ec)
  %ev : ({b == G.SliceSupportItem.w_iE_Extensions(_, r, b3) : Ap.Bits()} & {r3 == G.SliceSupportItem.a_iE_Extensions(_, r) : Nat}) & {True{} == Fr.Present(List<&2, Fr.Ie>, _) : Bool}
  (((%eb : {b == Fr.Exts.write(x, r, _) : Ap.Bits()}; s1), (%er : {_ == Fr.Exts.after(r) : Nat}; s2)), {==})

def SliceSupportItem.o_sx_iE_Extensions.some(+r: Nat, +b: Ap.Bits(), rd: Ap.Rd(List<&2, Fr.Ie>), +erd: {Fr.Exts.read(Ap.Cur{r, b}) == rd : Ap.Rd(List<&2, Fr.Ie>)}, +m: Maybe<&2, List<&2, Fr.Ie>>, +r3: Nat, +b3: Ap.Bits(), +e: {G.SliceSupportItem.s_iE_Extensions(rd) == Done{(m, Ap.Cur{r3, b3})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}) -> ({b == G.SliceSupportItem.w_iE_Extensions(m, r, b3) : Ap.Bits()} & {r3 == G.SliceSupportItem.a_iE_Extensions(m, r) : Nat}) & {True{} == Fr.Present(List<&2, Fr.Ie>, m) : Bool}:
