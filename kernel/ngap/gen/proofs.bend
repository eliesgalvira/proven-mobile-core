def GL.ngap.Cause.roundtrip(v, rem, rest, ok):
  match v:
    case G.Cause_radioNetwork{x}:
      Cause.rt_radioNetwork(x, rem, rest, ok)
    case G.Cause_transport{x}:
      Cause.rt_transport(x, rem, rest, ok)
    case G.Cause_nas{x}:
      Cause.rt_nas(x, rem, rest, ok)
    case G.Cause_protocol{x}:
      Cause.rt_protocol(x, rem, rest, ok)
    case G.Cause_misc{x}:
      Cause.rt_misc(x, rem, rest, ok)
    case G.Cause_choice_Extensions{x}:
      Cause.rt_choice_Extensions(x, rem, rest, ok)

