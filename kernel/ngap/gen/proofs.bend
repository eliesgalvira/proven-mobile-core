def UserLocationInformation.sx_alt(i: Nat, +rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), +v: G.UserLocationInformation, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.UserLocationInformation.alt(i, Ap.Cur{r1, b1}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.UserLocationInformation)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 2n, 0n, i, r0, b1), r1, Ap.Size.after(False{}, 2n, r0))) -> UserLocationInformation.Sx(bits, v, rem, rem2, bits2):
