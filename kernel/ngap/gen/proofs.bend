def EPS_TAI.dv_pLMNIdentity(+p_iE_Extensions: Bool, +c: Ap.Cur, r: Ap.Rd(G.PLMNIdentity()), +er: {G.PLMNIdentity.read(c) == r : Ap.Rd(G.PLMNIdentity())}, +v: G.EPS_TAI, +c2: Ap.Cur, +e: {G.EPS_TAI.r_pLMNIdentity(p_iE_Extensions, r) == Done{(v, c2)} : Ap.Rd(G.EPS_TAI)}) -> {G.EPS_TAI.valid(v) == True{} : Bool}:
  match r:
