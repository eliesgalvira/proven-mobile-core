    case Done{(+iE_Extensions, +c3)}:
      ev = Equal.cong(Ap.Rd(G.S_NSSAI), G.S_NSSAI, y => PA.Rd.value(G.S_NSSAI, y, v), Done{(G.S_NSSAI{sST, sD, iE_Extensions}, c3)}, Done{(v, c2)}, e)
