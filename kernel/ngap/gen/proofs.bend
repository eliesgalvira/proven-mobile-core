def NgENB_ID.sx_choice_Extensions(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), rd: Ap.Rd(Fr.Ie), +erd: {Fr.Ie.read(Ap.Cur{r1, b1}) == rd : Ap.Rd(Fr.Ie)}, +v: G.NgENB_ID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.NgENB_ID.c_choice_Extensions(rd) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.NgENB_ID)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 2n, 0n, 3n, r0, b1), r1, Ap.Size.after(False{}, 2n, r0))) -> NgENB_ID.Sx(bits, v, rem, rem2, bits2):
  match rd:
    case Fail{err}:
      PA.Rd.absurd(G.NgENB_ID, NgENB_ID.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(+x, c3)}:
      match c3:
        case Ap.Cur{+r3, +b3}:
          NgENB_ID.sx_choice_Extensions.go(rem, bits, r0, b0, r1, b1, x, r3, b3, v, rem2, bits2, e, pre, pr, ss, PF.Ie.sx(r1, b1, x, r3, b3, erd))

def NgENB_ID.sx_alt(i: Nat, +rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), +r1: Nat, +b1: Ap.Bits(), +v: G.NgENB_ID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.NgENB_ID.alt(i, Ap.Cur{r1, b1}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.NgENB_ID)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}, ss: PC.Canon(b0, Ap.Size.write(False{}, 2n, 0n, i, r0, b1), r1, Ap.Size.after(False{}, 2n, r0))) -> NgENB_ID.Sx(bits, v, rem, rem2, bits2):
  match i:
    case 0n:
      NgENB_ID.sx_macroNgENB_ID(rem, bits, r0, b0, r1, b1, G.NgENB_ID_macroNgENB_ID.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 1n:
      NgENB_ID.sx_shortMacroNgENB_ID(rem, bits, r0, b0, r1, b1, G.NgENB_ID_shortMacroNgENB_ID.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 2n:
      NgENB_ID.sx_longMacroNgENB_ID(rem, bits, r0, b0, r1, b1, G.NgENB_ID_longMacroNgENB_ID.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 3n:
      NgENB_ID.sx_choice_Extensions(rem, bits, r0, b0, r1, b1, Fr.Ie.read(Ap.Cur{r1, b1}), {==}, v, rem2, bits2, e, pre, pr, ss)
    case 4n+p:
      PA.Rd.absurd(G.NgENB_ID, NgENB_ID.Sx(bits, v, rem, rem2, bits2), B.Invalid{0}, v, Ap.Cur{rem2, bits2}, e)

def NgENB_ID.sx_idx(+rem: Nat, +bits: Ap.Bits(), +r0: Nat, +b0: Ap.Bits(), r: Ap.Rd(Nat), +er: {Ap.Size.read(False{}, 2n, 0n, 3n, Ap.Cur{r0, b0}) == r : Ap.Rd(Nat)}, +v: G.NgENB_ID, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.NgENB_ID.r_idx(r) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.NgENB_ID)}, pre: {bits == b0 : Ap.Bits()}, pr: {r0 == rem : Nat}) -> NgENB_ID.Sx(bits, v, rem, rem2, bits2):
  match r:
    case Fail{err}:
      PA.Rd.absurd(G.NgENB_ID, NgENB_ID.Sx(bits, v, rem, rem2, bits2), err, v, Ap.Cur{rem2, bits2}, e)
    case Done{(+i, c1)}:
      match c1:
        case Ap.Cur{+r1, +b1}:
          NgENB_ID.sx_alt(i, rem, bits, r0, b0, r1, b1, v, rem2, bits2, e, pre, pr, PC.Size.sx(False{}, 2n, 0n, 3n, r0, b0, i, r1, b1, er))

def GL.ngap.NgENB_ID.suffix(rem, bits, v, rem2, bits2, e):
  NgENB_ID.sx_idx(rem, bits, rem, bits, Ap.Size.read(False{}, 2n, 0n, 3n, Ap.Cur{rem, bits}), {==}, v, rem2, bits2, e, {==}, {==})

def GlobalNgENB_ID.Sx(+bits: Ap.Bits(), +v: G.GlobalNgENB_ID, +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
  {bits == G.GlobalNgENB_ID.write(v, rem, bits2) : Ap.Bits()} & {rem2 == G.GlobalNgENB_ID.after(v, rem) : Nat}

def GlobalNgENB_ID.o_rt_iE_Extensions(m: Maybe<&2, List<&2, Fr.Ie>>, +r: Nat, +inner: Ap.Bits(), ok: {G.GlobalNgENB_ID.v_iE_Extensions(m) == True{} : Bool}) -> {G.GlobalNgENB_ID.o_iE_Extensions(Fr.Present(List<&2, Fr.Ie>, m), Ap.Cur{r, G.GlobalNgENB_ID.w_iE_Extensions(m, r, inner)}) == Done{(m, Ap.Cur{G.GlobalNgENB_ID.a_iE_Extensions(m, r), inner})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}:
  match m:
    case None{}:
      {==}
    case Some{+x}:
      e1 = Equal.sym(Ap.Rd(List<&2, Fr.Ie>), Fr.Exts.read(Ap.Cur{r, Fr.Exts.write(x, r, inner)}), Done{(x, Ap.Cur{Fr.Exts.after(r), inner})}, L.ngap.exts.roundtrip(x, r, inner, ok))
      %e1 : {G.GlobalNgENB_ID.s_iE_Extensions(_) == Done{(Some{x}, Ap.Cur{Fr.Exts.after(r), inner})} : Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>)}
