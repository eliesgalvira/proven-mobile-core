def SecurityResult.dv_integrityProtectionResult(+p_iE_Extensions: Bool, +c: Ap.Cur, r: Ap.Rd(G.IntegrityProtectionResult()), +er: {G.IntegrityProtectionResult.read(c) == r : Ap.Rd(G.IntegrityProtectionResult())}, +v: G.SecurityResult, +c2: Ap.Cur, +e: {G.SecurityResult.r_integrityProtectionResult(p_iE_Extensions, r) == Done{(v, c2)} : Ap.Rd(G.SecurityResult)}) -> {G.SecurityResult.valid(v) == True{} : Bool}:
