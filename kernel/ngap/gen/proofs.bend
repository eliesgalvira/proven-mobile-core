def GL.ngap.DRBStatusUL18.suffix(rem, bits, v, rem2, bits2, e):
  DRBStatusUL18.sx(rem, bits, v, rem2, bits2, e)

def DRBStatusUL.Sx(+bits: Ap.Bits(), +v: G.DRBStatusUL, +rem: Nat, rem2: Nat, bits2: Ap.Bits()) -> Type:
  {bits == G.DRBStatusUL.write(v, rem, bits2) : Ap.Bits()} & {rem2 == G.DRBStatusUL.after(v, rem) : Nat}

