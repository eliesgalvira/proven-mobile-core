def UPTransportLayerInformation.dv_alt(i: Nat, +c: Ap.Cur, +v: G.UPTransportLayerInformation, +c2: Ap.Cur, +e: {G.UPTransportLayerInformation.alt(i, c) == Done{(v, c2)} : Ap.Rd(G.UPTransportLayerInformation)}) -> {G.UPTransportLayerInformation.valid(v) == True{} : Bool}:
  match i:
    case 0n:
      UPTransportLayerInformation.dv_gTPTunnel(c, G.GTPTunnel.read(c), {==}, v, c2, e)
    case 1n:
      UPTransportLayerInformation.dv_choice_Extensions(c, Fr.Ie.read(c), {==}, v, c2, e)
    case 2n+p:
      PA.Rd.absurd(G.UPTransportLayerInformation, {G.UPTransportLayerInformation.valid(v) == True{} : Bool}, B.Invalid{0}, v, c2, e)

def UPTransportLayerInformation.dv_idx(r: Ap.Rd(Nat), +v: G.UPTransportLayerInformation, +c2: Ap.Cur, +e: {G.UPTransportLayerInformation.r_idx(r) == Done{(v, c2)} : Ap.Rd(G.UPTransportLayerInformation)}) -> {G.UPTransportLayerInformation.valid(v) == True{} : Bool}:
