def DownlinkNASTransport.dv(rb: Ap.Rd(Bool), +v: G.DownlinkNASTransport(), +c2: Ap.Cur, +e: {G.DownlinkNASTransport.r_ext(rb) == Done{(v, c2)} : Ap.Rd(G.DownlinkNASTransport())}) -> {G.DownlinkNASTransport.valid(v) == True{} : Bool}:
  match rb:
    case Fail{err}:
      PA.Rd.absurd(G.DownlinkNASTransport(), {G.DownlinkNASTransport.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.DownlinkNASTransport(), {G.DownlinkNASTransport.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
          L.ngap.ies.decode_valid(c, v, c2, e)

def GL.ngap.DownlinkNASTransport.decode_valid(c, v, c2, e):
  DownlinkNASTransport.dv(Ap.Bit.read(c), v, c2, e)

def DownlinkNASTransport.sx.go(+rem: Nat, +rest: Ap.Bits(), +v: G.DownlinkNASTransport(), +rem2: Nat, +bits2: Ap.Bits(), s: PC.Canon(rest, Fr.Ies.write(v, Ap.Bit.after(rem), bits2), rem2, 0n)) -> DownlinkNASTransport.Sx(False{} <> rest, v, rem, rem2, bits2):
  (s1, s2) = s
  (Equal.cong(Ap.Bits(), Ap.Bits(), l => False{} <> l, rest, Fr.Ies.write(v, Ap.Bit.after(rem), bits2), s1), s2)

def DownlinkNASTransport.sx(+rem: Nat, bits: Ap.Bits(), +v: G.DownlinkNASTransport(), +rem2: Nat, +bits2: Ap.Bits(), +e: {G.DownlinkNASTransport.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.DownlinkNASTransport())}) -> DownlinkNASTransport.Sx(bits, v, rem, rem2, bits2):
  match bits:
    case Nil{}:
      PA.Rd.absurd(G.DownlinkNASTransport(), DownlinkNASTransport.Sx([], v, rem, rem2, bits2), B.Short{}, v, Ap.Cur{rem2, bits2}, e)
    case b <> +rest:
      match b:
        case True{}:
          PA.Rd.absurd(G.DownlinkNASTransport(), DownlinkNASTransport.Sx(True{} <> rest, v, rem, rem2, bits2), B.Unsupported{1}, v, Ap.Cur{rem2, bits2}, e)
        case False{}:
          DownlinkNASTransport.sx.go(rem, rest, v, rem2, bits2, PF.Ies.sx(Ap.Bit.after(rem), rest, v, rem2, bits2, e))

def GL.ngap.DownlinkNASTransport.suffix(rem, bits, v, rem2, bits2, e):
  DownlinkNASTransport.sx(rem, bits, v, rem2, bits2, e)

