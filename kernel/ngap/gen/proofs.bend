          GTPTunnel.dv_transportLayerAddress(p_iE_Extensions, c3, G.TransportLayerAddress.read(c3), {==}, v, c2, e)
        case Nil{}:
          PA.Rd.absurd(G.GTPTunnel, {G.GTPTunnel.valid(v) == True{} : Bool}, B.Short{}, v, c2, e)
        case q0 <> q1 <> more:
