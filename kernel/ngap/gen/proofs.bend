def NGSetupResponse.dv(rb: Ap.Rd(Bool), +v: G.NGSetupResponse(), +c2: Ap.Cur, +e: {G.NGSetupResponse.r_ext(rb) == Done{(v, c2)} : Ap.Rd(G.NGSetupResponse())}) -> {G.NGSetupResponse.valid(v) == True{} : Bool}:
  match rb:
    case Fail{err}:
      PA.Rd.absurd(G.NGSetupResponse(), {G.NGSetupResponse.valid(v) == True{} : Bool}, err, v, c2, e)
    case Done{(ext, c)}:
      match ext:
        case True{}:
          PA.Rd.absurd(G.NGSetupResponse(), {G.NGSetupResponse.valid(v) == True{} : Bool}, B.Unsupported{1}, v, c2, e)
        case False{}:
          L.ngap.ies.decode_valid(c, v, c2, e)

