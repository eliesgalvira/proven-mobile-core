def EPS_TAI.sx(+rem: Nat, bits: Ap.Bits(), +v: G.EPS_TAI, +rem2: Nat, +bits2: Ap.Bits(), +e: {G.EPS_TAI.read(Ap.Cur{rem, bits}) == Done{(v, Ap.Cur{rem2, bits2})} : Ap.Rd(G.EPS_TAI)}) -> EPS_TAI.Sx(bits, v, rem, rem2, bits2):
