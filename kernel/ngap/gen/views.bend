def UplinkNASTransport.v_nas_pdu(+ies: List<&2, Fr.Ie>, amf_ue_ngap_id: G.AMF_UE_NGAP_ID(), ran_ue_ngap_id: G.RAN_UE_NGAP_ID(), m: Maybe<&2, B.Bytes()>) -> Result<&2, &2, B.Err, UplinkNASTransport.View>:
  match m:
    case None{}:
      Fail{B.Invalid{38}}
    case Some{bs}:
      UplinkNASTransport.d_nas_pdu(ies, amf_ue_ngap_id, ran_ue_ngap_id, Fr.View.exact(G.NAS_PDU(), G.NAS_PDU.read(Ap.Cur{0n, Ap.unpack(bs)})))

def UplinkNASTransport.d_ran_ue_ngap_id(+ies: List<&2, Fr.Ie>, amf_ue_ngap_id: G.AMF_UE_NGAP_ID(), r: Result<&2, &2, B.Err, G.RAN_UE_NGAP_ID()>) -> Result<&2, &2, B.Err, UplinkNASTransport.View>:
  match r:
    case Fail{e}:
      Fail{e}
    case Done{ran_ue_ngap_id}:
      UplinkNASTransport.v_nas_pdu(ies, amf_ue_ngap_id, ran_ue_ngap_id, Fr.Ies.lookup(38, ies))

def UplinkNASTransport.v_ran_ue_ngap_id(+ies: List<&2, Fr.Ie>, amf_ue_ngap_id: G.AMF_UE_NGAP_ID(), m: Maybe<&2, B.Bytes()>) -> Result<&2, &2, B.Err, UplinkNASTransport.View>:
  match m:
    case None{}:
      Fail{B.Invalid{85}}
    case Some{bs}:
      UplinkNASTransport.d_ran_ue_ngap_id(ies, amf_ue_ngap_id, Fr.View.exact(G.RAN_UE_NGAP_ID(), G.RAN_UE_NGAP_ID.read(Ap.Cur{0n, Ap.unpack(bs)})))

def UplinkNASTransport.d_amf_ue_ngap_id(+ies: List<&2, Fr.Ie>, r: Result<&2, &2, B.Err, G.AMF_UE_NGAP_ID()>) -> Result<&2, &2, B.Err, UplinkNASTransport.View>:
  match r:
    case Fail{e}:
      Fail{e}
    case Done{amf_ue_ngap_id}:
      UplinkNASTransport.v_ran_ue_ngap_id(ies, amf_ue_ngap_id, Fr.Ies.lookup(85, ies))

def UplinkNASTransport.v_amf_ue_ngap_id(+ies: List<&2, Fr.Ie>, m: Maybe<&2, B.Bytes()>) -> Result<&2, &2, B.Err, UplinkNASTransport.View>:
  match m:
    case None{}:
      Fail{B.Invalid{10}}
    case Some{bs}:
      UplinkNASTransport.d_amf_ue_ngap_id(ies, Fr.View.exact(G.AMF_UE_NGAP_ID(), G.AMF_UE_NGAP_ID.read(Ap.Cur{0n, Ap.unpack(bs)})))

def UplinkNASTransport.v_prelude(r: Result<&2, &2, B.Err, List<&2, Fr.Ie>>) -> Result<&2, &2, B.Err, UplinkNASTransport.View>:
  match r:
    case Fail{e}:
      Fail{e}
    case Done{+ies}:
      UplinkNASTransport.v_amf_ue_ngap_id(ies, Fr.Ies.lookup(10, ies))

def UplinkNASTransport.view(ies: List<&2, Fr.Ie>) -> Result<&2, &2, B.Err, UplinkNASTransport.View>:
  UplinkNASTransport.v_prelude(Fr.View.prelude(UplinkNASTransport.known(), ies))

# Whether the view of the message a PDU kind and procedure code name accepts a container (for the tests).
def View.check(kind: Nat, code: Nat, ies: List<&2, Fr.Ie>) -> Maybe<&2, Bool>:
  match kind code:
    case 0n 4n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, DownlinkNASTransport.View, DownlinkNASTransport.view(ies)))}
    case 0n 9n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, ErrorIndication.View, ErrorIndication.view(ies)))}
    case 0n 14n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, InitialContextSetupRequest.View, InitialContextSetupRequest.view(ies)))}
    case 0n 15n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, InitialUEMessage.View, InitialUEMessage.view(ies)))}
    case 0n 21n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, NGSetupRequest.View, NGSetupRequest.view(ies)))}
    case 0n 29n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, PDUSessionResourceSetupRequest.View, PDUSessionResourceSetupRequest.view(ies)))}
    case 0n 41n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, UEContextReleaseCommand.View, UEContextReleaseCommand.view(ies)))}
    case 0n 42n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, UEContextReleaseRequest.View, UEContextReleaseRequest.view(ies)))}
    case 0n 46n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, UplinkNASTransport.View, UplinkNASTransport.view(ies)))}
    case 1n 14n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, InitialContextSetupResponse.View, InitialContextSetupResponse.view(ies)))}
    case 1n 21n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, NGSetupResponse.View, NGSetupResponse.view(ies)))}
    case 1n 29n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, PDUSessionResourceSetupResponse.View, PDUSessionResourceSetupResponse.view(ies)))}
    case 1n 41n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, UEContextReleaseComplete.View, UEContextReleaseComplete.view(ies)))}
    case 2n 14n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, InitialContextSetupFailure.View, InitialContextSetupFailure.view(ies)))}
    case 2n 21n:
      Some{Bool.not(Result.is_fail(&2, &2, B.Err, NGSetupFailure.View, NGSetupFailure.view(ies)))}
    case _ _:
      None{}
