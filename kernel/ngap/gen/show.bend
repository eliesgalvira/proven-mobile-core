def Cause.show(x: G.Cause) -> String:
  match x:
    case G.Cause_radioNetwork{v}:
      "0:" ++ CauseRadioNetwork.show(v)
    case G.Cause_transport{v}:
      "1:" ++ CauseTransport.show(v)
    case G.Cause_nas{v}:
      "2:" ++ CauseNas.show(v)
    case G.Cause_protocol{v}:
      "3:" ++ CauseProtocol.show(v)
    case G.Cause_misc{v}:
      "4:" ++ CauseMisc.show(v)
    case G.Cause_choice_Extensions{v}:
      "5:" ++ Ie.show(v)

def Cause.show_end(+v: G.Cause, ok: Bool) -> String:
  match ok:
    case True{}:
      Cause.show(v)
    case False{}:
      "!"

