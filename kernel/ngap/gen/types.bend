    case QosCharacteristics_nonDynamic5QI{v}:
      NonDynamic5QIDescriptor.after(v, Ap.Size.after(False{}, 2n, rem))
    case QosCharacteristics_dynamic5QI{v}:
      Dynamic5QIDescriptor.after(v, Ap.Size.after(False{}, 2n, rem))
