# Cause ::= CHOICE { radioNetwork CauseRadioNetwork, transport CauseTransport, nas CauseNas, protocol CauseProtocol, misc CauseMisc, choice-Extensions <ProtocolIE-SingleContainer: 0 known rows> }
type Cause is Data:
  Cause_radioNetwork{v: CauseRadioNetwork()}
  Cause_transport{v: CauseTransport()}
  Cause_nas{v: CauseNas()}
  Cause_protocol{v: CauseProtocol()}
  Cause_misc{v: CauseMisc()}
  Cause_choice_Extensions{v: Fr.Ie}

def Cause.valid(x: Cause) -> Bool:
  match x:
    case Cause_radioNetwork{v}:
      CauseRadioNetwork.valid(v)
    case Cause_transport{v}:
      CauseTransport.valid(v)
    case Cause_nas{v}:
      CauseNas.valid(v)
    case Cause_protocol{v}:
      CauseProtocol.valid(v)
    case Cause_misc{v}:
      CauseMisc.valid(v)
    case Cause_choice_Extensions{v}:
      Fr.Ie.valid(v)

def Cause.c_radioNetwork(r: Ap.Rd(CauseRadioNetwork())) -> Ap.Rd(Cause):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{(v, c)}:
      Done{(Cause_radioNetwork{v}, c)}

def Cause.c_transport(r: Ap.Rd(CauseTransport())) -> Ap.Rd(Cause):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{(v, c)}:
      Done{(Cause_transport{v}, c)}

def Cause.c_nas(r: Ap.Rd(CauseNas())) -> Ap.Rd(Cause):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{(v, c)}:
      Done{(Cause_nas{v}, c)}

def Cause.c_protocol(r: Ap.Rd(CauseProtocol())) -> Ap.Rd(Cause):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{(v, c)}:
      Done{(Cause_protocol{v}, c)}

def Cause.c_misc(r: Ap.Rd(CauseMisc())) -> Ap.Rd(Cause):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{(v, c)}:
      Done{(Cause_misc{v}, c)}

def Cause.c_choice_Extensions(r: Ap.Rd(Fr.Ie)) -> Ap.Rd(Cause):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{(v, c)}:
      Done{(Cause_choice_Extensions{v}, c)}

def Cause.alt(i: Nat, c: Ap.Cur) -> Ap.Rd(Cause):
  match i:
    case 0n:
      Cause.c_radioNetwork(CauseRadioNetwork.read(c))
    case 1n:
      Cause.c_transport(CauseTransport.read(c))
    case 2n:
      Cause.c_nas(CauseNas.read(c))
    case 3n:
      Cause.c_protocol(CauseProtocol.read(c))
    case 4n:
      Cause.c_misc(CauseMisc.read(c))
    case 5n:
      Cause.c_choice_Extensions(Fr.Ie.read(c))
    case 6n+p:
      Fail{B.Invalid{0}}

def Cause.r_idx(r: Ap.Rd(Nat)) -> Ap.Rd(Cause):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{(i, c)}:
      Cause.alt(i, c)

def Cause.read(c: Ap.Cur) -> Ap.Rd(Cause):
  Cause.r_idx(Ap.Size.read(False{}, 3n, 0n, 5n, c))

def Cause.write(x: Cause, +rem: Nat, +rest: Ap.Bits()) -> Ap.Bits():
  match x:
    case Cause_radioNetwork{+v}:
      Ap.Size.write(False{}, 3n, 0n, 0n, rem, CauseRadioNetwork.write(v, Ap.Size.after(False{}, 3n, rem), rest))
    case Cause_transport{+v}:
      Ap.Size.write(False{}, 3n, 0n, 1n, rem, CauseTransport.write(v, Ap.Size.after(False{}, 3n, rem), rest))
    case Cause_nas{+v}:
      Ap.Size.write(False{}, 3n, 0n, 2n, rem, CauseNas.write(v, Ap.Size.after(False{}, 3n, rem), rest))
    case Cause_protocol{+v}:
      Ap.Size.write(False{}, 3n, 0n, 3n, rem, CauseProtocol.write(v, Ap.Size.after(False{}, 3n, rem), rest))
    case Cause_misc{+v}:
      Ap.Size.write(False{}, 3n, 0n, 4n, rem, CauseMisc.write(v, Ap.Size.after(False{}, 3n, rem), rest))
    case Cause_choice_Extensions{+v}:
      Ap.Size.write(False{}, 3n, 0n, 5n, rem, Fr.Ie.write(v, Ap.Size.after(False{}, 3n, rem), rest))

def Cause.after(x: Cause, +rem: Nat) -> Nat:
  match x:
    case Cause_radioNetwork{v}:
      CauseRadioNetwork.after(v, Ap.Size.after(False{}, 3n, rem))
    case Cause_transport{v}:
      CauseTransport.after(v, Ap.Size.after(False{}, 3n, rem))
    case Cause_nas{v}:
      CauseNas.after(v, Ap.Size.after(False{}, 3n, rem))
    case Cause_protocol{v}:
      CauseProtocol.after(v, Ap.Size.after(False{}, 3n, rem))
    case Cause_misc{v}:
      CauseMisc.after(v, Ap.Size.after(False{}, 3n, rem))
    case Cause_choice_Extensions{v}:
      Fr.Ie.after(Ap.Size.after(False{}, 3n, rem))

def Cause.roundtrips.end(+bs: B.Bytes(), r: Ap.Rd(Cause)) -> Bool:
  match r:
    case Fail{e}:
      False{}
    case Done{(+v, c)}:
      match c:
        case Ap.Cur{rem, bits}:
          Bool.and(Ap.Tail.zero(bits), Bool.and(Cause.valid(v), B.bytes_eq(Ap.pack(Cause.write(v, 0n, [])), bs)))

def Cause.roundtrips(+bs: B.Bytes()) -> Bool:
  Cause.roundtrips.end(bs, Cause.read(Ap.Cur{0n, Ap.unpack(bs)}))

