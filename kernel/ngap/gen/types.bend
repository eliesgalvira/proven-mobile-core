def GUAMI.r_aMFPointer(p_iE_Extensions: Bool, pLMNIdentity: PLMNIdentity(), aMFRegionID: AMFRegionID(), aMFSetID: AMFSetID(), r: Ap.Rd(AMFPointer())) -> Ap.Rd(GUAMI):
