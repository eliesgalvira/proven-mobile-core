def GUAMI.o_iE_Extensions(p: Bool, c: Ap.Cur) -> Ap.Rd(Maybe<&2, List<&2, Fr.Ie>>):
  match p:
    case False{}:
      Done{(None{}, c)}
    case True{}:
      GUAMI.s_iE_Extensions(Fr.Exts.read(c))

def GUAMI.valid(x: GUAMI) -> Bool:
  match x:
    case GUAMI{pLMNIdentity, aMFRegionID, aMFSetID, aMFPointer, iE_Extensions}:
      Bool.and(PLMNIdentity.valid(pLMNIdentity), Bool.and(AMFRegionID.valid(aMFRegionID), Bool.and(AMFSetID.valid(aMFSetID), Bool.and(AMFPointer.valid(aMFPointer), GUAMI.v_iE_Extensions(iE_Extensions)))))

