def GUAMI.write(x: GUAMI, +rem: Nat, +rest: Ap.Bits()) -> Ap.Bits():
  match x:
    case GUAMI{+pLMNIdentity, +aMFRegionID, +aMFSetID, +aMFPointer, +iE_Extensions}:
      +r0 = Ap.Bits.after(1n, Ap.Bit.after(rem))
      +r1 = PLMNIdentity.after(pLMNIdentity, r0)
      +r2 = AMFRegionID.after(aMFRegionID, r1)
      +r3 = AMFSetID.after(aMFSetID, r2)
      +r4 = AMFPointer.after(aMFPointer, r3)
      Ap.Bit.write(False{}, rem, Ap.Bits.write([Fr.Present(List<&2, Fr.Ie>, iE_Extensions)], Ap.Bit.after(rem), PLMNIdentity.write(pLMNIdentity, r0, AMFRegionID.write(aMFRegionID, r1, AMFSetID.write(aMFSetID, r2, AMFPointer.write(aMFPointer, r3, GUAMI.w_iE_Extensions(iE_Extensions, r4, rest)))))))

def GUAMI.after(x: GUAMI, +rem: Nat) -> Nat:
  match x:
    case GUAMI{pLMNIdentity, aMFRegionID, aMFSetID, aMFPointer, iE_Extensions}:
      +r0 = Ap.Bits.after(1n, Ap.Bit.after(rem))
      +r1 = PLMNIdentity.after(pLMNIdentity, r0)
      +r2 = AMFRegionID.after(aMFRegionID, r1)
      +r3 = AMFSetID.after(aMFSetID, r2)
      +r4 = AMFPointer.after(aMFPointer, r3)
      +r5 = GUAMI.a_iE_Extensions(iE_Extensions, r4)
      r5

