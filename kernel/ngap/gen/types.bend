# ServedGUAMIList ::= SEQUENCE (SIZE(1..256)) OF ServedGUAMIItem
def ServedGUAMIList() -> Data:
  List<&2, ServedGUAMIItem>

def ServedGUAMIList.all_valid(xs: ServedGUAMIList()) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case x <> more:
      Bool.and(ServedGUAMIItem.valid(x), ServedGUAMIList.all_valid(more))

def ServedGUAMIList.valid(+xs: ServedGUAMIList()) -> Bool:
  Bool.and(Ap.Size.valid(1n, 255n, List.length(&2, ServedGUAMIItem, xs)), ServedGUAMIList.all_valid(xs))

def ServedGUAMIList.cons(x: ServedGUAMIItem, r: Ap.Rd(ServedGUAMIList())) -> Ap.Rd(ServedGUAMIList()):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{(xs, c)}:
      Done{(x <> xs, c)}

def ServedGUAMIList.next(r: Ap.Rd(ServedGUAMIItem), more: Ap.Cur -> Ap.Rd(ServedGUAMIList())) -> Ap.Rd(ServedGUAMIList()):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{(x, c)}:
      ServedGUAMIList.cons(x, more(c))

def ServedGUAMIList.items(n: Nat, c: Ap.Cur) -> Ap.Rd(ServedGUAMIList()):
  match n:
    case 0n:
      Done{([], c)}
    case 1n+p:
      ServedGUAMIList.next(ServedGUAMIItem.read(c), c2 => ServedGUAMIList.items(p, c2))

def ServedGUAMIList.count(r: Ap.Rd(Nat)) -> Ap.Rd(ServedGUAMIList()):
  match r:
    case Fail{e}:
      Fail{e}
    case Done{(n, c)}:
      ServedGUAMIList.items(n, c)

def ServedGUAMIList.read(c: Ap.Cur) -> Ap.Rd(ServedGUAMIList()):
  ServedGUAMIList.count(Ap.Size.read(True{}, 8n, 1n, 255n, c))

def ServedGUAMIList.items_write(xs: ServedGUAMIList(), +rem: Nat, +rest: Ap.Bits()) -> Ap.Bits():
  match xs:
    case Nil{}:
      rest
    case +x <> more:
