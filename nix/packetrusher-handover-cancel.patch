@@ -0,0 +1,17 @@
+package ue_mobility_management
+
+import (
+	"my5G-RANTester/internal/control_test_engine/gnb/context"
+
+	ngapType "github.com/free5gc/ngap/ie"
+	ngap "github.com/free5gc/ngap/message"
+)
+
+// HandoverCancel cancels the prepared handover of the UE (TS 38.413 8.4.6).
+func HandoverCancel(ue *context.GNBUe) ([]byte, error) {
+	return (&ngap.HandoverCancel{
+		AMFUENGAPID: &ngapType.AMFUENGAPID{Value: ue.GetAmfUeId()},
+		RANUENGAPID: &ngapType.RANUENGAPID{Value: ue.GetRanUeId()},
+		Cause:       &ngapType.Cause{Choice: &ngapType.CauseRadioNetwork{Value: ngapType.CauseRadioNetworkPresentHandoverCancelled}},
+	}).MarshalBinary()
+}
