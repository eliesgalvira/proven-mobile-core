+// cancelOnCommand holds the UEs whose prepared handover is cancelled instead of executed.
+var cancelOnCommand sync.Map
+
+// TriggerNgapHandoverCancel prepares an NGAP handover, then cancels it once the AMF
+// sends the Handover Command.
+func TriggerNgapHandoverCancel(oldGnb *context.GNBContext, newGnb *context.GNBContext, prUeId int64) {
+	if ue, err := oldGnb.GetGnbUeByPrUeId(prUeId); err == nil {
+		cancelOnCommand.Store(ue, struct{}{})
+	}
+	TriggerNgapHandover(oldGnb, newGnb, prUeId)
+}
+
+// CancelsHandover reports, once, whether the UE's prepared handover is to be cancelled.
+func CancelsHandover(ue *context.GNBUe) bool {
+	_, cancel := cancelOnCommand.LoadAndDelete(ue)
+	return cancel
+}
+
+func SendHandoverCancel(ue *context.GNBUe) {
+	log.Info("[GNB] Initiating Handover Cancel")
+
+	ngapMsg, err := ue_mobility_management.HandoverCancel(ue)
+	if err != nil {
+		log.Error("[GNB][NGAP] Error building Handover Cancel: ", err)
+		return
+	}
+	if err := sender.SendToAmF(ngapMsg, ue.GetSCTP()); err != nil {
+		log.Error("[GNB][NGAP] Error sending Handover Cancel: ", err)
+	}
+}
